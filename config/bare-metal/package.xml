<?xml version="1.0"?>
<package format="3">
  <name>nros_platform_bare_metal</name>
  <version>0.0.0</version>
  <description>
    Bare-metal platform support for nano-ros (no RTOS; smoltcp networking).

    phase-349 W1: this file exists so the platform is DISCOVERABLE — the
    `nano_ros_provides` export below is what a source-time scan reads. What the
    platform declares (capabilities, arch profiles, build blocks) lives in the
    sibling `nros-platform.toml` (RFC-0049), read only when this platform is
    the one selected.
  </description>
  <maintainer email="dev@example.com">Developer</maintainer>
  <license>Apache-2.0</license>

  <export>
    <build_type>nros_cargo</build_type>
    <!--
      Provision, NOT consumption: this package IS a platform, rather than
      selecting one. Must equal the descriptor's `names`, canonical first —
      `check-provider-announcements.py` compares them.
    -->
    <nano_ros_provides kind="platform" name="bare-metal"/>
    <!--
      phase-468 W1 — `esp32` is the second name the descriptor answers to, and
      discovery has to claim it too or the two halves disagree about what this
      package provides. It is the bare-metal ESP32-C3 QEMU path
      (`nros-board-esp32-qemu`, esp-hal, riscv32imc), NOT the ESP-IDF port that
      phase-468 W2 retires; the `[arch.riscv32imc]` profile in the sibling
      descriptor was written for that chip. See that file's `names` comment for
      the four measurements.
    -->
    <nano_ros_provides kind="platform" name="esp32"/>
  </export>
</package>
