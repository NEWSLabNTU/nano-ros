<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>param-two-node-talker</name>
  <version>0.1.0</version>
  <description>nano-ros two-node parameter fixture (phase-426 W6)</description>
  <maintainer email="example@example.com">Developer</maintainer>
  <license>MIT OR Apache-2.0</license>

  <!-- The interface packages this bin's `generated/` is produced FROM.
       `scripts/regenerate-bindings.sh` section 3 finds this file and runs
       `nros generate-rust` here; without it the leaf is invisible to the
       regenerator and its `generated/` would have to be committed. -->
  <depend>std_msgs</depend>

  <export>
    <build_type>nros_cargo</build_type>
  </export>
</package>
