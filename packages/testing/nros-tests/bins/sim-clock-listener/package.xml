<?xml version="1.0"?>
<!-- Issue 1305 — a package with a `system.toml` is a ROS package too, so `nros
     sync` can scan it (check-self-pkg-package-xml). Its messages are the committed core interface crates, so sync generates nothing for it. -->
<package format="3">
  <name>sim-clock-listener</name>
  <version>0.1.0</version>
  <description>phase-425 W5 — the use_sim_time node of the /clock pair</description>
  <maintainer email="dev@example.com">Developer</maintainer>
  <license>MIT OR Apache-2.0</license>
  <export>
    <build_type>nros_cargo</build_type>
  </export>
</package>
