<?xml version="1.0"?>
<!-- Issue 1305 — a package with a `system.toml` is a ROS package too, so `nros
     sync` can scan it (check-self-pkg-package-xml). It depends on no message package, so sync generates nothing for it. -->
<package format="3">
  <name>logging-smoke-threadx-linux</name>
  <version>0.1.0</version>
  <description>ThreadX Linux nros-log smoke fixture</description>
  <maintainer email="dev@example.com">Developer</maintainer>
  <license>MIT OR Apache-2.0</license>
  <export>
    <build_type>nros_cargo</build_type>
  </export>
</package>
