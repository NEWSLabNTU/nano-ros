[system]
name = "demo"
rmw = "zenoh"
domain_id = 0

# issue 0438 — `group_tasks` is what BINDS a callback group to a sched task
# (phase-273 W2 / RFC-0047 moved this out of the package manifest and into the
# deployment config). Without it the `[tasks.*]` tables below are declared and
# unreferenced: `resolve_sched_tasks` builds membership only from bindings, finds
# none, and returns the degenerate single synthesized `default` sched task — so the
# macro emits the SINGLE-sched-task path and the two authored sched tasks vanish without a
# word. This fixture once carried the pre-273 form (`callback_groups` in each
# node package's `Cargo.toml`), which nothing read; that form is now refused.
[[component]]
pkg = "ctrl_pkg"
class = "ctrl_pkg::Control"
name = "control_node"
group_tasks = { ctrl = "high" }

[[component]]
pkg = "telem_pkg"
class = "telem_pkg::Telem"
name = "telem_node"
group_tasks = { telem = "low" }

# The image `src/demo_entry` boots — claimed by its `<id>_entry` name
# (`leaf_system::for_entry`). It was the entry's `[package.metadata.nros.entry]
# deploy = "native"` until phase-445 W5 retired the key. ABOVE the tier tables
# on purpose: the `orch_sched_tasks_single` staging keeps only what precedes the first
# `[tasks.` line.
[image.demo]
board = "linux"

# Two priority sched tasks (RFC-0015 §4.2). Only the `posix` sub-table is needed for
# the native deploy; priorities are raw POSIX (advisory on native).
