# Standalone (not a workspace member) E2E staticlib wrapping the generated
# C++ FFI glue for Phase 235.8.
[workspace]

[package]
name = "borrowed-cpp-e2e"
version = "0.0.0"
edition = "2024"
publish = false

[lib]
path = "lib.rs"
crate-type = ["staticlib"]

[dependencies]
# phase-359 W10 — the staticlib is linked into a HOSTED C++ binary, and libstd
# is what supplies `#[panic_handler]` + `rust_eh_personality` for it. That
# arrived first via `nros-serdes`'s `default = ["std"]`, then via naming
# `nros-serdes/std`; nros-serdes has no `std` now, so the ROOT (`lib.rs`) says
# `extern crate std` itself. `alloc` is what the generated code uses.
nros-serdes = { path = "../../packages/core/nros-serdes", features = ["alloc"] }

[profile.release]
lto = false
