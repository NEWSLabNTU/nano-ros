# Doxyfile for nros C++ API documentation
#
# Usage: doxygen packages/api/nros-cpp/Doxyfile
# Or:    just doc-cpp

PROJECT_NAME           = "nros C++ API"
PROJECT_BRIEF          = "Lightweight ROS 2 client for embedded real-time systems (C++ headers)"

# Input: hand-written per-module headers + groups + Markdown guides.
# Exclude nros_cpp_config_generated.h (internal storage-size probe artifact).
INPUT                  = include/rclcpp/rclcpp.hpp \
                         include/rclcpp/node.hpp \
                         include/rclcpp/publisher.hpp \
                         include/rclcpp/subscription.hpp \
                         include/rclcpp/service.hpp \
                         include/rclcpp/client.hpp \
                         include/rclcpp_action/server.hpp \
                         include/rclcpp_action/client.hpp \
                         include/rclcpp/executor.hpp \
                         include/rclcpp/timer.hpp \
                         include/rclcpp/guard_condition.hpp \
                         include/rclcpp/future.hpp \
                         include/rclcpp/stream.hpp \
                         include/rclcpp/qos.hpp \
                         include/rclcpp/result.hpp \
                         include/rclcpp/detail/config.hpp \
                         include/rclcpp/detail/serialization_format.hpp \
                         include/rclcpp/span.hpp \
                         include/rclcpp/fixed_string.hpp \
                         include/rclcpp/fixed_sequence.hpp \
                         include/nros/std_compat.hpp \
                         docs/groups.dox \
                         docs/mainpage.md \
                         docs/getting-started.md \
                         docs/configuration.md \
                         docs/ros2-interop.md \
                         docs/troubleshooting.md \
                         docs/error-codes.md
RECURSIVE              = NO
FILE_PATTERNS          = *.hpp *.dox *.md
USE_MDFILE_AS_MAINPAGE = docs/mainpage.md

# Output to a sibling tree of target/doc/ so it doesn't pollute the rustdoc
# crate directory listing.
OUTPUT_DIRECTORY       = ../../../target/doxygen/cpp

# C++-optimised output
OPTIMIZE_OUTPUT_FOR_C  = NO
TYPEDEF_HIDES_STRUCT   = NO

# Extract everything so the generated site is complete even when finer-grained
# (per-param / per-field) docs are missing. Real doc errors still surface via
# WARN_IF_DOC_ERROR.
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
EXTRACT_PRIVATE        = NO

WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO

# No LaTeX, just HTML
GENERATE_HTML          = YES
GENERATE_LATEX         = NO

# Preprocessing: expand NROS_PUBLIC so Doxygen sees the declarations
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
PREDEFINED             = NROS_PUBLIC=

# Sort members alphabetically within their sections
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = YES
