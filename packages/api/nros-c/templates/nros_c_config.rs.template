/// Maximum number of handles in an executor (derived from NROS_EXECUTOR_MAX_CBS via nros-node).
pub const NROS_EXECUTOR_MAX_HANDLES: usize = @NROS_EXECUTOR_MAX_HANDLES@;

/// Buffer size for LET semantics per handle (set via NROS_LET_BUFFER_SIZE, default 512).
pub const LET_BUFFER_SIZE: usize = @LET_BUFFER_SIZE@;

/// Default service-client RPC timeout in ms (set via NROS_SERVICE_TIMEOUT_MS, default 30000 — matches the zenoh backend).
pub const SERVICE_DEFAULT_TIMEOUT_MS: u32 = @SERVICE_DEFAULT_TIMEOUT_MS@;

/// Maximum buffer size for subscription/service data (derived from NROS_SUBSCRIPTION_BUFFER_SIZE via nros-node).
pub const MESSAGE_BUFFER_SIZE: usize = @MESSAGE_BUFFER_SIZE@;

/// Inline opaque storage for `Executor` inside `nros_executor_t` (in u64 units).
/// Upper bound derived from nros-node's MAX_CBS and ARENA_SIZE.
/// Validated at compile time by `size_of::<Executor>()` assertion.
pub const EXECUTOR_OPAQUE_U64S: usize = @EXECUTOR_OPAQUE_U64S@;

// ── Probe-derived opaque sizes, as the HEADER states them (issue 0472) ──────
//
// These are the numbers the generated C header hands to callers — the width of
// the `_opaque` array a C or C++ caller allocates. They come from PROBING the
// compiled runtime, which is a different derivation from the `size_of::<T>()`
// the Rust side uses, and two derivations of one fact is exactly the shape that
// needs an assertion rather than a comment.
//
// Without them in scope, the Rust side had nothing to compare against, so
// thirteen of the fifteen opaque macros could only fail as a SHORT BUFFER at
// run time, in C, at a distance from the cause. `opaque_sizes.rs` asserts each
// against its type; see the guard block there.
//
// Zero means "no probe" — a `cargo check --no-default-features` run with no
// rlib to read. The guards skip that case deliberately: hard-failing it would
// break `just check`, which is the accommodation issue 0472 records as
// legitimate but unenforced at LINK time (its item 2, still open).
pub const PROBE_SESSION_U64S: usize = @PROBE_SESSION_U64S@;
pub const PROBE_PUBLISHER_U64S: usize = @PROBE_PUBLISHER_U64S@;
pub const PROBE_GUARD_HANDLE_U64S: usize = @PROBE_GUARD_HANDLE_U64S@;
pub const PROBE_LIFECYCLE_CTX_U64S: usize = @PROBE_LIFECYCLE_CTX_U64S@;
pub const PROBE_RAW_SUBSCRIPTION_U64S: usize = @PROBE_RAW_SUBSCRIPTION_U64S@;
pub const PROBE_RAW_SERVICE_SERVER_U64S: usize = @PROBE_RAW_SERVICE_SERVER_U64S@;
pub const PROBE_RAW_SERVICE_CLIENT_U64S: usize = @PROBE_RAW_SERVICE_CLIENT_U64S@;
pub const PROBE_RAW_ACTION_SERVER_U64S: usize = @PROBE_RAW_ACTION_SERVER_U64S@;
pub const PROBE_RAW_ACTION_CLIENT_U64S: usize = @PROBE_RAW_ACTION_CLIENT_U64S@;
pub const PROBE_ACTION_SERVER_RAW_HANDLE_U64S: usize = @PROBE_ACTION_SERVER_RAW_HANDLE_U64S@;

