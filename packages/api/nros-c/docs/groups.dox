/**
 * @defgroup grp_init init
 * @brief Library initialisation and the support context.
 *
 * Includes `rclc_support_t` (the transport session anchor) and its
 * `context`, which `rclc_executor_init` takes.
 *
 * Typical lifecycle:
 * @code
 * rcl_allocator_t allocator = rcl_get_default_allocator();
 * rclc_support_t support = rclc_support_get_zero_initialized();
 * rclc_support_init(&support, 0, NULL, &allocator);
 * // ... use the API ...
 * rclc_support_fini(&support);
 * @endcode
 *
 * @see @ref grp_node, @ref getting_started
 */

/**
 * @defgroup grp_node node
 * @brief Node creation and lifecycle.
 *
 * `rcl_node_t` is the parent for publishers, subscriptions, services,
 * clients, action servers, and action clients. Each entity is bound to
 * a node at init time and torn down before the node itself.
 *
 * @code
 * rcl_node_t node = rcl_get_zero_initialized_node();
 * rclc_node_init_default(&node, "my_node", "/", &support);
 * // ... bind entities ...
 * rcl_node_fini(&node);
 * @endcode
 *
 * @see @ref grp_pubsub, @ref grp_service, @ref grp_action
 */

/**
 * @defgroup grp_pubsub pubsub
 * @brief Topic publishers and subscriptions.
 *
 * `rcl_publisher_t` sends typed (or raw-CDR) messages on a topic;
 * `rcl_subscription_t` receives them through a callback registered on the
 * executor, which owns the subscriber. A subscription polled manually is
 * the separate type `rclc_polling_subscription_t`, drained with
 * `rclc_polling_subscription_take_serialized`.
 *
 * @code
 * rcl_publisher_t pub = nros_publisher_get_zero_initialized();
 * nros_publisher_init(&pub, &node, &type_info, "/chatter");
 * rclc_publish_raw(&pub, cdr_buf, cdr_len);
 * @endcode
 *
 * @see @ref grp_executor, @ref grp_qos
 */

/**
 * @defgroup grp_service service
 * @brief Service servers and clients.
 *
 * Provides request/response RPC via `rcl_service_t` (server) and
 * `rcl_client_t` (caller). Servers register a
 * `rclc_service_raw_callback_t` that the executor dispatches when a request
 * arrives; clients can take responses synchronously or via callbacks.
 *
 * @see @ref grp_action for long-running calls with feedback
 */

/**
 * @defgroup grp_action action
 * @brief Action servers and clients.
 *
 * REP-2010 action protocol on top of services + topics: goal accept /
 * reject, periodic feedback, cancel, and final result. Servers expose
 * accept and execute callbacks; clients receive feedback and result
 * callbacks.
 *
 * @see @ref grp_service for one-shot RPC (no feedback / cancel)
 * @see @ref grp_executor for executor-driven dispatch
 */

/**
 * @defgroup grp_executor executor
 * @brief Callback dispatch, timers, and guard conditions.
 *
 * `rclc_executor_t` polls the transport, drains ready data from
 * subscriptions/services/clients/actions, and invokes their registered
 * callbacks. `rcl_timer_t` fires on a wall-clock period;
 * `rcl_guard_condition_t` is an explicit wake source you can trigger
 * from any thread.
 *
 * @code
 * rclc_executor_t exec = rclc_executor_get_zero_initialized_executor();
 * rclc_executor_init(&exec, &support.context, 4, &allocator);
 * rclc_executor_add_subscription_raw(&exec, &sub, on_bytes, NULL,
 *                                    RCLC_EXECUTOR_ON_NEW_DATA);
 * rclc_executor_spin_period(&exec, 10000000ULL);
 * @endcode
 *
 * @see @ref grp_pubsub for callback-driven subscriptions
 * @see @ref grp_service for callback-driven service servers
 * @see @ref grp_action for callback-driven action servers
 */

/**
 * @defgroup grp_clock clock
 * @brief Wall-clock and monotonic time.
 *
 * `rclc_time_t` is an absolute instant, `rcl_duration_t` is a span;
 * helpers convert between nanoseconds, milliseconds, and seconds.
 *
 * @see @ref grp_executor for `nros_executor_spin_period` (uses
 *      `rcl_duration_t` ticks)
 */

/**
 * @defgroup grp_parameter parameter
 * @brief Parameter server (REP-2007 services).
 *
 * Static-pool parameter table backing the `~/get_parameters`,
 * `~/set_parameters`, etc. services. Parameter sizes are bounded by
 * `NROS_MAX_PARAMETERS` and friends — see @ref configuration.
 *
 * @see @ref grp_service for the underlying RPC machinery
 */

/**
 * @defgroup grp_lifecycle lifecycle
 * @brief Node lifecycle (REP-2002).
 *
 * Optional lifecycle state machine and matching services
 * (`~/change_state`, `~/get_state`, …) built on the
 * `nros-lifecycle-msgs` codegen crate.
 *
 * @see @ref grp_node for the underlying node entity
 * @see @ref grp_service for the lifecycle-managing services
 */

/**
 * @defgroup grp_cdr cdr
 * @brief CDR serialisation helpers.
 *
 * Low-level helpers used by generated message types. You should not
 * need to call these directly — `nano_ros_generate_interfaces()` emits
 * fully serialised types.
 *
 * @see @ref grp_pubsub for `rclc_publish_raw` / `rclc_polling_subscription_take_serialized`
 *      (the consumers of CDR-encoded buffers)
 */

/**
 * @defgroup grp_qos qos
 * @brief Quality-of-Service settings.
 *
 * Reliability (`BEST_EFFORT` / `RELIABLE`), durability, history,
 * and depth.
 *
 * @see @ref grp_pubsub — every publisher/subscription accepts a QoS
 *      profile via the `_with_qos` init variant
 */

/**
 * @defgroup grp_errors errors
 * @brief Return codes and error helpers.
 *
 * Every fallible function returns `rcl_ret_t`. See @ref error_codes
 * for the full table.
 *
 * @see @ref troubleshooting for symptom-driven diagnostics
 */

/**
 * @defgroup grp_types types
 * @brief Shared types (return codes, message-type info, opaque
 * handles).
 *
 * Defined in `<nros/types.h>` and `nros_generated.h`; included
 * transitively by every per-module header.
 */
