# Doxyfile for nros C API documentation
#
# Usage: doxygen packages/api/nros-c/Doxyfile
# Or:    just doc-c

PROJECT_NAME           = "nros C API"
PROJECT_BRIEF          = "Lightweight ROS 2 client for embedded real-time systems"

# Input: hand-written per-module headers + cbindgen-emitted decls +
# groups + Markdown guides.
#
# Phase 93 E1: `nros_generated.h` is now part of the doc input. The
# cbindgen-emitted decls are the real source of truth for entity types
# and public functions; the per-module shim headers carry @file briefs
# and `@addtogroup` blocks that pull related symbols into named groups.
INPUT                  = include/rclc/rclc.h \
                         include/rclc/detail/nros_generated.h \
                         include/rclc/types.h \
                         include/rclc/detail/serialization_format.h \
                         include/rclc/init.h \
                         include/rclc/node.h \
                         include/rclc/publisher.h \
                         include/rclc/subscription.h \
                         include/rclc/service.h \
                         include/rclc/client.h \
                         include/rclc/executor.h \
                         include/rclc/timer.h \
                         include/rclc/action.h \
                         include/rclc_parameter/rclc_parameter.h \
                         include/rclc/detail/cdr.h \
                         include/rclc/visibility_control.h \
                         include/rclc/log.h \
                         include/rclc/check.h \
                         include/rclc_lifecycle/rclc_lifecycle.h \
                         include/nros/platform.h \
                         docs/groups.dox \
                         docs/mainpage.md \
                         docs/getting-started.md \
                         docs/configuration.md \
                         docs/ros2-interop.md \
                         docs/troubleshooting.md \
                         docs/error-codes.md
RECURSIVE              = NO
FILE_PATTERNS          = *.h *.dox *.md
USE_MDFILE_AS_MAINPAGE = docs/mainpage.md

# Output to a sibling tree of target/doc/ so it doesn't pollute the rustdoc
# crate directory listing (`book/book/api/rust/` was getting `c-api/` and
# `cpp-api/` subdirs under it before this).
OUTPUT_DIRECTORY       = ../../../target/doxygen/c

# C-optimised output
OPTIMIZE_OUTPUT_FOR_C  = YES
TYPEDEF_HIDES_STRUCT   = YES

# Extract everything so the generated site is complete even when finer-grained
# (per-param / per-field) docs are missing. Real doc errors still surface via
# WARN_IF_DOC_ERROR; missing-doc nags are off because they would dominate the
# build log on every public-facing rebuild.
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES

WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO

# No LaTeX, just HTML
GENERATE_HTML          = YES
GENERATE_LATEX         = NO

# Preprocessing: expand NROS_PUBLIC so Doxygen sees the declarations
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
PREDEFINED             = NROS_PUBLIC=

# Sort members alphabetically within their sections
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = YES
