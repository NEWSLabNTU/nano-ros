{#-
  The toy Zig entry pack (phase-474 W5) — see `pack.toml` for what it is and
  is not. It renders `nros_entry_lower::LoweredEntry` exactly as the C pack
  does, and this file is the ONLY thing it took to add.

  RFC-0091 §8b predicted three places a third language would break the IR, and
  this template is the check that it no longer does:
    * defect 1 (a C++ board path in the IR) — the board call is the family's
      C-ABI runner, read from `boot.runners`, never a class path;
    * defect 2 (pre-escaped literals) — every string is RAW and quoted here
      with `c_str`;
    * defect 3 (pre-rendered C) — tier rows, the boot blob and each node's
      declarations arrive as values, and this file spells them in Zig.

  The `app` boot shape's registration is a C macro (`NROS_APP_MAIN_REGISTER_VOID`)
  that defines `app_main(void)`; Zig cannot expand a macro, so it defines that
  symbol itself — the macro's body, spelled in Zig.
-#}
// Generated by the toy Zig entry pack (phase-474 W5) — a test fixture.
//   bringup = {{ bringup }}
//   launch  = {{ launch }}
//   board   = {{ board }}

const c = @cImport({
    @cInclude("nros/boot_config.h");
    @cInclude("nros/main.h");
    @cInclude("nros/nros_cpp_ffi.h");
{%- if boot.tier_storage or boot.component_storage %}
    @cInclude("nros/nros_cpp_config_generated.h");
{%- endif %}
});

/// A fixed `char[N]` from a literal, as the boot blob's fields are.
fn fixed(comptime n: usize, comptime s: []const u8) [n]u8 {
    var out = [_]u8{0} ** n;
    @memcpy(out[0..s.len], s);
    return out;
}

// The C components' factory + configure seams (NROS_C_COMPONENT).
{%- for k in components if k.kind == "c" %}
extern fn __nros_c_component_{{ k.pkg | pkg_ident }}_create() ?*anyopaque;
extern fn __nros_c_component_{{ k.pkg | pkg_ident }}_configure(node: *const c.nros_cpp_node_t, executor: ?*anyopaque, self: ?*anyopaque) i32;
{%- endfor %}

// Static per-node storage.
{%- for n in nodes %}
var __nros_node_{{ loop.index0 }}: c.nros_cpp_node_t = undefined;
{%- endfor %}
{%- macro node_body(n, idx, at) %}
    {
{%- for r in n.remaps %}
        if (c.nros_cpp_declare_remap(executor, "{{ n.name | c_str }}", "/", "{{ r[0] | c_str }}", "{{ r[1] | c_str }}") != c.NROS_CPP_RET_OK) return -1;
{%- endfor %}
{%- for p in n.params %}
        if (c.nros_cpp_declare_param(executor, {{ at }}, "{{ p[0] | c_str }}", "{{ p[1] | c_str }}") != c.NROS_CPP_RET_OK) return -1;
{%- endfor %}
        const nrc = c.nros_cpp_node_create(executor, "{{ n.name | c_str }}", "{{ n.namespace | c_str }}", &__nros_node_{{ idx }});
        if (nrc != c.NROS_CPP_RET_OK) return nrc;
{%- if n.qos_overrides %}
        const qos = [_]c.nros_cpp_qos_override_t{
{%- for q in n.qos_overrides %}
            .{ .topic = "{{ q.topic | c_str }}", .role = {{ q.role }}, .policy = {{ q.policy }}, .value = {{ q.value }} },
{%- endfor %}
        };
        if (c.nros_cpp_node_set_qos_overrides(&__nros_node_{{ idx }}, &qos, qos.len) != c.NROS_CPP_RET_OK) return -1;
{%- endif %}
        const self = __nros_c_component_{{ n.pkg | pkg_ident }}_create();
        const crc = __nros_c_component_{{ n.pkg | pkg_ident }}_configure(&__nros_node_{{ idx }}, executor, self);
        if (crc != 0) return crc;
    }
{%- endmacro %}
{%- macro service_calls() %}
{%- if services.param_services %}
    _ = c.nros_cpp_register_parameter_services(executor);
{%- endif %}
{%- if services.lifecycle_code is not none %}
    if (c.nros_cpp_lifecycle_autostart(executor, {{ services.lifecycle_code }}) != c.NROS_CPP_RET_OK) return -1;
{%- endif %}
{%- endmacro %}
{% if tiers %}
{%- for t in tiers.setups %}
fn __nros_entry_setup_tier_{{ t.index }}(executor: ?*anyopaque) callconv(.C) i32 {
    if (executor == null) return c.NROS_CPP_RET_NOT_INIT;
{%- for s in t.nodes %}{{ node_body(nodes[s.node], s.node, s.on_executor) }}{% endfor %}
{%- if t.emits_services %}{{ service_calls() }}{% endif %}
    return 0;
}
{%- endfor %}
{% for t in tiers.rows %}
{%- if t.groups %}
var __nros_tier_{{ t.index }}_groups = [_][*c]const u8{ {% for g in t.groups %}"{{ g[0] | c_str }}", "{{ g[1] | c_str }}", "{{ g[2] | c_str }}", {% endfor %}};
{%- endif %}
{%- endfor %}
const __nros_tiers = [_]c.nros_native_tier_spec_t{
{%- for t in tiers.rows %}
    .{
        .name = "{{ t.name | c_str }}",
        .groups = {% if t.groups %}&__nros_tier_{{ t.index }}_groups{% else %}null{% endif %},
        .n_groups = {{ t.groups | length }},
        .priority = {{ t.priority }},
        .stack_bytes = {{ t.stack_bytes }},
        .spin_period_us = {{ t.spin_period_us }},
        .setup = &__nros_entry_setup_tier_{{ t.index }},
        .core_plus1 = {{ t.core_plus1 }},
        .preempt_threshold = {{ t.preempt_threshold }},
        .tier_class = {% if t.class is none %}null{% else %}"{{ t.class | c_str }}"{% endif %},
        .period_us = {{ t.period_us }},
        .budget_us = {{ t.budget_us }},
        .deadline_us = {{ t.deadline_us }},
        .deadline_policy = {% if t.deadline_policy is none %}null{% else %}"{{ t.deadline_policy | c_str }}"{% endif %},
    },
{%- endfor %}
};
{%- else %}
fn __nros_entry_setup(executor: ?*anyopaque) callconv(.C) i32 {
    if (executor == null) return c.NROS_CPP_RET_NOT_INIT;
{%- if sched %}
    var sc = [_]u8{0} ** {{ sched.n }};
{%- for x in sched.contexts %}
    if (c.nros_cpp_create_sched_context_from_policy(executor, {% if x.class is none %}null{% else %}"{{ x.class | c_str }}"{% endif %}, {{ x.period_us }}, {{ x.budget_us }}, {{ x.deadline_us }}, {% if x.deadline_policy is none %}null{% else %}"{{ x.deadline_policy | c_str }}"{% endif %}, {{ x.os_pri }}, &sc[{{ x.index }}]) != c.NROS_CPP_RET_OK) return -1;
{%- endfor %}
{%- for b in sched.node_binds %}
    if (c.nros_cpp_bind_node_name_sched(executor, "{{ b.name | c_str }}", "{{ b.namespace | c_str }}", sc[{{ b.sched_context }}]) != c.NROS_CPP_RET_OK) return -1;
{%- endfor %}
{%- for b in sched.group_binds %}
    if (c.nros_cpp_bind_group_sched(executor, "{{ b.name | c_str }}", "{{ b.namespace | c_str }}", "{{ b.group | c_str }}", sc[{{ b.tier_index }}]) != c.NROS_CPP_RET_OK) return -1;
{%- endfor %}
{%- endif %}
{%- for n in nodes %}{{ node_body(n, loop.index0, loop.index0) }}{% endfor %}
{{- service_calls() }}
    return 0;
}
{%- endif %}

// The baked boot config (RFC-0045), in the section a post-link patcher reads.
export const NROS_BOOT_CONFIG: c.struct_nros_baked_boot_config linksection(".nros_boot_config") = .{
    .magic = c.NROS_BOOT_CONFIG_MAGIC,
    .version = c.NROS_BOOT_CONFIG_VERSION,
    .set_flags = 0
{%- if boot_config.node_name is not none %} | c.NROS_BOOT_SET_NODE_NAME{% endif %}
{%- if boot_config.namespace is not none %} | c.NROS_BOOT_SET_NAMESPACE{% endif %}
{%- if boot_config.locator is not none %} | c.NROS_BOOT_SET_LOCATOR{% endif %}
{%- if boot_config.domain is not none %} | c.NROS_BOOT_SET_DOMAIN{% endif %}
{%- if boot_config.rmw is not none %} | c.NROS_BOOT_SET_RMW{% endif %},
    .domain_id = {% if boot_config.domain is not none %}{{ boot_config.domain }}{% else %}0{% endif %},
    .node_name = fixed(64, "{% if boot_config.node_name is not none %}{{ boot_config.node_name | c_str }}{% endif %}"),
    .locator = fixed(96, "{% if boot_config.locator is not none %}{{ boot_config.locator | c_str }}{% endif %}"),
    .namespace_ = fixed(64, "{% if boot_config.namespace is not none %}{{ boot_config.namespace | c_str }}{% endif %}"),
    .rmw = fixed(32, "{% if boot_config.rmw is not none %}{{ boot_config.rmw | c_str }}{% endif %}"),
};
{% if boot.tier_storage %}
var __nros_tier_executor_storage: [{{ boot.n_tiers }}][(c.NROS_CPP_EXECUTOR_STORAGE_SIZE + 7) / 8]u64 = undefined;
{% elif boot.component_storage %}
var __nros_executor_storage: [(c.NROS_CPP_EXECUTOR_STORAGE_SIZE + 7) / 8]u64 = undefined;
{% endif %}
{#- Issues 1598 + 1232 — this fixture does not spell the RTOS's static task
    types (`boot.task_memory`; the C/C++ packs do, through the family header's
    macros), so it passes NULL: FreeRTOS then `xTaskCreate`s each tier and
    Zephyr's runner refuses, naming the missing memory. -#}
{%- set name = "c.nros_boot_config_node_name(&NROS_BOOT_CONFIG), c.nros_boot_config_namespace(&NROS_BOOT_CONFIG)" %}
{%- set connect = "" if boot_shape == "host" else "c.NROS_ENTRY_LOCATOR, c.NROS_ENTRY_DOMAIN_ID, " %}
fn run() i32 {
{%- if boot.tiers %}
    return c.{{ boot.runners.run_tiers }}({{ connect }}{{ name }}, &__nros_tiers, __nros_tiers.len{% if boot.tier_storage %}, &__nros_tier_executor_storage, @sizeOf(@TypeOf(__nros_tier_executor_storage[0])){% endif %}{% if boot.task_memory %}, null{% endif %});
{%- else %}
    return c.{{ boot.runners.run_components }}({{ connect }}{{ name }}, &__nros_entry_setup{% if boot.component_storage %}, &__nros_executor_storage, @sizeOf(@TypeOf(__nros_executor_storage)){% endif %});
{%- endif %}
}
{% if boot_shape == "app" %}
export fn nros_app_main(_: c_int, _: [*c][*c]u8) c_int {
    return run();
}

// `NROS_APP_MAIN_REGISTER_VOID()`'s body: the board's startup calls this.
export fn app_main() void {
    _ = nros_app_main(0, null);
}
{%- else %}
export fn main() c_int {
    return run();
}
{%- endif %}
