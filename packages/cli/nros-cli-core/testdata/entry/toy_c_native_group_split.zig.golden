// Generated by the toy Zig entry pack (phase-474 W5) — a test fixture.
//   bringup = demo_bringup
//   launch  = /tmp/system.launch.xml
//   board   = native

const c = @cImport({
    @cInclude("nros/boot_config.h");
    @cInclude("nros/main.h");
    @cInclude("nros/nros_cpp_ffi.h");
});

/// A fixed `char[N]` from a literal, as the boot blob's fields are.
fn fixed(comptime n: usize, comptime s: []const u8) [n]u8 {
    var out = [_]u8{0} ** n;
    @memcpy(out[0..s.len], s);
    return out;
}

// The C components' factory + configure seams (NROS_C_COMPONENT).
extern fn __nros_c_component_ctrl_pkg_create() ?*anyopaque;
extern fn __nros_c_component_ctrl_pkg_configure(node: *const c.nros_cpp_node_t, executor: ?*anyopaque, self: ?*anyopaque) i32;
extern fn __nros_c_component_telem_pkg_create() ?*anyopaque;
extern fn __nros_c_component_telem_pkg_configure(node: *const c.nros_cpp_node_t, executor: ?*anyopaque, self: ?*anyopaque) i32;

// Static per-node storage.
var __nros_node_0: c.nros_cpp_node_t = undefined;
var __nros_node_1: c.nros_cpp_node_t = undefined;

fn __nros_entry_setup(executor: ?*anyopaque) callconv(.C) i32 {
    if (executor == null) return c.NROS_CPP_RET_NOT_INIT;
    var sc = [_]u8{0} ** 2;
    if (c.nros_cpp_create_sched_context_from_policy(executor, null, 0, 0, 0, null, 80, &sc[0]) != c.NROS_CPP_RET_OK) return -1;
    if (c.nros_cpp_create_sched_context_from_policy(executor, null, 0, 0, 0, null, 10, &sc[1]) != c.NROS_CPP_RET_OK) return -1;
    if (c.nros_cpp_bind_node_name_sched(executor, "ctrl", "/", sc[0]) != c.NROS_CPP_RET_OK) return -1;
    if (c.nros_cpp_bind_node_name_sched(executor, "telem", "/", sc[1]) != c.NROS_CPP_RET_OK) return -1;
    if (c.nros_cpp_bind_group_sched(executor, "ctrl", "/", "ctrl_grp", sc[0]) != c.NROS_CPP_RET_OK) return -1;
    if (c.nros_cpp_bind_group_sched(executor, "telem", "/", "telem_grp", sc[1]) != c.NROS_CPP_RET_OK) return -1;
    if (c.nros_cpp_bind_group_sched(executor, "ctrl", "/", "telem_grp", sc[1]) != c.NROS_CPP_RET_OK) return -1;
    {
        const nrc = c.nros_cpp_node_create(executor, "ctrl", "/", &__nros_node_0);
        if (nrc != c.NROS_CPP_RET_OK) return nrc;
        const self = __nros_c_component_ctrl_pkg_create();
        const crc = __nros_c_component_ctrl_pkg_configure(&__nros_node_0, executor, self);
        if (crc != 0) return crc;
    }
    {
        const nrc = c.nros_cpp_node_create(executor, "telem", "/", &__nros_node_1);
        if (nrc != c.NROS_CPP_RET_OK) return nrc;
        const self = __nros_c_component_telem_pkg_create();
        const crc = __nros_c_component_telem_pkg_configure(&__nros_node_1, executor, self);
        if (crc != 0) return crc;
    }
    return 0;
}

// The baked boot config (RFC-0045), in the section a post-link patcher reads.
export const NROS_BOOT_CONFIG: c.struct_nros_baked_boot_config linksection(".nros_boot_config") = .{
    .magic = c.NROS_BOOT_CONFIG_MAGIC,
    .version = c.NROS_BOOT_CONFIG_VERSION,
    .set_flags = 0,
    .domain_id = 0,
    .node_name = fixed(64, ""),
    .locator = fixed(96, ""),
    .namespace_ = fixed(64, ""),
    .rmw = fixed(32, ""),
};

fn run() i32 {
    return c.nros_board_native_run_components_named_ns(c.nros_boot_config_node_name(&NROS_BOOT_CONFIG), c.nros_boot_config_namespace(&NROS_BOOT_CONFIG), &__nros_entry_setup);
}

export fn main() c_int {
    return run();
}
