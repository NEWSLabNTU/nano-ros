/* Issues 1551 + 1568 — every tier's executor storage, one block per tier, as a
 * file-scope static the linker places and `mem-report` names. The runner used
 * to take each block out of the platform heap, and nothing multiplied the
 * storage by the tier count against it. The size is this build's own
 * NROS_CPP_EXECUTOR_STORAGE_SIZE, so the include is mandatory: without it there
 * is no honest size to write. The runner asks the linked library whether the
 * block is big enough and refuses it if not. */
#include <rclcpp/detail/nros_cpp_config_generated.h>
/* phase-509 P9b (RFC-0108 "As built in P9b") — a level runner opens ONE
 * executor per core, so ONE block: every level works on it. */
static uint64_t __nros_tier_executor_storage[1][(NROS_CPP_EXECUTOR_STORAGE_SIZE + 7u) / 8u];

/* phase-509 P9 (RFC-0108) — this core's level scheduler: the session every
 * level shares and one seat per level, in a static the linker places and the
 * cost report (`mem-report --levels`) names. Each row of the table above is one
 * level; the runner spawns one worker per level over it. */
#define NROS_CPP_SCHEDULER_BACKING_SIZE_0 NROS_CPP_SCHEDULER_BACKING_SIZE(2u)
static uint64_t __nros_scheduler_0[NROS_CPP_SCHEDULER_BACKING_SIZE_0 / 8u];
/* phase-509 P9b (RFC-0108 "As built in P9b") — the core's ONE executor
 * backing, when this build sizes its levels: every level's members, summed
 * (NROS_CPP_LEVELS_BACKING_SIZE), and the context above carries none inline.
 * A build that sizes no level keeps the whole-image executor inline. The
 * library refuses a backing short of the levels' layout before the session
 * opens. */
#if defined(NROS_CPP_LEVELS_BACKING_SIZE)
static uint64_t __nros_levels_backing[NROS_CPP_LEVELS_BACKING_SIZE / 8u];
static const nros_tier_backing_t __nros_level_backings[1] = {
    {__nros_levels_backing, sizeof(__nros_levels_backing)},
};
#define NROS_ENTRY_LEVEL_BACKINGS __nros_level_backings
#else
#define NROS_ENTRY_LEVEL_BACKINGS NULL
#endif

int main(int argc, char** argv) {
    (void)argc;
    (void)argv;
    return nros_board_native_run_levels_in(nros_boot_config_node_name(&NROS_BOOT_CONFIG), nros_boot_config_namespace(&NROS_BOOT_CONFIG), __nros_tiers, 2u, __nros_tier_executor_storage, sizeof(__nros_tier_executor_storage[0]), NROS_ENTRY_LEVEL_BACKINGS, NULL, __nros_scheduler_0, sizeof(__nros_scheduler_0));
