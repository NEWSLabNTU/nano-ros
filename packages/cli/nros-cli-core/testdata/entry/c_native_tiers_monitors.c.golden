/* Generated by `nros codegen entry --lang c --typed` (RFC-0043)
*   bringup = demo_bringup
*   launch  = /tmp/system.launch.xml
*   board   = native
*
* DO NOT EDIT — regenerated at configure time. Routes each launch node
* to the real executor via its `NROS_C_COMPONENT` factory/configure seam
* (no synthesizing interpreter); `nros_board_native_run_tiers_in`
* owns init/spin/shutdown.
*/

#include <nros/boot_config.h>  /* nros_baked_boot_config + the nros_boot_config_* readers */
#include <nros/main.h>         /* the board's C-ABI run_components / run_tiers */
#include <nros/nros_cpp_ffi.h> /* nros_cpp_node_t + nros_cpp_node_create + ret codes */

/* C component factory + configure seam (NROS_C_COMPONENT). The node's
 * `nros_cpp_node_t*` + executor handle are handed to `configure`, which
 * registers the component's real callbacks on the executor. */
extern void* __nros_c_component_ctrl_pkg_create(void);
extern int32_t __nros_c_component_ctrl_pkg_configure(const nros_cpp_node_t* node, void* executor, void* self);
extern void* __nros_c_component_telem_pkg_create(void);
extern int32_t __nros_c_component_telem_pkg_configure(const nros_cpp_node_t* node, void* executor, void* self);

/* Static per-node storage (outlives the spin loop; no heap). */
static nros_cpp_node_t __nros_node_0;
static nros_cpp_node_t __nros_node_1;

/* issue 1604 / phase-462 W1 (RFC-0052) -- contract monitor rows (tier[0] high): one
 * per contracted publisher and per age contract, the same rows the Rust road
 * bakes into `system_monitors.rs` and the C++ pack into its entry. The runtime
 * builds its spec/cell tables in the storage below at install
 * (`nros_cpp_install_monitors`), so an image with no contract carries none of
 * this. The storage is `uint64_t` so it is 8-aligned without C11 `_Alignas`. */
static const nros_cpp_monitor_row_t __nros_mon_rows_t0[1] = {
    { "/cmd", "/ctrl/cmd", 100000u, 5u },
};
static uint64_t __nros_mon_storage_t0[(1u * NROS_CPP_MONITOR_ROW_STORAGE + 7u) / 8u];

/* issue 1604 / phase-462 W1 (RFC-0052) -- contract monitor rows (tier[1] low): one
 * per contracted publisher and per age contract, the same rows the Rust road
 * bakes into `system_monitors.rs` and the C++ pack into its entry. The runtime
 * builds its spec/cell tables in the storage below at install
 * (`nros_cpp_install_monitors`), so an image with no contract carries none of
 * this. The storage is `uint64_t` so it is 8-aligned without C11 `_Alignas`. */
static const nros_cpp_monitor_row_t __nros_mon_rows_t1[1] = {
    { "/telemetry", "/telem/telemetry", 1000u, 0u },
};
static uint64_t __nros_mon_storage_t1[(1u * NROS_CPP_MONITOR_ROW_STORAGE + 7u) / 8u];
static const nros_cpp_age_row_t __nros_age_rows_t1[1] = {
    { "/cmd", "/telem/cmd", 50u },
};
static uint64_t __nros_age_storage_t1[(1u * NROS_CPP_AGE_ROW_STORAGE + 7u) / 8u];

/* Phase 274.W2 — per-tier setup functions (one per tier). */
static int32_t __nros_entry_setup_tier_0(void* executor) {
    if (executor == NULL) return (int32_t)NROS_CPP_RET_NOT_INIT;
    /* phase-462 W1 -- contract monitor table (tier[0] high): installed BEFORE any node
     * exists, because a publisher attaches its counter cell at create time.
     * phase-474: the monitors judge from the first spin unless the image sets
     * CONFIG_NROS_MONITOR_ARM_ON_CALL; then the application calls
     * nros_monitors_arm() when it enters RUN, and CONFIG_NROS_MONITOR_ARM_GRACE_MS
     * is the backstop. A verdict before arming is counted, not stored. The
     * ring keeps the latest CONFIG_NROS_EXECUTOR_MAX_VIOLATIONS verdicts;
     * CONFIG_NROS_VIOLATION_DRAIN_REPORT logs each one at the end of its spin,
     * CONFIG_NROS_TRACE_CALLBACKS traces it (markers 21-24) and
     * CONFIG_NROS_BOOT_REPORT keeps it in NROS_VIOLATION_RECORD for SWD. */
    {
        nros_cpp_monitor_tables_t mtables = {
            .rows = __nros_mon_rows_t0,
            .n_rows = 1u,
            .row_storage = __nros_mon_storage_t0,
            .row_storage_len = sizeof(__nros_mon_storage_t0),
            .ages = NULL,
            .n_ages = 0u,
            .age_storage = NULL,
            .age_storage_len = 0u,
        };
        nros_cpp_ret_t mret = nros_cpp_install_monitors(executor, &mtables);
        if (mret != NROS_CPP_RET_OK) return (int32_t)mret;
    }

    {
        nros_cpp_ret_t nrc = nros_cpp_node_create(executor, "ctrl", "/", &__nros_node_0);
        if (nrc != NROS_CPP_RET_OK) return (int32_t)nrc;
        void* self = __nros_c_component_ctrl_pkg_create();
        int32_t crc = __nros_c_component_ctrl_pkg_configure(&__nros_node_0, executor, self);
        if (crc != 0) return crc;
    }
    return 0;
}

static int32_t __nros_entry_setup_tier_1(void* executor) {
    if (executor == NULL) return (int32_t)NROS_CPP_RET_NOT_INIT;
    /* phase-462 W1 -- contract monitor table (tier[1] low): installed BEFORE any node
     * exists, because a publisher attaches its counter cell at create time.
     * phase-474: the monitors judge from the first spin unless the image sets
     * CONFIG_NROS_MONITOR_ARM_ON_CALL; then the application calls
     * nros_monitors_arm() when it enters RUN, and CONFIG_NROS_MONITOR_ARM_GRACE_MS
     * is the backstop. A verdict before arming is counted, not stored. The
     * ring keeps the latest CONFIG_NROS_EXECUTOR_MAX_VIOLATIONS verdicts;
     * CONFIG_NROS_VIOLATION_DRAIN_REPORT logs each one at the end of its spin,
     * CONFIG_NROS_TRACE_CALLBACKS traces it (markers 21-24) and
     * CONFIG_NROS_BOOT_REPORT keeps it in NROS_VIOLATION_RECORD for SWD. */
    {
        nros_cpp_monitor_tables_t mtables = {
            .rows = __nros_mon_rows_t1,
            .n_rows = 1u,
            .row_storage = __nros_mon_storage_t1,
            .row_storage_len = sizeof(__nros_mon_storage_t1),
            .ages = __nros_age_rows_t1,
            .n_ages = 1u,
            .age_storage = __nros_age_storage_t1,
            .age_storage_len = sizeof(__nros_age_storage_t1),
        };
        nros_cpp_ret_t mret = nros_cpp_install_monitors(executor, &mtables);
        if (mret != NROS_CPP_RET_OK) return (int32_t)mret;
    }

    {
        nros_cpp_ret_t nrc = nros_cpp_node_create(executor, "telem", "/", &__nros_node_1);
        if (nrc != NROS_CPP_RET_OK) return (int32_t)nrc;
        void* self = __nros_c_component_telem_pkg_create();
        int32_t crc = __nros_c_component_telem_pkg_configure(&__nros_node_1, executor, self);
        if (crc != 0) return crc;
    }
    return 0;
}

/* Phase 274.W2 — per-tier groups arrays + tier spec table.
 *
 * issue 1172 — a groups array is FLAT `(node name, node namespace, group)`
 * triples, and `n_groups` counts TRIPLES, not strings. The filter used to
 * match on the group id alone, so two nodes' `ctrl` were one key and a tier
 * naming one of them admitted both. An EMPTY array is the WILDCARD, so a tier
 * that names groups must never render an empty one. */
static const char* __nros_tier_0_groups[] = {"ctrl", "/", "ctrl_grp", };
static const char* __nros_tier_1_groups[] = {"telem", "/", "telem_grp", };
static const nros_native_tier_spec_t __nros_tiers[2] = {
    {
        .name = "high",
        .groups = __nros_tier_0_groups,
        .n_groups = 1u,
        .priority = 80LL,
        .stack_bytes = 0u,
        .spin_period_us = 10000ull,
        .setup = &__nros_entry_setup_tier_0,
        .core_plus1 = 0u,
        .preempt_threshold = -1LL,
        .tier_class = NULL,
        .period_us = 0ull,
        .budget_us = 0ull,
        .deadline_us = 0ull,
        .deadline_policy = NULL,
    },
    {
        .name = "low",
        .groups = __nros_tier_1_groups,
        .n_groups = 1u,
        .priority = 10LL,
        .stack_bytes = 0u,
        .spin_period_us = 100000ull,
        .setup = &__nros_entry_setup_tier_1,
        .core_plus1 = 0u,
        .preempt_threshold = -1LL,
        .tier_class = NULL,
        .period_us = 0ull,
        .budget_us = 0ull,
        .deadline_us = 0ull,
        .deadline_policy = NULL,
    },
};

/* Phase 266 (RFC-0045) — baked boot config: post-link readable + session name. */
static const struct nros_baked_boot_config NROS_BOOT_CONFIG
#if defined(__GNUC__) || defined(__clang__)
__attribute__((section(".nros_boot_config"), used))
#endif
= {
.magic      = NROS_BOOT_CONFIG_MAGIC,
.version    = NROS_BOOT_CONFIG_VERSION,
.set_flags  = 0,
.domain_id  = 0,
.node_name  = "",
.locator    = "",
.namespace_ = "",
.rmw        = "",
};

/* Issues 1551 + 1568 — every tier's executor storage, one block per tier, as a
 * file-scope static the linker places and `mem-report` names. The runner used
 * to take each block out of the platform heap, and nothing multiplied the
 * storage by the tier count against it. The size is this build's own
 * NROS_CPP_EXECUTOR_STORAGE_SIZE, so the include is mandatory: without it there
 * is no honest size to write. The runner asks the linked library whether the
 * block is big enough and refuses it if not. */
#include <nros/nros_cpp_config_generated.h>
static uint64_t __nros_tier_executor_storage[2][(NROS_CPP_EXECUTOR_STORAGE_SIZE + 7u) / 8u];

int main(int argc, char** argv) {
    (void)argc;
    (void)argv;
    return nros_board_native_run_tiers_in(nros_boot_config_node_name(&NROS_BOOT_CONFIG), nros_boot_config_namespace(&NROS_BOOT_CONFIG), __nros_tiers, 2u, __nros_tier_executor_storage, sizeof(__nros_tier_executor_storage[0]));
}

