.version    = NROS_BOOT_CONFIG_VERSION,
.set_flags  = 0,
.domain_id  = 0,
.node_name  = "",
.locator    = "",
.namespace_ = "",
.rmw        = "",
};

int main(int /*argc*/, char** /*argv*/) {
    return ::rclcpp::board::LinuxBoard::run_components(nros_boot_config_node_name(&NROS_BOOT_CONFIG), nros_boot_config_namespace(&NROS_BOOT_CONFIG), &__nros_entry_setup);
}
