// Generated by `nros codegen entry --lang cpp` for a PX4 module (RFC-0113 D9)
//   bringup = demo_bringup
//   launch  = /tmp/system.launch.xml
//   board   = px4
//   module  = nros_demo
//
// DO NOT EDIT — regenerated at configure time. One PX4 work item per tier,
// on the work queue the tier's rank picks; a tier's wait is its work item's
// schedule (`nros_px4/tier_work_item.hpp`), never a parked thread.

// nano-ros and the components first: PX4's `defines.h` defines `ERROR`.
#include <rclc/detail/boot_config.h>
#include <rclcpp/detail/component.hpp>
#include <rclcpp/rclcpp.hpp>

#include "talker_pkg/talker.hpp"
#include "listener_pkg/listener.hpp"

#include <nros_px4/tier_work_item.hpp>

#include <px4_platform_common/defines.h>
#include <px4_platform_common/log.h>
#include <px4_platform_common/module.h>



// Static per-node storage (outlives the module; no heap).
static ::rclcpp::Node __nros_node_0;
static ::talker_pkg::TALKER __nros_comp_0;
static ::rclcpp::Node __nros_node_1;
static ::listener_pkg::LISTENER __nros_comp_1;

/* tier[0] (default) setup: creates only this tier's nodes, on its executor. */
static int32_t __nros_entry_setup_tier_0_nodes(void* executor, const char** __nros_at) {
    if (executor == nullptr) return static_cast<int32_t>(::rclcpp::ErrorCode::NotInitialized);
    {
        *__nros_at = "talker";
        ::rclcpp::Result r = ::rclcpp::create_node_on(__nros_node_0, executor, "talker", "/");
        if (!r.ok()) return static_cast<int32_t>(r.raw());
        r = __nros_comp_0.configure(__nros_node_0);
        if (!r.ok()) return static_cast<int32_t>(r.raw());
    }
    {
        *__nros_at = "listener";
        ::rclcpp::Result r = ::rclcpp::create_node_on(__nros_node_1, executor, "listener", "/");
        if (!r.ok()) return static_cast<int32_t>(r.raw());
        r = __nros_comp_1.configure(__nros_node_1);
        if (!r.ok()) return static_cast<int32_t>(r.raw());
    }
    return 0;
}

static int32_t __nros_entry_setup_tier_0(void* executor) {
    const char* __nros_at = nullptr;
    const int32_t rc = __nros_entry_setup_tier_0_nodes(executor, &__nros_at);
    if (rc != 0) nros_cpp_report_setup_failure("default", __nros_at, rc);
    return rc;
}

/* The tier table, in open order: tier 0 opens the session, the rest borrow
 * it. Groups are FLAT `(node name, node namespace, group)` triples (issue
 * 1172); an empty array is the wildcard. */
static const ::nros_px4::TierSpec __nros_tiers[1] = {
    {"default", nullptr, 0u, &__nros_entry_setup_tier_0},
};

/* Phase 266 (RFC-0045) — baked boot config: post-link readable + session name. */
static const struct nros_baked_boot_config NROS_BOOT_CONFIG
#if defined(__GNUC__) || defined(__clang__)
__attribute__((section(".nros_boot_config"), used))
#endif
= {
.magic      = NROS_BOOT_CONFIG_MAGIC,
.version    = NROS_BOOT_CONFIG_VERSION,
.set_flags  = 0,
.domain_id  = 0,
.node_name  = "",
.locator    = "",
.namespace_ = "",
.rmw        = "",
};


/* One work item per tier, on the PX4 work queue its rank picks
 * (`nros_orchestration_ir::px4::px4_work_queues`, most urgent first). */
class NrosTier_default final : public ::nros_px4::TierWorkItem {
public:
    /* rank 0 */
    NrosTier_default() : TierWorkItem("nros_demo_default", px4::wq_configurations::rate_ctrl) {}

protected:
    void on_image_stopped() override;
};

class NrosPx4Entry : public ModuleBase<NrosPx4Entry> {
public:
    static int task_spawn(int argc, char* argv[]);
    static int custom_command(int argc, char* argv[]);
    static int print_usage(const char* reason = nullptr);

    int print_status() override;
    void request_stop() override;

    /* Open every tier in table order (setups never overlap, issue #144),
     * then start them. */
    int32_t start();

    /* The last tier to stop closes the executors, boot tier last. */
    void stopped();

    /* `ModuleBase::get_instance()` is protected; the tiers ask through this. */
    static NrosPx4Entry* instance() { return get_instance(); }

private:
    ::nros_px4::ImageState _image{};
    NrosTier_default _tier_0{};
};

int32_t NrosPx4Entry::start() {
    const char* sn = nros_boot_config_node_name(&NROS_BOOT_CONFIG);
    const char* ns = nros_boot_config_namespace(&NROS_BOOT_CONFIG);
    int32_t rc = _tier_0.open(__nros_tiers[0], _image, nullptr, nullptr, sn, ns);
    if (rc != 0) {
        PX4_ERR("nros tier `default` failed to open (%d)", static_cast<int>(rc));
        return rc;
    }
    _tier_0.start();
    return 0;
}

void NrosPx4Entry::request_stop() {
    ModuleBase::request_stop();
    _image.stopping.store(true);
    _tier_0.wake_for_stop();
}

void NrosPx4Entry::stopped() {
    _tier_0.close();
    ::rclcpp::shutdown();
    exit_and_cleanup();
}

void NrosTier_default::on_image_stopped() {
    NrosPx4Entry* entry = NrosPx4Entry::instance();
    if (entry != nullptr) entry->stopped();
}

int NrosPx4Entry::print_status() {
    PX4_INFO("1 tier(s): default@rate_ctrl");
    PX4_INFO("tier default runs=%u wake_max_us=%llu", static_cast<unsigned>(_tier_0.runs()), static_cast<unsigned long long>(_tier_0.wake_max_us()));
    return 0;
}

int NrosPx4Entry::task_spawn(int /*argc*/, char* /*argv*/[]) {
    NrosPx4Entry* entry = new NrosPx4Entry();
    if (entry == nullptr) {
        PX4_ERR("alloc failed");
        return PX4_ERROR;
    }
    _object.store(entry);
    _task_id = task_id_is_work_queue;
    if (entry->start() != 0) {
        delete entry;
        _object.store(nullptr);
        _task_id = -1;
        return PX4_ERROR;
    }
    return PX4_OK;
}

int NrosPx4Entry::custom_command(int /*argc*/, char* /*argv*/[]) {
    return print_usage("unknown command");
}

int NrosPx4Entry::print_usage(const char* reason) {
    if (reason != nullptr) {
        PX4_WARN("%s\n", reason);
    }
    PRINT_MODULE_DESCRIPTION("nano-ros image `demo_bringup`: generated entry, one work item per tier.");
    PRINT_MODULE_USAGE_NAME("nros_demo", "nano-ros");
    PRINT_MODULE_USAGE_COMMAND("start");
    PRINT_MODULE_USAGE_DEFAULT_COMMANDS();
    return 0;
}

extern "C" __EXPORT int nros_demo_main(int argc, char* argv[]) {
    return NrosPx4Entry::main(argc, argv);
}
