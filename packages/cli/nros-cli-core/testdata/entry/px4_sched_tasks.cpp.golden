/* sched_task[0] (high) setup: creates only this sched task's nodes, on its executor. */
static int32_t __nros_entry_setup_sched_task_0_nodes(void* executor, const char** __nros_at) {
    if (executor == nullptr) return static_cast<int32_t>(::rclcpp::ErrorCode::NotInitialized);
    {
        *__nros_at = "ctrl";
        ::rclcpp::Result r = ::rclcpp::create_node_on(__nros_node_0, executor, "ctrl", "/");
        if (!r.ok()) return static_cast<int32_t>(r.raw());
        /* phase-459 W6 -- the registration's CALLBACK_GROUPS, held against the code. */
        ::rclcpp::detail::DeclaredCallbackGroups __nros_groups_0{"|ctrl_grp|", 0u};
        ::rclcpp::detail::declared_callback_groups_scope() = &__nros_groups_0;
        r = __nros_comp_0.configure(__nros_node_0);
        ::rclcpp::detail::declared_callback_groups_scope() = nullptr;
        ::rclcpp::detail::finish_declared_callback_groups(__nros_node_0, __nros_groups_0);
        if (!__nros_node_0.ok()) return __nros_node_0.error_code();
        if (!r.ok()) return static_cast<int32_t>(r.raw());
    }
    return 0;
}

static int32_t __nros_entry_setup_sched_task_0(void* executor) {
    const char* __nros_at = nullptr;
    const int32_t rc = __nros_entry_setup_sched_task_0_nodes(executor, &__nros_at);
    if (rc != 0) nros_cpp_report_setup_failure("high", __nros_at, rc);
    return rc;
}

/* sched_task[1] (low) setup: creates only this sched task's nodes, on its executor. */
static int32_t __nros_entry_setup_sched_task_1_nodes(void* executor, const char** __nros_at) {
    if (executor == nullptr) return static_cast<int32_t>(::rclcpp::ErrorCode::NotInitialized);
    {
        *__nros_at = "telem";
        ::rclcpp::Result r = ::rclcpp::create_node_on(__nros_node_1, executor, "telem", "/");
        if (!r.ok()) return static_cast<int32_t>(r.raw());
        /* phase-459 W6 -- the registration's CALLBACK_GROUPS, held against the code. */
        ::rclcpp::detail::DeclaredCallbackGroups __nros_groups_1{"|telem_grp|", 0u};
        ::rclcpp::detail::declared_callback_groups_scope() = &__nros_groups_1;
        r = __nros_comp_1.configure(__nros_node_1);
        ::rclcpp::detail::declared_callback_groups_scope() = nullptr;
        ::rclcpp::detail::finish_declared_callback_groups(__nros_node_1, __nros_groups_1);
        if (!__nros_node_1.ok()) return __nros_node_1.error_code();
        if (!r.ok()) return static_cast<int32_t>(r.raw());
    }
    return 0;
}

static int32_t __nros_entry_setup_sched_task_1(void* executor) {
    const char* __nros_at = nullptr;
    const int32_t rc = __nros_entry_setup_sched_task_1_nodes(executor, &__nros_at);
    if (rc != 0) nros_cpp_report_setup_failure("low", __nros_at, rc);
    return rc;
}

/* The tier table, in open order: tier 0 opens the session, the rest borrow
 * it. Groups are FLAT `(node name, node namespace, group)` triples (issue
 * 1172); an empty array is the wildcard. */
static const char* __nros_sched_task_0_groups[] = {"ctrl", "/", "ctrl_grp", };
static const char* __nros_sched_task_1_groups[] = {"telem", "/", "telem_grp", };
static const ::nros_px4::SchedTaskSpec __nros_sched_tasks[2] = {
    {"high", __nros_sched_task_0_groups, 1u, &__nros_entry_setup_sched_task_0},
    {"low", __nros_sched_task_1_groups, 1u, &__nros_entry_setup_sched_task_1},
};

/* Each borrowed sched task's executor storage, as a static the linker places. */
static ::nros_px4::SchedTaskStorage __nros_sched_task_storage[1];

/* Phase 266 (RFC-0045) — baked boot config: post-link readable + session name. */
static const struct nros_baked_boot_config NROS_BOOT_CONFIG
#if defined(__GNUC__) || defined(__clang__)
__attribute__((section(".nros_boot_config"), used))
#endif
= {
.magic      = NROS_BOOT_CONFIG_MAGIC,
.version    = NROS_BOOT_CONFIG_VERSION,
.set_flags  = 0,
.domain_id  = 0,
.node_name  = "",
.locator    = "",
.namespace_ = "",
.rmw        = "",
};


/* One work item per sched task, on the PX4 work queue its rank picks
 * (`nros_orchestration_ir::px4::px4_work_queues`, most urgent first). */
class NrosSchedTask_high final : public ::nros_px4::SchedTaskWorkItem {
public:
    /* rank 0 */
    NrosSchedTask_high() : SchedTaskWorkItem("nros_demo_high", px4::wq_configurations::rate_ctrl) {}

protected:
    void on_image_stopped() override;
};
class NrosSchedTask_low final : public ::nros_px4::SchedTaskWorkItem {
public:
    /* rank 1 */
    NrosSchedTask_low() : SchedTaskWorkItem("nros_demo_low", px4::wq_configurations::hp_default) {}

protected:
    void on_image_stopped() override;
};

class NrosPx4Entry : public ModuleBase<NrosPx4Entry> {
public:
    static int task_spawn(int argc, char* argv[]);
    static int custom_command(int argc, char* argv[]);
    static int print_usage(const char* reason = nullptr);

    int print_status() override;
    void request_stop() override;

    /* Open every sched task in table order (setups never overlap, issue #144),
     * then start them. */
    int32_t start();

    /* The last sched task to stop closes the executors, boot sched task last. */
    void stopped();

    /* `ModuleBase::get_instance()` is protected; the sched tasks ask through this. */
    static NrosPx4Entry* instance() { return get_instance(); }

private:
    ::nros_px4::ImageState _image{};
    NrosSchedTask_high _sched_task_0{};
    NrosSchedTask_low _sched_task_1{};
};

int32_t NrosPx4Entry::start() {
    const char* sn = nros_boot_config_node_name(&NROS_BOOT_CONFIG);
    const char* ns = nros_boot_config_namespace(&NROS_BOOT_CONFIG);
    int32_t rc = _sched_task_0.open(__nros_sched_tasks[0], _image, nullptr, nullptr, sn, ns);
    if (rc != 0) {
        PX4_ERR("nros sched task `high` failed to open (%d)", static_cast<int>(rc));
        return rc;
    }
    rc = _sched_task_1.open(__nros_sched_tasks[1], _image, &__nros_sched_task_storage[0], _sched_task_0.session(), sn, ns);
    if (rc != 0) {
        PX4_ERR("nros sched task `low` failed to open (%d)", static_cast<int>(rc));
        return rc;
    }
    _sched_task_0.start();
    _sched_task_1.start();
    return 0;
}

void NrosPx4Entry::request_stop() {
    ModuleBase::request_stop();
    _image.stopping.store(true);
    _sched_task_0.wake_for_stop();
    _sched_task_1.wake_for_stop();
}

void NrosPx4Entry::stopped() {
    _sched_task_1.close();
    _sched_task_0.close();
    ::rclcpp::shutdown();
    exit_and_cleanup();
}

void NrosSchedTask_high::on_image_stopped() {
    NrosPx4Entry* entry = NrosPx4Entry::instance();
    if (entry != nullptr) entry->stopped();
}

void NrosSchedTask_low::on_image_stopped() {
    NrosPx4Entry* entry = NrosPx4Entry::instance();
    if (entry != nullptr) entry->stopped();
}

int NrosPx4Entry::print_status() {
    PX4_INFO("2 sched task(s): high@rate_ctrl low@hp_default");
    PX4_INFO("sched task high runs=%u wake_max_us=%llu", static_cast<unsigned>(_sched_task_0.runs()), static_cast<unsigned long long>(_sched_task_0.wake_max_us()));
    PX4_INFO("sched task low runs=%u wake_max_us=%llu", static_cast<unsigned>(_sched_task_1.runs()), static_cast<unsigned long long>(_sched_task_1.wake_max_us()));
    return 0;
}

int NrosPx4Entry::task_spawn(int /*argc*/, char* /*argv*/[]) {
    NrosPx4Entry* entry = new NrosPx4Entry();
    if (entry == nullptr) {
        PX4_ERR("alloc failed");
        return PX4_ERROR;
    }
    _object.store(entry);
    _task_id = task_id_is_work_queue;
    if (entry->start() != 0) {
        delete entry;
        _object.store(nullptr);
        _task_id = -1;
        return PX4_ERROR;
    }
    return PX4_OK;
}

int NrosPx4Entry::custom_command(int /*argc*/, char* /*argv*/[]) {
    return print_usage("unknown command");
}

int NrosPx4Entry::print_usage(const char* reason) {
    if (reason != nullptr) {
        PX4_WARN("%s\n", reason);
    }
    PRINT_MODULE_DESCRIPTION("nano-ros image `demo_bringup`: generated entry, one work item per sched task.");
    PRINT_MODULE_USAGE_NAME("nros_demo", "nano-ros");
    PRINT_MODULE_USAGE_COMMAND("start");
    PRINT_MODULE_USAGE_DEFAULT_COMMANDS();
    return 0;
}

extern "C" __EXPORT int nros_demo_main(int argc, char* argv[]) {
    return NrosPx4Entry::main(argc, argv);
}
