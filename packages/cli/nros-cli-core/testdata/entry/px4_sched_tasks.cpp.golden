/* The tier table, in open order: tier 0 opens the session, the rest borrow
 * it. Groups are FLAT `(node name, node namespace, group)` triples (issue
 * 1172); an empty array is the wildcard. */
static const char* __nros_sched_task_0_groups[] = {"ctrl", "/", "ctrl_grp", };
static const char* __nros_sched_task_1_groups[] = {"telem", "/", "telem_grp", };
static const ::nros_px4::SchedTaskSpec __nros_sched_tasks[2] = {
    {"high", __nros_sched_task_0_groups, 1u, &__nros_entry_setup_sched_task_0},
    {"low", __nros_sched_task_1_groups, 1u, &__nros_entry_setup_sched_task_1},
};

