{#-
  Issue 1102 — the typed C entry TU, as a shape you can read.

  `nros codegen entry --lang c --typed` (RFC-0043). The entry creates each
  launch node and hands it to that component's `RCLC_C_COMPONENT`
  factory/configure seam; the board owns init, spin and shutdown.

  Two mutually exclusive bodies, chosen by `Plan::executor_shape` — the SAME
  branch the C++ pack takes (issue 1283):
    * tiers    — one setup function per tier, a groups array per tier, and the
                 `nros_native_tier_spec_t` table `run_tiers` walks.
    * setup    — a single `__nros_entry_setup`. When `sched` is set it first
                 creates one sched context per tier and binds nodes and
                 callback groups to them (a group-split plan, or a board with
                 no `run_tiers`); otherwise it is the plain single-tier case.

  What arrives, and in what form (RFC-0091 §8b):

    * VALUES, spelled here — `name`, `namespace` and `tiers` are raw data. The
      node's `namespace` is the PLAN's, never the literal `"/"` this template
      used to write (issue 1443): the ONE derivation is
      `entry::node_namespace`, so a node is CREATED at the same
      `(name, namespace)` the `nros_cpp_bind_node_name_sched` call below binds
      it by, and a `/island` launch node stops appearing at `/talker`. It is
      never empty — "the model names none" arrives as `"/"`. The template
      quotes strings with the `c_str` FILTER and writes the `LL`/`u`/`ull`
      suffixes itself, because those spellings are C's, not the IR's. A Zig or
      Rust pack renders the same rows differently with no lowering change.
    * ENCODINGS, decided in Rust — `core_plus1` is core-plus-one and `-1` is an
      unset preempt threshold. Those are C-ABI facts, and a pack must not have
      to know them.
    * phase-494 — the CONTEXT is `nros_entry_lower::LoweredEntry` itself, not
      a view a Rust emitter built: there is no `emit_c.rs`. Node bodies index
      `nodes` (a tier setup lists `(node, on_executor)` pairs); package
      identifiers are spelled with the `pkg_ident` filter; what this pack
      needs of Rust is the filters `pack.toml` names, and nothing else.

  A quoting bug cannot originate in this file: the filter is Rust.

  The tier table uses DESIGNATED initialisers (RFC-0091 §5, C99). The struct is
  one of six hand-written mirrors of the same ABI, and a positional row
  silently mis-assigns every field after an insertion — issue 0160's class.
  `.field = value` makes a rename or a removal a compile error HERE, and an
  insertion a zero rather than a shift. `check-ffi-struct-mirrors` reads these
  `.field` names back and compares them to the canonical declaration order.

  Whitespace is byte-compared against testdata/entry/c_*.golden.

  The banner names the runner the entry CALLS, read from the same `boot`
  fields and the same `boot.tiers` predicate as `boot_wrapper.jinja`'s call.
  It used to be the literal `nros_board_native_run_components`, which stopped
  being true of every RTOS board at phase-432 W3.1 and was never the native
  spelling either (that one is `_named`) — issue 1286.
-#}
/* Generated by `nros codegen entry --lang c --typed` (RFC-0043)
*   bringup = {{ bringup }}
*   launch  = {{ launch }}
*   board   = {{ board }}
*
* DO NOT EDIT — regenerated at configure time. Routes each launch node
* to the real executor via its `RCLC_C_COMPONENT` factory/configure seam
* (no synthesizing interpreter); `{{ boot.runners.run_tiers if boot.tiers else boot.runners.run_components }}`
* owns init/spin/shutdown.
*/

#include <rclc/detail/boot_config.h>  /* nros_baked_boot_config + the nros_boot_config_* readers */
#include <rclc/detail/main.h>         /* the board's C-ABI run_components / run_tiers */
{%- if boot_shape == "app" %}
#include <rclc/detail/app_main.h>    /* NROS_APP_MAIN_REGISTER_VOID (app boot shape) */
{%- endif %}
#include <rclcpp/detail/nros_cpp_ffi.h> /* nros_cpp_node_t + nros_cpp_node_create + ret codes */

/* C component factory + configure seam (RCLC_C_COMPONENT). The node's
 * `nros_cpp_node_t*` + executor handle are handed to `configure`, which
 * registers the component's real callbacks on the executor. */
{% for c in components if c.kind == "c" -%}
extern void* __nros_c_component_{{ c.pkg | pkg_ident }}_create(void);
extern int32_t __nros_c_component_{{ c.pkg | pkg_ident }}_configure(const nros_cpp_node_t* node, void* executor, void* self);
{% endfor %}
/* Static per-node storage (outlives the spin loop; no heap). */
{% for n in nodes -%}
static nros_cpp_node_t __nros_node_{{ loop.index0 }};
{% endfor %}
{%- if modes %}
/* phase-462 W4b -- the contract's operational modes. Pass an id to
 * nros_cpp_request_mode() to switch every executor's monitor tables at its
 * next spin; 0 is the base contract. */
{%- for md in modes %}
#define NROS_MODE_{{ md.ident }} {{ md.id }}u /* {{ md.name | c_str }} */
{%- endfor %}
{%- endif %}
{%- for m in monitor_tables %}{% set tag %}{% if m.tier is not none %}_t{{ m.tier }}{% endif %}{% endset %}
/* issue 1604 / phase-462 W1 (RFC-0052) -- contract monitor rows{% if m.tier is not none %} (tier[{{ m.tier }}] {{ m.tier_name }}){% endif %}: one
 * per contracted publisher and per age contract, the same rows the Rust road
 * bakes into `system_monitors.rs` and the C++ pack into its entry. The runtime
 * builds its spec/cell tables in the storage below at install
 * (`nros_cpp_install_monitors`), so an image with no contract carries none of
 * this. The storage is `uint64_t` so it is 8-aligned without C11 `_Alignas`. */
{%- if m.rows %}
static const nros_cpp_monitor_row_t __nros_mon_rows{{ tag }}[{{ m.rows | length }}] = {
{%- for r in m.rows %}
    { "{{ r.topic | c_str }}", "{{ r.fqn | c_str }}", {{ r.min_rate_hz_milli }}u, {{ r.max_latency_ms }}u, {% if r.route_trigger %}"{{ r.route_trigger | c_str }}"{% else %}NULL{% endif %}, {{ r.route_max_latency_ms }}u{% if r.route_deadline_ms %}, {{ r.route_deadline_ms }}u, {{ r.reaction_id }}u, {{ r.mechanism }}u{% endif %} },
{%- endfor %}
};
static uint64_t __nros_mon_storage{{ tag }}[({{ m.rows | length }}u * NROS_CPP_MONITOR_ROW_STORAGE + 7u) / 8u];
{%- if m.rows | selectattr("route_deadline_ms") | list %}
/* phase-503 -- supervised routes: a take still unanswered at its deadline is
 * reported (route-deadline-runtime) and nros_app_reaction_hook, when the
 * application defines it, is called with the row's reaction id:
{%- for r in m.rows %}{% if r.route_deadline_ms %}
 *   row {{ loop.index0 }} {{ r.fqn | c_str }}: deadline {{ r.route_deadline_ms }} ms, reaction {{ r.reaction_id }}{% if r.reaction %} ({{ r.reaction | c_str }}){% endif %}, mechanism {% if r.mechanism == 1 %}timer{% else %}executor{% endif %}
{%- endif %}{% endfor %}
 */
void nros_app_reaction_hook(const nros_cpp_reaction_event_t* event, void* ctx) __attribute__((weak));
{%- endif %}
{%- endif %}
{%- if m.ages %}
static const nros_cpp_age_row_t __nros_age_rows{{ tag }}[{{ m.ages | length }}] = {
{%- for r in m.ages %}
    { "{{ r.topic | c_str }}", "{{ r.fqn | c_str }}", {{ r.max_age_ms }}u, {{ r.deadline_ms }}u },
{%- endfor %}
};
static uint64_t __nros_age_storage{{ tag }}[({{ m.ages | length }}u * NROS_CPP_AGE_ROW_STORAGE + 7u) / 8u];
{%- endif %}
{%- if m.hazards %}
/* phase-462 W3b -- the contract's hazards this executor observes over the rows
 * above: each guard member names an age (0) or rate (1) row, and the observer
 * reports hazard-detected / hazard-reaction / hazard-recovered on the same
 * drain (`nros_cpp_install_hazards`). */
{%- for h in m.hazards %}{% set hi = loop.index0 %}
{%- for g in h.guards %}
static const nros_cpp_hazard_member_t __nros_hz_members{{ tag }}_{{ hi }}_{{ loop.index0 }}[{{ g.members | length }}] = {
{%- for mm in g.members %}
    { {{ mm.kind }}u, {{ mm.row }}u },
{%- endfor %}
};
{%- endfor %}
static const nros_cpp_hazard_guard_t __nros_hz_guards{{ tag }}_{{ hi }}[{{ h.guards | length }}] = {
{%- for g in h.guards %}
    { {% if g.all_of %}1{% else %}0{% endif %}u, __nros_hz_members{{ tag }}_{{ hi }}_{{ loop.index0 }}, {{ g.members | length }}u },
{%- endfor %}
};
{%- endfor %}
static const nros_cpp_hazard_row_t __nros_hz_rows{{ tag }}[{{ m.hazards | length }}] = {
{%- for h in m.hazards %}
    { "{{ h.key | c_str }}", {{ h.ftti_ms }}u, {{ h.settle_ms }}u, __nros_hz_guards{{ tag }}_{{ loop.index0 }}, {{ h.guards | length }}u, {{ h.sink }}u, {{ h.reaction_id }}u },
{%- endfor %}
};
{%- if m.hazards | selectattr("reaction_id") | list %}
/* phase-462 W3c -- a detected hazard whose reacting path states a safe_state
 * calls nros_app_reaction_hook, when the application defines it, with the
 * hazard's reaction id (rule_code hazard-detected, row = the hazard's index):
{%- for h in m.hazards %}{% if h.reaction_id %}
 *   hazard {{ loop.index0 }} {{ h.key | c_str }}: reaction {{ h.reaction_id }}
{%- endif %}{% endfor %}
 */
void nros_app_reaction_hook(const nros_cpp_reaction_event_t* event, void* ctx) __attribute__((weak));
{%- endif %}
static uint64_t __nros_hz_storage{{ tag }}[({{ m.hazards | length }}u * NROS_CPP_HAZARD_ROW_STORAGE + {{ m.hazard_guards }}u * NROS_CPP_HAZARD_GUARD_STORAGE + {{ m.hazard_members }}u * NROS_CPP_HAZARD_MEMBER_STORAGE + 7u) / 8u];
{%- endif %}
{%- if m.modes %}
/* phase-462 W4b -- the contract's modes: each mode's numbers for the rows
 * above, row for row (`nros_cpp_install_modes` copies the base specs and their
 * cells, so only the numbers are stated). */
{%- for md in m.modes %}{% set mi = loop.index %}
{%- if md.rows %}
static const nros_cpp_mode_row_t __nros_mode_rows{{ tag }}_{{ mi }}[{{ md.rows | length }}] = {
{%- for r in md.rows %}
    { {{ r.min_rate_hz_milli }}u, {{ r.max_latency_ms }}u, {{ r.route_max_latency_ms }}u, {{ r.route_deadline_ms }}u },
{%- endfor %}
};
{%- endif %}
{%- if md.ages %}
static const nros_cpp_mode_age_row_t __nros_mode_ages{{ tag }}_{{ mi }}[{{ md.ages | length }}] = {
{%- for a in md.ages %}
    { {{ a }}u },
{%- endfor %}
};
{%- endif %}
{%- endfor %}
{%- if m.base_deadlines %}
/* phase-462 W4c -- the sched-context deadlines the modes move on this
 * executor: table 0 the base's, table k mode k's, each naming the same
 * contexts{% if m.deadline_sc_is_tier %} by tier index into __nros_sc_ids{% endif %}. */
static const nros_cpp_mode_deadline_t __nros_mode_deadlines{{ tag }}_0[{{ m.base_deadlines | length }}] = {
{%- for d in m.base_deadlines %}
    { {{ d.sc }}u, {{ d.deadline_us }}u },
{%- endfor %}
};
{%- for md in m.modes %}{% set mi = loop.index %}
static const nros_cpp_mode_deadline_t __nros_mode_deadlines{{ tag }}_{{ mi }}[{{ md.deadlines | length }}] = {
{%- for d in md.deadlines %}
    { {{ d.sc }}u, {{ d.deadline_us }}u },
{%- endfor %}
};
{%- endfor %}
{%- endif %}
static const nros_cpp_mode_t __nros_modes{{ tag }}[{{ m.modes | length }}] = {
{%- for md in m.modes %}{% set mi = loop.index %}
    { {% if md.rows %}__nros_mode_rows{{ tag }}_{{ mi }}{% else %}NULL{% endif %}, {{ md.rows | length }}u, {% if md.ages %}__nros_mode_ages{{ tag }}_{{ mi }}{% else %}NULL{% endif %}, {{ md.ages | length }}u, {% if m.base_deadlines %}__nros_mode_deadlines{{ tag }}_{{ mi }}{% else %}NULL{% endif %}, {{ md.deadlines | length }}u, {{ md.switch_budget_ms }}u, {% if md.reaction %}"{{ md.reaction | c_str }}"{% else %}NULL{% endif %} },
{%- endfor %}
};
static uint64_t __nros_mode_storage{{ tag }}[(({{ m.modes | length }}u + 1u) * (NROS_CPP_MODE_TABLE_STORAGE + {{ m.base_deadlines | length }}u * NROS_CPP_MODE_DEADLINE_STORAGE) + {{ m.modes | length }}u * ({{ m.rows | length }}u * NROS_CPP_MODE_ROW_STORAGE + {{ m.ages | length }}u * NROS_CPP_MODE_AGE_STORAGE) + 7u) / 8u];
{%- endif %}
{% endfor %}
{% if tiers -%}
/* Phase 274.W2 — per-tier setup functions (one per tier). */
{% for t in tiers.setups -%}
static int32_t __nros_entry_setup_tier_{{ t.index }}(void* executor) {
    if (executor == NULL) return (int32_t)NROS_CPP_RET_NOT_INIT;
{%- if t.monitors %}
{%- with m = t.monitors, mexec = "executor" %}
{%- include "monitor_install_c.jinja" %}
{%- endwith %}
{%- endif %}
{%- for s in t.nodes %}{% set n = nodes[s.node] %}
    {
{%- with dexec = "executor", at = s.on_executor, idx = s.node %}
{%- include "declare_calls.jinja" %}
{%- include "node_body_c.jinja" %}
{%- endwith %}
    }
{%- endfor %}
{%- if t.emits_services %}
{%- include "service_trailer_c.jinja" %}
{%- endif %}
    return 0;
}

{% endfor -%}
/* Phase 274.W2 — per-tier groups arrays + tier spec table.
 *
 * issue 1172 — a groups array is FLAT `(node name, node namespace, group)`
 * triples, and `n_groups` counts TRIPLES, not strings. The filter used to
 * match on the group id alone, so two nodes' `ctrl` were one key and a tier
 * naming one of them admitted both. An EMPTY array is the WILDCARD, so a tier
 * that names groups must never render an empty one. */
{%- for t in tiers.rows %}
{%- if t.groups %}
static const char* __nros_tier_{{ t.index }}_groups[] = {{ '{' }}{% for g in t.groups %}"{{ g[0]|c_str }}", "{{ g[1]|c_str }}", "{{ g[2]|c_str }}", {% endfor %}};
{%- endif %}
{%- endfor %}
static const nros_native_tier_spec_t __nros_tiers[{{ tiers.n }}] = {
{%- for t in tiers.rows %}
    {
        .name = "{{ t.name|c_str }}",
        .groups = {% if t.groups %}__nros_tier_{{ t.index }}_groups{% else %}NULL{% endif %},
        .n_groups = {% if t.groups %}{{ t.groups|length }}u{% else %}0u{% endif %},
        .priority = {{ t.priority }}LL,
        .stack_bytes = {{ t.stack_bytes }}u,
        .spin_period_us = {{ t.spin_period_us }}ull,
        .setup = &__nros_entry_setup_tier_{{ t.index }},
        .core_plus1 = {{ t.core_plus1 }}u,
        .preempt_threshold = {{ t.preempt_threshold }}LL,
        .tier_class = {% if t.class is none %}NULL{% else %}"{{ t.class|c_str }}"{% endif %},
        .period_us = {{ t.period_us }}ull,
        .budget_us = {{ t.budget_us }}ull,
        .deadline_us = {{ t.deadline_us }}ull,
        .deadline_policy = {% if t.deadline_policy is none %}NULL{% else %}"{{ t.deadline_policy|c_str }}"{% endif %},
    },
{%- endfor %}
};

{% include "boot_config.jinja" %}
{% include "boot_wrapper_c.jinja" -%}
{%- else -%}
/* setup (post-init): the executor handle is passed in; create each node +
 * configure its component on the real executor. */
static int32_t __nros_entry_setup(void* executor) {
    if (executor == NULL) {
        return (int32_t)NROS_CPP_RET_NOT_INIT;
    }
{%- if sched %}
    /* issue 1283 — per-tier sched contexts on the single executor (RFC-0047),
     * the C spelling of the C++ pack's block: one context per tier, then the
     * node-name and callback-group tables, all seeded BEFORE any node exists
     * so its entities pick the binding up at register time. */
    uint8_t __nros_sc_ids[{{ sched.n }}] = {0};
{%- for c in sched.contexts %}
    {
        nros_cpp_ret_t scr = nros_cpp_create_sched_context_from_policy(executor, {% if c.class is none %}NULL{% else %}"{{ c.class|c_str }}"{% endif %}, {{ c.period_us }}ull, {{ c.budget_us }}ull, {{ c.deadline_us }}ull, {% if c.deadline_policy is none %}NULL{% else %}"{{ c.deadline_policy|c_str }}"{% endif %}, {{ c.os_pri }}u, &__nros_sc_ids[{{ c.index }}]);
        if (scr != NROS_CPP_RET_OK) return (int32_t)scr;
    }
{%- endfor %}
{#- A bind that does not fit (full table, over-long name) is REFUSED by the
    runtime, never dropped (issue 1172) — and a refusal ignored here is the same
    silent loss one level up: the node or group would run on the default sched
    context with nothing reporting it. So each bind is checked exactly like the
    context it names, and a failure aborts setup, which aborts boot. #}
{%- for b in sched.node_binds %}
    {
        nros_cpp_ret_t brc = nros_cpp_bind_node_name_sched(executor, "{{ b.name|c_str }}", "{{ b.namespace|c_str }}", __nros_sc_ids[{{ b.sched_context }}]);
        if (brc != NROS_CPP_RET_OK) return (int32_t)brc;
    }
{%- endfor %}
{%- for b in sched.group_binds %}
    {
        nros_cpp_ret_t brc = nros_cpp_bind_group_sched(executor, "{{ b.name|c_str }}", "{{ b.namespace|c_str }}", "{{ b.group|c_str }}", __nros_sc_ids[{{ b.tier_index }}]);
        if (brc != NROS_CPP_RET_OK) return (int32_t)brc;
    }
{%- endfor %}
{%- endif %}
{%- if monitors %}
{%- with m = monitors, mexec = "executor" %}
{%- include "monitor_install_c.jinja" %}
{%- endwith %}
{%- endif %}
{%- for n in nodes %}
    {
{%- with dexec = "executor", at = loop.index0, idx = loop.index0 %}
{%- include "declare_calls.jinja" %}
{%- include "node_body_c.jinja" %}
{%- endwith %}
    }
{%- endfor %}
{%- include "service_trailer_c.jinja" %}
    return 0;
}

{% include "boot_config.jinja" %}
{% include "boot_wrapper_c.jinja" -%}
{%- endif %}
