{#-
  Issue 1102 / phase-432 W2.3 — the C++ entry TU.

  Everything here is LAYOUT. Every value the view carries is already correct:
  board paths are resolved through `nros_entry_lower`, tier rows are values
  rather than initialiser text, and raw strings are quoted here with the
  `c_str` filter (C++ string literals escape exactly as C ones do, so there is
  one filter rather than a second spelling of the same rule).

  What this template must NEVER do is decide a target fact — see `render.rs`.

  The tier table uses DESIGNATED initialisers (RFC-0091 §5). `NativeTierSpec`
  is one of six hand-written mirrors of the same C ABI struct, and a positional
  row silently mis-assigns every field after an insertion — issue 0160's class.
  `.field = value` makes a rename or a removal a compile error HERE, and an
  insertion a zero rather than a shift. `check-ffi-struct-mirrors` reads these
  `.field` names back and compares them to the canonical declaration order, so
  the two halves cannot drift apart.

  C++ designated initialisers are C++20, and this tree pins C++14 (Zephyr's
  `CONFIG_STD_CPP14=y`, `-std=c++14` in three cross toolchains). MEASURED as
  accepted at `-std=c++14 -Wall -Wextra` by g++ 11.4, clang++ 14,
  arm-none-eabi-g++ 13.2, arm-zephyr-eabi-g++ 12.2 and riscv64-unknown-elf-g++
  10.2 — every compiler this tree reaches. Only `-Wpedantic` objects
  (`-Wc++20-extensions` on GCC 13+, `-Wc++20-designator` on Clang), and nothing
  in-tree sets it on a generated entry. A downstream build that does will need
  `-Wno-pedantic` on this TU; the C pack's initialisers are plain C99 and have
  no such caveat.

  Whitespace is load-bearing: these bytes are compared against a golden and
  then handed to a compiler. Every control tag is written `{%- … %}` — strip
  what comes before, keep the newline after — so a blank line in the output is
  a blank line written here, and nothing else.

  phase-494 W4 — the CONTEXT is `nros_entry_lower::LoweredEntry` itself; there
  is no `emit_cpp.rs`. The two `set`s below are the only computation here, and
  they are FILTERS over the lowered seams, not facts: which seams are C and
  which are Rust is already decided by `components[].kind`.
-#}
{%- set c_pkgs = components | selectattr("kind", "eq", "c") | list %}
{%- set rust_pkgs = components | selectattr("kind", "eq", "rust") | list -%}
// Generated by `nros codegen entry --lang cpp` (typed — RFC-0043)
//   bringup = {{ bringup }}
//   launch  = {{ launch }}
//   board   = {{ board }}
//
// DO NOT EDIT — regenerated at configure time. Routes each launch node
// to the real executor via its component object (no synthesizing
// interpreter); `Board::run_components` owns init/spin/shutdown.

#include <rclc/detail/boot_config.h>
#include <rclcpp/detail/component.hpp>
#include <rclcpp/detail/main.hpp>
#include <rclcpp/rclcpp.hpp>
{%- if boot_shape == "app" %}
#include <rclc/detail/app_main.h>
{%- endif %}
{%- if "rclcpp" in nodes | map(attribute="kind") | list %}
#include <new> // placement-new into the component arena slot
{%- endif %}

{% for h in headers %}#include "{{ h }}"
{% endfor -%}
{% if c_pkgs %}
// C component factory + configure seam (RCLC_C_COMPONENT); the
// node's `ffi_handle()` is handed to the C `configure` as an opaque
// `nros_cpp_node_t*` — the C side registers real callbacks on it.
extern "C" {
{%- for c in c_pkgs %}
    void* __nros_c_component_{{ c.pkg | pkg_ident }}_create(void);
    int32_t __nros_c_component_{{ c.pkg | pkg_ident }}_configure(const ::nros_cpp_node_t* node, void* executor, void* self);
{%- endfor %}
}
{% endif %}
{% if rust_pkgs %}
// Rust component install seam (rclcpp::node!); the Rust node
// self-creates its node on the shared executor handle (phase-257).
extern "C" {
{%- for c in rust_pkgs %}
    int32_t __nros_component_{{ c.pkg | pkg_ident }}_install(const void* node, void* executor, void* self);
{%- endfor %}
}
{% endif %}
// Static per-node storage (outlives the spin loop; no heap).
{%- for s in nodes %}
{%- if s.kind != "rust" %}
{%- if s.kind == "rclcpp" %}
alignas(::{{ s.class }}) static unsigned char __nros_comp_buf_{{ loop.index0 }}[sizeof(::{{ s.class }})];
static ::{{ s.class }}* __nros_comp_{{ loop.index0 }} = nullptr;
{%- else %}
static ::rclcpp::Node __nros_node_{{ loop.index0 }};
{%- if s.class %}
static ::{{ s.class }} __nros_comp_{{ loop.index0 }};
{%- endif %}
{%- endif %}
{%- endif %}
{%- endfor %}
{%- if modes %}

/* phase-462 W4b -- the contract's operational modes. Pass an id to
 * nros_cpp_request_mode() to switch every executor's monitor tables at its
 * next spin; 0 is the base contract. */
{%- for md in modes %}
#define NROS_MODE_{{ md.ident }} {{ md.id }}u /* {{ md.name | c_str }} */
{%- endfor %}
{%- endif %}
{%- for m in monitor_tables %}{% set tag %}{% if m.tier is not none %}_t{{ m.tier }}{% endif %}{% endset %}

/* phase-462 W1 (RFC-0052) -- contract monitor rows{% if m.tier is not none %} (tier[{{ m.tier }}] {{ m.tier_name }}){% endif %}: one per contracted
 * publisher and per age contract, the same rows the Rust road bakes into
 * `system_monitors.rs`. The runtime builds its spec/cell tables in the storage
 * below at install (`nros_cpp_install_monitors`), so an image with no contract
 * carries none of this. */
{%- if m.rows %}
static const ::nros_cpp_monitor_row_t __nros_mon_rows{{ tag }}[{{ m.rows | length }}] = {
{%- for r in m.rows %}
    { "{{ r.topic | c_str }}", "{{ r.fqn | c_str }}", {{ r.min_rate_hz_milli }}u, {{ r.max_latency_ms }}u, {% if r.route_trigger %}"{{ r.route_trigger | c_str }}"{% else %}nullptr{% endif %}, {{ r.route_max_latency_ms }}u{% if r.route_deadline_ms %}, {{ r.route_deadline_ms }}u, {{ r.reaction_id }}u, {{ r.mechanism }}u{% endif %} },
{%- endfor %}
};
alignas(8) static unsigned char __nros_mon_storage{{ tag }}[{{ m.rows | length }} * NROS_CPP_MONITOR_ROW_STORAGE];
{%- if m.rows | selectattr("route_deadline_ms") | list %}
/* phase-503 -- supervised routes: a take still unanswered at its deadline is
 * reported (route-deadline-runtime) and nros_app_reaction_hook, when the
 * application defines it, is called with the row's reaction id:
{%- for r in m.rows %}{% if r.route_deadline_ms %}
 *   row {{ loop.index0 }} {{ r.fqn | c_str }}: deadline {{ r.route_deadline_ms }} ms, reaction {{ r.reaction_id }}{% if r.reaction %} ({{ r.reaction | c_str }}){% endif %}, mechanism {% if r.mechanism == 1 %}timer{% else %}executor{% endif %}
{%- endif %}{% endfor %}
 */
extern "C" void nros_app_reaction_hook(const ::nros_cpp_reaction_event_t* event, void* ctx) __attribute__((weak));
{%- endif %}
{%- endif %}
{%- if m.ages %}
static const ::nros_cpp_age_row_t __nros_age_rows{{ tag }}[{{ m.ages | length }}] = {
{%- for r in m.ages %}
    { "{{ r.topic | c_str }}", "{{ r.fqn | c_str }}", {{ r.max_age_ms }}u, {{ r.deadline_ms }}u },
{%- endfor %}
};
alignas(8) static unsigned char __nros_age_storage{{ tag }}[{{ m.ages | length }} * NROS_CPP_AGE_ROW_STORAGE];
{%- endif %}
{%- if m.hazards %}
/* phase-462 W3b -- the contract's hazards this executor observes over the rows
 * above: each guard member names an age (0) or rate (1) row, and the observer
 * reports hazard-detected / hazard-reaction / hazard-recovered on the same
 * drain (`nros_cpp_install_hazards`). */
{%- for h in m.hazards %}{% set hi = loop.index0 %}
{%- for g in h.guards %}
static const ::nros_cpp_hazard_member_t __nros_hz_members{{ tag }}_{{ hi }}_{{ loop.index0 }}[{{ g.members | length }}] = {
{%- for mm in g.members %}
    { {{ mm.kind }}u, {{ mm.row }}u },
{%- endfor %}
};
{%- endfor %}
static const ::nros_cpp_hazard_guard_t __nros_hz_guards{{ tag }}_{{ hi }}[{{ h.guards | length }}] = {
{%- for g in h.guards %}
    { {% if g.all_of %}1{% else %}0{% endif %}u, __nros_hz_members{{ tag }}_{{ hi }}_{{ loop.index0 }}, {{ g.members | length }}u },
{%- endfor %}
};
{%- endfor %}
static const ::nros_cpp_hazard_row_t __nros_hz_rows{{ tag }}[{{ m.hazards | length }}] = {
{%- for h in m.hazards %}
    { "{{ h.key | c_str }}", {{ h.ftti_ms }}u, {{ h.settle_ms }}u, __nros_hz_guards{{ tag }}_{{ loop.index0 }}, {{ h.guards | length }}u, {{ h.sink }}u, {{ h.reaction_id }}u },
{%- endfor %}
};
{%- if m.hazards | selectattr("reaction_id") | list %}
/* phase-462 W3c -- a detected hazard whose reacting path states a safe_state
 * calls nros_app_reaction_hook, when the application defines it, with the
 * hazard's reaction id (rule_code hazard-detected, row = the hazard's index):
{%- for h in m.hazards %}{% if h.reaction_id %}
 *   hazard {{ loop.index0 }} {{ h.key | c_str }}: reaction {{ h.reaction_id }}
{%- endif %}{% endfor %}
 */
extern "C" void nros_app_reaction_hook(const ::nros_cpp_reaction_event_t* event, void* ctx) __attribute__((weak));
{%- endif %}
alignas(8) static unsigned char __nros_hz_storage{{ tag }}[{{ m.hazards | length }} * NROS_CPP_HAZARD_ROW_STORAGE + {{ m.hazard_guards }} * NROS_CPP_HAZARD_GUARD_STORAGE + {{ m.hazard_members }} * NROS_CPP_HAZARD_MEMBER_STORAGE];
{%- endif %}
{%- if m.modes %}
/* phase-462 W4b -- the contract's modes: each mode's numbers for the rows
 * above, row for row (`nros_cpp_install_modes` copies the base specs and their
 * cells, so only the numbers are stated). */
{%- for md in m.modes %}{% set mi = loop.index %}
{%- if md.rows %}
static const ::nros_cpp_mode_row_t __nros_mode_rows{{ tag }}_{{ mi }}[{{ md.rows | length }}] = {
{%- for r in md.rows %}
    { {{ r.min_rate_hz_milli }}u, {{ r.max_latency_ms }}u, {{ r.route_max_latency_ms }}u, {{ r.route_deadline_ms }}u },
{%- endfor %}
};
{%- endif %}
{%- if md.ages %}
static const ::nros_cpp_mode_age_row_t __nros_mode_ages{{ tag }}_{{ mi }}[{{ md.ages | length }}] = {
{%- for a in md.ages %}
    { {{ a }}u },
{%- endfor %}
};
{%- endif %}
{%- endfor %}
{%- if m.base_deadlines %}
/* phase-462 W4c -- the sched-context deadlines the modes move on this
 * executor: table 0 the base's, table k mode k's, each naming the same
 * contexts{% if m.deadline_sc_is_tier %} by tier index into __nros_sc_ids{% endif %}. */
static const ::nros_cpp_mode_deadline_t __nros_mode_deadlines{{ tag }}_0[{{ m.base_deadlines | length }}] = {
{%- for d in m.base_deadlines %}
    { {{ d.sc }}u, {{ d.deadline_us }}u },
{%- endfor %}
};
{%- for md in m.modes %}{% set mi = loop.index %}
static const ::nros_cpp_mode_deadline_t __nros_mode_deadlines{{ tag }}_{{ mi }}[{{ md.deadlines | length }}] = {
{%- for d in md.deadlines %}
    { {{ d.sc }}u, {{ d.deadline_us }}u },
{%- endfor %}
};
{%- endfor %}
{%- endif %}
static const ::nros_cpp_mode_t __nros_modes{{ tag }}[{{ m.modes | length }}] = {
{%- for md in m.modes %}{% set mi = loop.index %}
    { {% if md.rows %}__nros_mode_rows{{ tag }}_{{ mi }}{% else %}nullptr{% endif %}, {{ md.rows | length }}u, {% if md.ages %}__nros_mode_ages{{ tag }}_{{ mi }}{% else %}nullptr{% endif %}, {{ md.ages | length }}u, {% if m.base_deadlines %}__nros_mode_deadlines{{ tag }}_{{ mi }}{% else %}nullptr{% endif %}, {{ md.deadlines | length }}u, {{ md.switch_budget_ms }}u, {% if md.reaction %}"{{ md.reaction | c_str }}"{% else %}nullptr{% endif %} },
{%- endfor %}
};
alignas(8) static unsigned char __nros_mode_storage{{ tag }}[({{ m.modes | length }} + 1) * (NROS_CPP_MODE_TABLE_STORAGE + {{ m.base_deadlines | length }} * NROS_CPP_MODE_DEADLINE_STORAGE) + {{ m.modes | length }} * ({{ m.rows | length }} * NROS_CPP_MODE_ROW_STORAGE + {{ m.ages | length }} * NROS_CPP_MODE_AGE_STORAGE)];
{%- endif %}
{%- endfor %}

{% if tiers -%}
{%- for setup in tiers.setups -%}
/* Phase 274.W2 — tier[{{ setup.index }}] ({{ setup.name }}) setup: creates only this tier's nodes. */
static int32_t __nros_entry_setup_tier_{{ setup.index }}(void* executor) {
    if (executor == nullptr) return static_cast<int32_t>(::rclcpp::ErrorCode::NotInitialized);
{%- if setup.monitors %}
{%- with m = setup.monitors, mexec = "executor" %}
{%- include "monitor_install_cpp.jinja" %}
{%- endwith %}
{%- endif %}
{%- for s in setup.nodes %}{% set n = nodes[s.node] %}
    {
{%- with dexec = "executor", at = s.on_executor, idx = s.node, tiered = true %}
{%- include "declare_calls.jinja" %}
{%- include "node_body_cpp.jinja" %}
{%- endwith %}
    }
{%- endfor %}
{%- if setup.emits_services %}
{%- with tiered = true %}
{%- include "service_trailer_cpp.jinja" %}
{%- endwith %}
{%- endif %}
    return 0;
}

{% endfor -%}
/* Phase 274.W2 — per-tier groups arrays + tier spec table.
 *
 * issue 1172 — a groups array is FLAT `(node name, node namespace, group)`
 * triples, and `n_groups` counts TRIPLES, not strings. The filter used to
 * match on the group id alone, so two nodes' `ctrl` were one key and a tier
 * naming one of them admitted both. An EMPTY array is the WILDCARD, so a tier
 * that names groups must never render an empty one. */
{%- for t in tiers.rows %}
{%- if t.groups %}
static const char* __nros_tier_{{ t.index }}_groups[] = {{ "{" }}{% for g in t.groups %}"{{ g[0] | c_str }}", "{{ g[1] | c_str }}", "{{ g[2] | c_str }}", {% endfor %}};
{%- endif %}
{%- endfor %}
static const ::rclcpp::board::NativeTierSpec __nros_tiers[{{ tiers.n }}] = {
{%- for t in tiers.rows %}
    {
        .name = "{{ t.name | c_str }}",
        .groups = {% if t.groups %}__nros_tier_{{ t.index }}_groups{% else %}nullptr{% endif %},
        .n_groups = {% if t.groups %}{{ t.groups | length }}u{% else %}0u{% endif %},
        .priority = {{ t.priority }}LL,
        .stack_bytes = {{ t.stack_bytes }}u,
        .spin_period_us = {{ t.spin_period_us }}ull,
        .setup = &__nros_entry_setup_tier_{{ t.index }},
        .core_plus1 = {{ t.core_plus1 }}u,
        .preempt_threshold = {{ t.preempt_threshold }}LL,
        .tier_class = {% if t.class %}"{{ t.class | c_str }}"{% else %}nullptr{% endif %},
        .period_us = {{ t.period_us }}ull,
        .budget_us = {{ t.budget_us }}ull,
        .deadline_us = {{ t.deadline_us }}ull,
        .deadline_policy = {% if t.deadline_policy %}"{{ t.deadline_policy | c_str }}"{% else %}nullptr{% endif %},
    },
{%- endfor %}
};

{% include "boot_config.jinja" %}
{% include "boot_wrapper_cpp.jinja" -%}
{%- else -%}
static int32_t __nros_entry_setup() {
{%- if sched %}
    /* Phase 269 (W4) — sched-context wiring (multi-tier scheduling). */
    uint8_t __nros_sc_ids[{{ sched.n }}] = {0};
    {
        void* __exec = ::rclcpp::global_handle();
        if (__exec == nullptr) return static_cast<int32_t>(::rclcpp::ErrorCode::NotInitialized);
{%- for c in sched.contexts %}
        {
            nros_cpp_ret_t __scr{{ c.index }} = nros_cpp_create_sched_context_from_policy(__exec, {% if c.class %}"{{ c.class | c_str }}"{% else %}nullptr{% endif %}, {{ c.period_us }}ull, {{ c.budget_us }}ull, {{ c.deadline_us }}ull, {% if c.deadline_policy %}"{{ c.deadline_policy | c_str }}"{% else %}nullptr{% endif %}, {{ c.os_pri }}u, &__nros_sc_ids[{{ c.index }}]);
            if (__scr{{ c.index }} != NROS_CPP_RET_OK) return static_cast<int32_t>(__scr{{ c.index }});
        }
{%- endfor %}
    }
    /* Phase 272 (W2) — seed node-name → sched-context table (RFC-0047). */
    {
        void* __exec = ::rclcpp::global_handle();
        if (__exec == nullptr) return static_cast<int32_t>(::rclcpp::ErrorCode::NotInitialized);
{#- A bind that does not fit is REFUSED by the runtime, never dropped (issue
    1172); ignoring the refusal here would drop it anyway, one level up. Each
    is checked like the context it names, and a failure aborts setup. #}
{%- for b in sched.node_binds %}
        {
            nros_cpp_ret_t __nbr{{ loop.index0 }} = nros_cpp_bind_node_name_sched(__exec, "{{ b.name | c_str }}", "{{ b.namespace | c_str }}", __nros_sc_ids[{{ b.sched_context }}]);
            if (__nbr{{ loop.index0 }} != NROS_CPP_RET_OK) return static_cast<int32_t>(__nbr{{ loop.index0 }});
        }
{%- endfor %}
    }
    /* Phase 273 (W2) — seed group → sched-context table (RFC-0047). */
    {
        void* __exec = ::rclcpp::global_handle();
        if (__exec == nullptr) return static_cast<int32_t>(::rclcpp::ErrorCode::NotInitialized);
{%- for b in sched.group_binds %}
        {
            nros_cpp_ret_t __gbr{{ loop.index0 }} = nros_cpp_bind_group_sched(__exec, "{{ b.name | c_str }}", "{{ b.namespace | c_str }}", "{{ b.group | c_str }}", __nros_sc_ids[{{ b.tier_index }}]);
            if (__gbr{{ loop.index0 }} != NROS_CPP_RET_OK) return static_cast<int32_t>(__gbr{{ loop.index0 }});
        }
{%- endfor %}
    }
{%- endif %}
{%- if monitors %}
{%- with m = monitors, mexec = "::rclcpp::global_handle()" %}
{%- include "monitor_install_cpp.jinja" %}
{%- endwith %}
{%- endif %}
{%- for n in nodes %}
    {
{%- with dexec = "::rclcpp::global_handle()", at = loop.index0, idx = loop.index0, tiered = false %}
{%- include "declare_calls.jinja" %}
{%- include "node_body_cpp.jinja" %}
{%- endwith %}
    }
{%- endfor %}
{%- with tiered = false %}
{%- include "service_trailer_cpp.jinja" %}
{%- endwith %}
    return 0;
}

{% if probe -%}
// phase-308 — metadata probe. Records what this component DECLARES;
// opens no transport and never spins.
extern "C" int nros_cpp_metadata_dump(const char*, const char*, const char*,
                                     const char*, const char*);
// Registering the recording backend EXPLICITLY, rather than relying on
// its `.init_array` ctor. A static archive only contributes objects
// that resolve an undefined symbol, so with no reference the linker
// never pulled the backend into the executable — it was present in
// libnros_cpp.a and absent from the binary, and `NROS_RMW=metadata`
// resolved to an unknown backend. This reference is what pulls it in.
extern "C" int nros_rmw_metadata_register(void);

int main(int /*argc*/, char** /*argv*/) {
    (void)nros_rmw_metadata_register();
    ::rclcpp::Result r = ::rclcpp::init_in(nullptr, 0, "nros_metadata_probe");
    if (!r.ok()) return 1;
    int32_t rc = __nros_entry_setup();
    if (rc != 0) return rc;
    return nros_cpp_metadata_dump("{{ probe.package | c_str }}", "{{ probe.component | c_str }}", "{{ probe.executable | c_str }}", "{{ probe.language | c_str }}", "{{ probe.out_path | c_str }}");
}
{% else -%}
{% include "boot_config.jinja" %}
{% include "boot_wrapper_cpp.jinja" -%}
{%- endif -%}
{%- endif -%}
