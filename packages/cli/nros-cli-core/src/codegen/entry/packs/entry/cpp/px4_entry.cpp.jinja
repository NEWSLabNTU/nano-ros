{#-
  phase-521 W8 (b), RFC-0113 D9 -- the PX4 entry: a PX4 module whose tiers
  are work items. The context is the C++ pack's `LoweredEntry` (the nodes,
  their seams, the boot config) plus `px4`: the module's `main` and one row
  per tier with the work queue its rank picked. See `px4.rs` for what is
  decided where; this template is layout only.

  Every tier's setup is rendered with `tiered = true` and the tier's own
  `executor`, including a plan with no tier table (one `default` tier): a PX4
  tier always runs its own executor, so there is no global-handle arm here.
-#}
{%- set c_pkgs = components | selectattr("kind", "eq", "c") | list %}
{%- set rust_pkgs = components | selectattr("kind", "eq", "rust") | list -%}
// Generated by `nros codegen entry --lang cpp` for a PX4 module (RFC-0113 D9)
//   bringup = {{ bringup }}
//   launch  = {{ launch }}
//   board   = {{ board }}
//   module  = {{ px4.main }}
//
// DO NOT EDIT — regenerated at configure time. One PX4 work item per tier,
// on the work queue the tier's rank picks; a tier's wait is its work item's
// schedule (`nros_px4/sched_task_work_item.hpp`), never a parked thread.

// nano-ros and the components first: PX4's `defines.h` defines `ERROR`.
#include <rclc/detail/boot_config.h>
#include <rclcpp/detail/component.hpp>
#include <rclcpp/rclcpp.hpp>
{%- if "rclcpp" in nodes | map(attribute="kind") | list %}
#include <new> // placement-new into the component arena slot
{%- endif %}

{% for h in headers %}#include "{{ h }}"
{% endfor %}
#include <nros_px4/sched_task_work_item.hpp>

#include <px4_platform_common/defines.h>
#include <px4_platform_common/log.h>
#include <px4_platform_common/module.h>

{% if c_pkgs %}
// C component factory + configure seam (RCLC_C_COMPONENT).
extern "C" {
{%- for c in c_pkgs %}
    void* __nros_c_component_{{ c.pkg | pkg_ident }}_create(void);
    int32_t __nros_c_component_{{ c.pkg | pkg_ident }}_configure(const ::nros_cpp_node_t* node, void* executor, void* self);
{%- endfor %}
}
{% endif %}
{% if rust_pkgs %}
// Rust component install seam (rclcpp::node!).
extern "C" {
{%- for c in rust_pkgs %}
    int32_t __nros_component_{{ c.pkg | pkg_ident }}_install(const void* node, void* executor, void* self);
{%- endfor %}
}
{% endif %}
// Static per-node storage (outlives the module; no heap).
{%- for s in nodes %}
{%- if s.kind != "rust" %}
{%- if s.kind == "rclcpp" %}
alignas(::{{ s.class }}) static unsigned char __nros_comp_buf_{{ loop.index0 }}[sizeof(::{{ s.class }})];
static ::{{ s.class }}* __nros_comp_{{ loop.index0 }} = nullptr;
{%- else %}
static ::rclcpp::Node __nros_node_{{ loop.index0 }};
{%- if s.class %}
static ::{{ s.class }} __nros_comp_{{ loop.index0 }};
{%- endif %}
{%- endif %}
{%- endif %}
{%- endfor %}
{%- include "monitor_statics_cpp.jinja" %}

{% for t in px4.tiers -%}
/* tier[{{ t.index }}] ({{ t.name }}) setup: creates only this tier's nodes, on its executor. */
static int32_t __nros_entry_setup_sched_task_{{ t.index }}_nodes(void* executor, const char** __nros_at) {
    if (executor == nullptr) return static_cast<int32_t>(::rclcpp::ErrorCode::NotInitialized);
{%- if t.monitors %}
{%- with m = t.monitors, mexec = "executor" %}
{%- include "monitor_install_cpp.jinja" %}
{%- endwith %}
{%- endif %}
{%- for ni in t.nodes %}{% set n = nodes[ni] %}
    {
        *__nros_at = "{{ n.name | c_str }}";
{%- with dexec = "executor", idx = ni, tiered = true %}
{%- include "declare_calls.jinja" %}
{%- include "node_body_cpp.jinja" %}
{%- endwith %}
    }
{%- endfor %}
{%- if t.emits_services %}
{%- with tiered = true %}
{%- include "service_trailer_cpp.jinja" %}
{%- endwith %}
{%- endif %}
    return 0;
}

static int32_t __nros_entry_setup_sched_task_{{ t.index }}(void* executor) {
    const char* __nros_at = nullptr;
    const int32_t rc = __nros_entry_setup_sched_task_{{ t.index }}_nodes(executor, &__nros_at);
    if (rc != 0) nros_cpp_report_setup_failure("{{ t.name | c_str }}", __nros_at, rc);
    return rc;
}

{% endfor -%}
/* The tier table, in open order: tier 0 opens the session, the rest borrow
 * it. Groups are FLAT `(node name, node namespace, group)` triples (issue
 * 1172); an empty array is the wildcard. */
{%- for t in px4.tiers %}
{%- if t.groups %}
static const char* __nros_sched_task_{{ t.index }}_groups[] = {{ "{" }}{% for g in t.groups %}"{{ g[0] | c_str }}", "{{ g[1] | c_str }}", "{{ g[2] | c_str }}", {% endfor %}};
{%- endif %}
{%- endfor %}
static const ::nros_px4::SchedTaskSpec __nros_sched_tasks[{{ px4.tiers | length }}] = {
{%- for t in px4.tiers %}
    {"{{ t.name | c_str }}", {% if t.groups %}__nros_sched_task_{{ t.index }}_groups{% else %}nullptr{% endif %}, {% if t.groups %}{{ t.groups | length }}u{% else %}0u{% endif %}, &__nros_entry_setup_sched_task_{{ t.index }}},
{%- endfor %}
};
{%- if px4.tiers | length > 1 %}

/* Each borrowed tier's executor storage, as a static the linker places. */
static ::nros_px4::SchedTaskStorage __nros_sched_task_storage[{{ (px4.tiers | length) - 1 }}];
{%- endif %}

{% include "boot_config.jinja" %}

/* One work item per tier, on the PX4 work queue its rank picks
 * (`nros_orchestration_ir::px4::px4_work_queues`, most urgent first). */
{%- for t in px4.tiers %}
class NrosSchedTask_{{ t.name | pkg_ident }} final : public ::nros_px4::SchedTaskWorkItem {
public:
    /* rank {{ t.rank }} */
    NrosSchedTask_{{ t.name | pkg_ident }}() : SchedTaskWorkItem("{{ px4.main }}_{{ t.name | pkg_ident }}", px4::wq_configurations::{{ t.queue }}) {}

protected:
    void on_image_stopped() override;
};
{%- endfor %}

class NrosPx4Entry : public ModuleBase<NrosPx4Entry> {
public:
    static int task_spawn(int argc, char* argv[]);
    static int custom_command(int argc, char* argv[]);
    static int print_usage(const char* reason = nullptr);

    int print_status() override;
    void request_stop() override;

    /* Open every tier in table order (setups never overlap, issue #144),
     * then start them. */
    int32_t start();

    /* The last tier to stop closes the executors, boot tier last. */
    void stopped();

    /* `ModuleBase::get_instance()` is protected; the tiers ask through this. */
    static NrosPx4Entry* instance() { return get_instance(); }

private:
    ::nros_px4::ImageState _image{};
{%- for t in px4.tiers %}
    NrosSchedTask_{{ t.name | pkg_ident }} _sched_task_{{ t.index }}{};
{%- endfor %}
};

int32_t NrosPx4Entry::start() {
    const char* sn = nros_boot_config_node_name(&NROS_BOOT_CONFIG);
    const char* ns = nros_boot_config_namespace(&NROS_BOOT_CONFIG);
{%- for t in px4.tiers %}
{%- if loop.first %}
    int32_t rc = _sched_task_{{ t.index }}.open(__nros_sched_tasks[{{ t.index }}], _image, nullptr, nullptr, sn, ns);
{%- else %}
    rc = _sched_task_{{ t.index }}.open(__nros_sched_tasks[{{ t.index }}], _image, &__nros_sched_task_storage[{{ t.index - 1 }}], _sched_task_0.session(), sn, ns);
{%- endif %}
    if (rc != 0) {
        PX4_ERR("nros tier `{{ t.name | c_str }}` failed to open (%d)", static_cast<int>(rc));
        return rc;
    }
{%- endfor %}
{%- for t in px4.tiers %}
    _sched_task_{{ t.index }}.start();
{%- endfor %}
    return 0;
}

void NrosPx4Entry::request_stop() {
    ModuleBase::request_stop();
    _image.stopping.store(true);
{%- for t in px4.tiers %}
    _sched_task_{{ t.index }}.wake_for_stop();
{%- endfor %}
}

void NrosPx4Entry::stopped() {
{%- for t in px4.tiers | reverse %}
    _sched_task_{{ t.index }}.close();
{%- endfor %}
    ::rclcpp::shutdown();
    exit_and_cleanup();
}
{%- for t in px4.tiers %}

void NrosSchedTask_{{ t.name | pkg_ident }}::on_image_stopped() {
    NrosPx4Entry* entry = NrosPx4Entry::instance();
    if (entry != nullptr) entry->stopped();
}
{%- endfor %}

int NrosPx4Entry::print_status() {
    PX4_INFO("{{ px4.tiers | length }} tier(s):{% for t in px4.tiers %} {{ t.name | c_str }}@{{ t.queue }}{% endfor %}");
{% for t in px4.tiers %}    PX4_INFO("tier {{ t.name | c_str }} runs=%u wake_max_us=%llu", static_cast<unsigned>(_sched_task_{{ t.index }}.runs()), static_cast<unsigned long long>(_sched_task_{{ t.index }}.wake_max_us()));
{% endfor %}    return 0;
}

int NrosPx4Entry::task_spawn(int /*argc*/, char* /*argv*/[]) {
    NrosPx4Entry* entry = new NrosPx4Entry();
    if (entry == nullptr) {
        PX4_ERR("alloc failed");
        return PX4_ERROR;
    }
    _object.store(entry);
    _task_id = task_id_is_work_queue;
    if (entry->start() != 0) {
        delete entry;
        _object.store(nullptr);
        _task_id = -1;
        return PX4_ERROR;
    }
    return PX4_OK;
}

int NrosPx4Entry::custom_command(int /*argc*/, char* /*argv*/[]) {
    return print_usage("unknown command");
}

int NrosPx4Entry::print_usage(const char* reason) {
    if (reason != nullptr) {
        PX4_WARN("%s\n", reason);
    }
    PRINT_MODULE_DESCRIPTION("nano-ros image `{{ bringup | c_str }}`: generated entry, one work item per tier.");
    PRINT_MODULE_USAGE_NAME("{{ px4.main }}", "nano-ros");
    PRINT_MODULE_USAGE_COMMAND("start");
    PRINT_MODULE_USAGE_DEFAULT_COMMANDS();
    return 0;
}

extern "C" __EXPORT int {{ px4.main }}_main(int argc, char* argv[]) {
    return NrosPx4Entry::main(argc, argv);
}
