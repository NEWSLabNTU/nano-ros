{#-
  The contract's file-scope statics: mode ids, monitor rows, hazards and mode
  tables (phase-462). ONE partial, included by the C++ entry and the PX4 entry
  (phase-521 W8 b), which install the same rows on their executors.
-#}
{%- if modes %}

/* phase-462 W4b -- the contract's operational modes. Pass an id to
 * nros_cpp_request_mode() to switch every executor's monitor tables at its
 * next spin; 0 is the base contract. */
{%- for md in modes %}
#define NROS_MODE_{{ md.ident }} {{ md.id }}u /* {{ md.name | c_str }} */
{%- endfor %}
{%- endif %}
{%- if monitor_table %}{% with m = monitor_table %}

/* phase-462 W1 (RFC-0052) -- contract monitor rows: one per contracted
 * publisher and per age contract, the same rows the Rust road bakes into
 * `system_monitors.rs`. The runtime builds its spec/cell tables in the storage
 * below at install (`nros_cpp_install_monitors`), so an image with no contract
 * carries none of this. */
{%- if m.rows %}
static const ::nros_cpp_monitor_row_t __nros_mon_rows[{{ m.rows | length }}] = {
{%- for r in m.rows %}
    { "{{ r.topic | c_str }}", "{{ r.fqn | c_str }}", {{ r.min_rate_hz_milli }}u, {{ r.max_latency_ms }}u, {% if r.route_trigger %}"{{ r.route_trigger | c_str }}"{% else %}nullptr{% endif %}, {{ r.route_max_latency_ms }}u{% if r.route_deadline_ms %}, {{ r.route_deadline_ms }}u, {{ r.reaction_id }}u, {{ r.mechanism }}u{% endif %} },
{%- endfor %}
};
alignas(8) static unsigned char __nros_mon_storage[{{ m.rows | length }} * NROS_CPP_MONITOR_ROW_STORAGE];
{%- if m.rows | selectattr("route_deadline_ms") | list %}
/* phase-503 -- supervised routes: a take still unanswered at its deadline is
 * reported (route-deadline-runtime) and nros_app_reaction_hook, when the
 * application defines it, is called with the row's reaction id:
{%- for r in m.rows %}{% if r.route_deadline_ms %}
 *   row {{ loop.index0 }} {{ r.fqn | c_str }}: deadline {{ r.route_deadline_ms }} ms, reaction {{ r.reaction_id }}{% if r.reaction %} ({{ r.reaction | c_str }}){% endif %}, mechanism {% if r.mechanism == 1 %}timer{% else %}executor{% endif %}
{%- endif %}{% endfor %}
 */
extern "C" void nros_app_reaction_hook(const ::nros_cpp_reaction_event_t* event, void* ctx) __attribute__((weak));
{%- endif %}
{%- endif %}
{%- if m.ages %}
static const ::nros_cpp_age_row_t __nros_age_rows[{{ m.ages | length }}] = {
{%- for r in m.ages %}
    { "{{ r.topic | c_str }}", "{{ r.fqn | c_str }}", {{ r.max_age_ms }}u, {{ r.deadline_ms }}u },
{%- endfor %}
};
alignas(8) static unsigned char __nros_age_storage[{{ m.ages | length }} * NROS_CPP_AGE_ROW_STORAGE];
{%- endif %}
{%- if m.hazards %}
/* phase-462 W3b -- the contract's hazards this executor observes over the rows
 * above: each guard member names an age (0) or rate (1) row, and the observer
 * reports hazard-detected / hazard-reaction / hazard-recovered on the same
 * drain (`nros_cpp_install_hazards`). */
{%- for h in m.hazards %}{% set hi = loop.index0 %}
{%- for g in h.monitors %}
static const ::nros_cpp_hazard_member_t __nros_hz_members_{{ hi }}_{{ loop.index0 }}[{{ g.members | length }}] = {
{%- for mm in g.members %}
    { {{ mm.kind }}u, {{ mm.row }}u },
{%- endfor %}
};
{%- endfor %}
static const ::nros_cpp_hazard_monitor_t __nros_hz_monitors_{{ hi }}[{{ h.monitors | length }}] = {
{%- for g in h.monitors %}
    { {% if g.all_of %}1{% else %}0{% endif %}u, __nros_hz_members_{{ hi }}_{{ loop.index0 }}, {{ g.members | length }}u },
{%- endfor %}
};
{%- if h.rungs %}
/* play_launch phase 96 W4.2 -- the hazard's ladder, top rung first: the mode
 * each rung is (65535 = none), the rate row of its output (65535 = none),
 * its route in ms (0 = not judged), its role (0 rung, 1 window, 2 floor) and
 * the guard members its route clock starts at. */
{%- for r in h.rungs %}{% if r.starts_at %}
static const ::nros_cpp_hazard_member_t __nros_hz_starts_{{ hi }}_{{ loop.index0 }}[{{ r.starts_at | length }}] = {
{%- for mm in r.starts_at %}
    { {{ mm.kind }}u, {{ mm.row }}u },
{%- endfor %}
};
{%- endif %}{% endfor %}
static const ::nros_cpp_hazard_rung_t __nros_hz_rungs_{{ hi }}[{{ h.rungs | length }}] = {
{%- for r in h.rungs %}
    { {{ r.mode }}u, {{ r.output_row }}u, {{ r.route_ms }}u, {{ r.role }}u, {% if r.starts_at %}__nros_hz_starts_{{ hi }}_{{ loop.index0 }}{% else %}nullptr{% endif %}, {{ r.starts_at | length }}u },
{%- endfor %}
};
{%- endif %}
{%- endfor %}
static const ::nros_cpp_hazard_row_t __nros_hz_rows[{{ m.hazards | length }}] = {
{%- for h in m.hazards %}
    { "{{ h.key | c_str }}", {{ h.ftti_ms }}u, {{ h.settle_ms }}u, __nros_hz_monitors_{{ loop.index0 }}, {{ h.monitors | length }}u, {{ h.sink }}u, {{ h.reaction_id }}u, {% if h.rungs %}__nros_hz_rungs_{{ loop.index0 }}{% else %}nullptr{% endif %}, {{ h.rungs | length }}u },
{%- endfor %}
};
{%- if m.hazards | selectattr("reaction_id") | list %}
/* phase-462 W3c -- a detected hazard whose reacting path states a safe_state
 * calls nros_app_reaction_hook, when the application defines it, with the
 * hazard's reaction id (rule_code hazard-detected, row = the hazard's index):
{%- for h in m.hazards %}{% if h.reaction_id %}
 *   hazard {{ loop.index0 }} {{ h.key | c_str }}: reaction {{ h.reaction_id }}
{%- endif %}{% endfor %}
 */
extern "C" void nros_app_reaction_hook(const ::nros_cpp_reaction_event_t* event, void* ctx) __attribute__((weak));
{%- endif %}
alignas(8) static unsigned char __nros_hz_storage[{{ m.hazards | length }} * NROS_CPP_HAZARD_ROW_STORAGE + {{ m.hazard_monitors }} * NROS_CPP_HAZARD_MONITOR_STORAGE + {{ m.hazard_members }} * NROS_CPP_HAZARD_MEMBER_STORAGE + {{ m.hazard_rungs }} * NROS_CPP_HAZARD_RUNG_STORAGE];
{%- endif %}
{%- if m.modes %}
/* phase-462 W4b -- the contract's modes: each mode's numbers for the rows
 * above, row for row (`nros_cpp_install_modes` copies the base specs and their
 * cells, so only the numbers are stated). A mode whose numbers are the
 * base's bakes no rows (NULL, 0): it judges by the base's table and costs
 * only its table header. */
{%- for md in m.modes %}{% set mi = loop.index %}
{%- if md.rows %}
static const ::nros_cpp_mode_row_t __nros_mode_rows_{{ mi }}[{{ md.rows | length }}] = {
{%- for r in md.rows %}
    { {{ r.min_rate_hz_milli }}u, {{ r.max_latency_ms }}u, {{ r.route_max_latency_ms }}u, {{ r.route_deadline_ms }}u },
{%- endfor %}
};
{%- endif %}
{%- if md.ages %}
static const ::nros_cpp_mode_age_row_t __nros_mode_ages_{{ mi }}[{{ md.ages | length }}] = {
{%- for a in md.ages %}
    { {{ a }}u },
{%- endfor %}
};
{%- endif %}
{%- endfor %}
{%- if m.base_deadlines %}
/* phase-462 W4c -- the sched-context deadlines the modes move on this
 * executor: table 0 the base's, table k mode k's, each naming the same
 * contexts{% if m.deadline_sc_is_sched_task %} by sched task index into __nros_sc_ids{% endif %}. */
static const ::nros_cpp_mode_deadline_t __nros_mode_deadlines_0[{{ m.base_deadlines | length }}] = {
{%- for d in m.base_deadlines %}
    { {{ d.sc }}u, {{ d.deadline_us }}u },
{%- endfor %}
};
{%- for md in m.modes %}{% set mi = loop.index %}
static const ::nros_cpp_mode_deadline_t __nros_mode_deadlines_{{ mi }}[{{ md.deadlines | length }}] = {
{%- for d in md.deadlines %}
    { {{ d.sc }}u, {{ d.deadline_us }}u },
{%- endfor %}
};
{%- endfor %}
{%- endif %}
static const ::nros_cpp_mode_t __nros_modes[{{ m.modes | length }}] = {
{%- for md in m.modes %}{% set mi = loop.index %}
    { {% if md.rows %}__nros_mode_rows_{{ mi }}{% else %}nullptr{% endif %}, {{ md.rows | length }}u, {% if md.ages %}__nros_mode_ages_{{ mi }}{% else %}nullptr{% endif %}, {{ md.ages | length }}u, {% if m.base_deadlines %}__nros_mode_deadlines_{{ mi }}{% else %}nullptr{% endif %}, {{ md.deadlines | length }}u, {{ md.switch_budget_ms }}u, {% if md.reaction %}"{{ md.reaction | c_str }}"{% else %}nullptr{% endif %} },
{%- endfor %}
};
alignas(8) static unsigned char __nros_mode_storage[({{ m.modes | length }} + 1) * (NROS_CPP_MODE_TABLE_STORAGE + {{ m.base_deadlines | length }} * NROS_CPP_MODE_DEADLINE_STORAGE) + {{ m.modes | selectattr("rows") | list | length }} * {{ m.rows | length }} * NROS_CPP_MODE_ROW_STORAGE + {{ m.modes | selectattr("ages") | list | length }} * {{ m.ages | length }} * NROS_CPP_MODE_AGE_STORAGE];
{%- endif %}
{%- endwith %}{%- endif %}