{#-
  One node's construction, inside the `{ }` its caller opened.

  A partial rather than two copies: the tiered setup functions and the single
  setup function differ ONLY in which executor expression they hand the node
  (`executor`, the tier's own, versus the process-global handle), and that
  difference is one `if` here instead of ~60 duplicated lines there. `n.decls`
  is written by the caller, because the two callers indent it identically but
  emit it before different things.

  `n.tiered` is what selects the expression. It is a fact about WHERE this
  body is being rendered, not about the node, which is why it rides on the
  node view the caller builds rather than being derived here.

  Issue 1443 — both `create_node` arities are passed `n.namespace` EXPLICITLY.
  Their third parameter defaults to `nullptr`, and `nros_cpp_node_create`
  substitutes `"/"` for a null, so omitting it created every launch node at the
  root however the Plan namespaced it. `n.namespace` is
  `entry::node_namespace`, the same derivation the C pack and the sched binds
  read, and it is never empty.

  Issue 1456 — the `rclcpp` arm has no `create_node` call to carry that, and
  1443's fix therefore reached it not at all: the component CONSTRUCTS its own
  node, so the only thing the entry hands it is the `NodeHandle`. The handle
  now carries the launch identity and `nros::Node`'s handle constructor
  prefers it over the class's own literal (see `node.hpp`, which states the
  precedence). `n.launch_name` / `n.launch_namespace` are `Option`s — the RAW
  plan values, NOT the resolved `n.name` / `n.namespace` beside them: a launch
  file that declares neither must leave the class's literal standing, and the
  resolved pair has no spelling for "the launch file said nothing" (`name`
  falls back to `exec`, `namespace` to `"/"`). Both halves are emitted on
  every render, `nullptr` where nothing was declared, so the generated text
  SAYS which of the two cases a node is in.
-#}
{%- if n.shape == "rust" %}
{%- if n.tiered %}
        int32_t crc = __nros_component_{{ n.pkg }}_install(nullptr, executor, nullptr);
        if (crc != 0) return crc;
{%- else %}
        void* __exec = ::nros::global_handle();
        if (__exec == nullptr) return static_cast<int32_t>(::nros::ErrorCode::NotInitialized);
        int32_t crc = __nros_component_{{ n.pkg }}_install(nullptr, __exec, nullptr);
        if (crc != 0) return crc;
{%- endif %}
{%- elif n.shape == "rclcpp" %}
        ::nros::NodeHandle __h({% if n.tiered %}executor{% else %}::nros::global_handle(){% endif %}, {% if n.launch_name %}"{{ n.launch_name | c_str }}"{% else %}nullptr{% endif %}, {% if n.launch_namespace %}"{{ n.launch_namespace | c_str }}"{% else %}nullptr{% endif %});
        if (!__h.valid()) return static_cast<int32_t>(::nros::ErrorCode::NotInitialized);
        __nros_comp_{{ n.index }} = new (__nros_comp_buf_{{ n.index }}) ::{{ n.class }}(__h);
        if (!__nros_comp_{{ n.index }}->ok()) {
            ::nros::detail::report_component_failure("{{ n.name | c_str }}", __nros_comp_{{ n.index }}->error_what(), __nros_comp_{{ n.index }}->error_code());
            return __nros_comp_{{ n.index }}->error_code();
        }
{%- else %}
{%- if n.tiered %}
        ::nros::Result r = ::nros::create_node_on(__nros_node_{{ n.index }}, executor, "{{ n.name | c_str }}", "{{ n.namespace | c_str }}");
{%- else %}
        ::nros::Result r = ::nros::create_node(__nros_node_{{ n.index }}, "{{ n.name | c_str }}", "{{ n.namespace | c_str }}");
{%- endif %}
        if (!r.ok()) return static_cast<int32_t>(r.raw());
{%- if n.qos %}
        static const ::nros_cpp_qos_override_t __nros_qos_{{ n.index }}[] = {
{%- for q in n.qos %}
            { "{{ q.topic | c_str }}", {{ q.role }}, {{ q.policy }}, {{ q.value }} },
{%- endfor %}
        };
        __nros_node_{{ n.index }}.set_qos_overrides(__nros_qos_{{ n.index }}, {{ n.qos | length }});
{%- endif %}
{%- if n.shape == "c" %}
        void* self = __nros_c_component_{{ n.pkg }}_create();
        int32_t crc = __nros_c_component_{{ n.pkg }}_configure(__nros_node_{{ n.index }}.ffi_handle(), __nros_node_{{ n.index }}.executor_handle(), self);
        if (crc != 0) return crc;
{%- else %}
        r = __nros_comp_{{ n.index }}.configure(__nros_node_{{ n.index }});
        if (!r.ok()) return static_cast<int32_t>(r.raw());
{%- endif %}
{%- endif -%}
