{#-
  The entry point, in the board's boot shape — the C twin of the C++ pack's
  `boot_wrapper.jinja`, and deliberately the same shape so the two can be read
  side by side.

  phase-432 W3.1. Before this, the C pack emitted `int main(int argc, char**
  argv)` and called `nros_board_native_*` unconditionally, because the C board
  surface WAS native-only and an embedded C entry was routed to the C++ pack.
  With a board that has its own C-ABI `run_components` the C pack renders for
  it directly, and the two things that were constants become the board's:
  which entry point the kernel calls, and which runner it calls.

  Three shapes, ONE derivation — `nros_entry_lower::BoardFamily::boot_shape`
  (phase-432 W2.2) — shared with the C++ pack rather than re-decided here.

  The host/embedded split in the CALL is the same one the C++ wrapper draws,
  and for the same reason: only the HOST board resolves its locator and domain
  at run time (from the environment), so it is the one runner that takes
  neither. An embedded image bakes both at compile time through
  `<rclc/detail/entry_config.h>`, the single ladder both entry languages include.

  The runner NAMES are carried rather than assembled from the board key: the C
  ABI does not name them uniformly (`native` has the `_named` suffix that its
  two-overload history left behind, the RTOS ones do not), so deriving them
  from a prefix here would be a second, guessing spelling of a fact
  `BoardFamily::c_abi_runners` in `nros-entry-lower` already holds exactly
  (issue 1285).

  Issue 1434 — the `run_components` call passes the launch-declared NAMESPACE
  beside the node name, both read out of the blob this entry already carries.
  Before that the namespace was baked and read by nothing: the blob stated it,
  `nros_boot_config_namespace()` could return it, and no call site asked.

  Issue 1442 — and so does the `run_tiers` call. That took the `_ns` twin of
  four more C-ABI symbols (native plus the three per-RTOS tier runners), which
  is why 1434 carved it out; the runner names come from
  `BoardFamily::c_abi_runners`, so this template does not name either spelling.
  The population it reaches is narrow — the blob only ever carries identity for
  a ONE-NODE plan (`boot_config_view`) and a tiered plan rarely is one — but
  narrow is not none, and a runner that drops the value is what a post-link
  patcher of `.nros_boot_config` silently patches into nothing.

  What travels is the SESSION's namespace. Each tier's own nodes carry their
  own `(node name, node namespace, group)` triples in the tier-spec array
  (issue 1172) and are unaffected either way.

  Issue 1551 — when the runner takes the tiers' executor storage
  (`boot.tier_storage`, i.e. `CAbiRunners::tiers_take_static_storage`), the
  wrapper emits it here as a file-scope static and passes it with its per-tier
  stride. The runner then allocates no executor from the platform heap.

  Issue 1568 — every RTOS board's runners take storage this way now, the
  single-executor `run_components` included (`boot.component_storage`, one
  block). One method, one flag (`CAbiRunners::takes_executor_storage`), one
  refusal (the linked library's `nros_cpp_executor_storage_check`). Issue 1597
  — and the host board too, so both host calls pass it as well.
-#}
{%- if boot.tier_storage -%}
/* Issues 1551 + 1568 — every tier's executor storage, one block per tier, as a
 * file-scope static the linker places and `mem-report` names. The runner used
 * to take each block out of the platform heap, and nothing multiplied the
 * storage by the tier count against it. The size is this build's own
 * NROS_CPP_EXECUTOR_STORAGE_SIZE, so the include is mandatory: without it there
 * is no honest size to write. The runner asks the linked library whether the
 * block is big enough and refuses it if not. */
#include <rclcpp/detail/nros_cpp_config_generated.h>
{% if boot.runners.run_levels -%}
/* phase-509 P9b (RFC-0108 "As built in P9b") — a level runner opens ONE
 * executor per core, so ONE block: every level works on it. */
static uint64_t __nros_tier_executor_storage[1][(NROS_CPP_EXECUTOR_STORAGE_SIZE + 7u) / 8u];
{%- else -%}
static uint64_t __nros_tier_executor_storage[{{ boot.n_tiers }}][(NROS_CPP_EXECUTOR_STORAGE_SIZE + 7u) / 8u];
{%- endif %}

{% if boot.task_memory -%}
/* Issue 1598 — each spawned tier's TASK memory (stack + control block), as
 * statics the linker places and prices: an image whose stacks do not fit RAM
 * fails at LINK, not at boot as a heap allocation failure. Sized from each
 * tier's `stack_bytes` (or the stated default) and raised to the port's floor
 * by the header's macro. The boot tier runs on the caller's task and has none. */
#include <{{ boot.task_memory.header }}>
{% for r in boot.task_memory.rows %}{% if r.spawned %}NROS_TIER_TASK_MEMORY_DEFINE({{ r.index }}, {% if r.derived %}NROS_LEVEL_STACK_BYTES({{ r.member_bytes }}u){% else %}{{ r.bytes }}u{% endif %});
{% endif %}{% endfor %}static const nros_tier_task_memory_t __nros_tier_task_memory[{{ boot.n_tiers }}] = {
{% for r in boot.task_memory.rows %}    {% if r.spawned %}NROS_TIER_TASK_MEMORY({{ r.index }}){% else %}NROS_TIER_TASK_MEMORY_NONE{% endif %},
{% endfor %}};

{% if boot.runners.run_tiers_backed and not boot.runners.run_levels -%}
/* Issue 1970 — each tier's OWN executor backing, when this build sizes its
 * executors per tier: the per-build header then publishes NROS_CPP_TIER_COUNT
 * and one NROS_CPP_TIER_BACKING_SIZE_<i> per tier (tier-table order), the
 * contexts above carry no inline backing, and the runner hands tier i's
 * executor `__nros_tier_backing_<i>`. A build that sizes no tier (or a tier
 * table other than this entry's) publishes no matching count, and the entry
 * keeps the whole-image executor per tier. The library refuses a backing short
 * of its tier's layout before that tier opens. */
#if defined(NROS_CPP_TIER_COUNT) && NROS_CPP_TIER_COUNT == {{ boot.n_tiers }}
#define NROS_ENTRY_TIERS_BACKED 1
{% for r in boot.task_memory.rows %}static uint64_t __nros_tier_backing_{{ r.index }}[NROS_CPP_TIER_BACKING_SIZE_{{ r.index }} / 8u];
{% endfor %}static const nros_tier_backing_t __nros_tier_backings[{{ boot.n_tiers }}] = {
{% for r in boot.task_memory.rows %}    {__nros_tier_backing_{{ r.index }}, sizeof(__nros_tier_backing_{{ r.index }})},
{% endfor %}};
#endif

{% endif -%}
{% endif -%}
{% if boot.runners.run_levels -%}
/* phase-509 P9 (RFC-0108) — this core's level scheduler: the session every
 * level shares and one seat per level, in a static the linker places and the
 * cost report (`mem-report --levels`) names. Each row of the table above is one
 * level; the runner spawns one worker per level over it. */
#define NROS_CPP_SCHEDULER_BACKING_SIZE_0 NROS_CPP_SCHEDULER_BACKING_SIZE({{ boot.n_tiers }}u)
static uint64_t __nros_scheduler_0[NROS_CPP_SCHEDULER_BACKING_SIZE_0 / 8u];
/* phase-509 P9b (RFC-0108 "As built in P9b") — the core's ONE executor
 * backing, when this build sizes its levels: every level's members, summed
 * (NROS_CPP_LEVELS_BACKING_SIZE), and the context above carries none inline.
 * A build that sizes no level keeps the whole-image executor inline. The
 * library refuses a backing short of the levels' layout before the session
 * opens. */
#if defined(NROS_CPP_LEVELS_BACKING_SIZE)
static uint64_t __nros_levels_backing[NROS_CPP_LEVELS_BACKING_SIZE / 8u];
static const nros_tier_backing_t __nros_level_backings[1] = {
    {__nros_levels_backing, sizeof(__nros_levels_backing)},
};
#define NROS_ENTRY_LEVEL_BACKINGS __nros_level_backings
#else
#define NROS_ENTRY_LEVEL_BACKINGS NULL
#endif

{% endif -%}
{% elif boot.component_storage -%}
/* Issue 1568 — the executor's storage, as a file-scope static the linker
 * places and `mem-report` names: the C twin of the C++ entry's
 * `Node::GlobalStorageHolder<0>::storage`. The runner used to take it out of
 * the platform heap at a size compiled from a fallback wherever the per-build
 * header was out of reach. The size is this build's own
 * NROS_CPP_EXECUTOR_STORAGE_SIZE, so the include is mandatory; the runner asks
 * the linked library whether it is big enough and refuses it if not. */
#include <rclcpp/detail/nros_cpp_config_generated.h>
static uint64_t __nros_executor_storage[(NROS_CPP_EXECUTOR_STORAGE_SIZE + 7u) / 8u];

{% endif -%}
{% include "launch_remap_table.jinja" -%}
{%- set call -%}
{%- if boot.tiers -%}
{%- if boot_shape == "host" -%}
{{ boot.runners.run_tiers }}(nros_boot_config_node_name(&NROS_BOOT_CONFIG), nros_boot_config_namespace(&NROS_BOOT_CONFIG), __nros_tiers, {{ boot.n_tiers }}u{% if boot.tier_storage %}, __nros_tier_executor_storage, sizeof(__nros_tier_executor_storage[0]){% endif %})
{%- else -%}
{{ boot.runners.run_tiers }}(NROS_ENTRY_LOCATOR, (uint8_t)NROS_ENTRY_DOMAIN_ID, nros_boot_config_node_name(&NROS_BOOT_CONFIG), nros_boot_config_namespace(&NROS_BOOT_CONFIG), __nros_tiers, {{ boot.n_tiers }}u{% if boot.tier_storage %}, __nros_tier_executor_storage, sizeof(__nros_tier_executor_storage[0]){% endif %}{% if boot.task_memory %}, __nros_tier_task_memory{% endif %})
{%- endif -%}
{%- elif boot_shape == "host" -%}
{{ boot.runners.run_components }}(nros_boot_config_node_name(&NROS_BOOT_CONFIG), nros_boot_config_namespace(&NROS_BOOT_CONFIG), &__nros_entry_setup{% if boot.component_storage %}, __nros_executor_storage, sizeof(__nros_executor_storage){% endif %})
{%- else -%}
{{ boot.runners.run_components }}(NROS_ENTRY_LOCATOR, (uint8_t)NROS_ENTRY_DOMAIN_ID, nros_boot_config_node_name(&NROS_BOOT_CONFIG), nros_boot_config_namespace(&NROS_BOOT_CONFIG), &__nros_entry_setup{% if boot.component_storage %}, __nros_executor_storage, sizeof(__nros_executor_storage){% endif %})
{%- endif -%}
{%- endset -%}
{%- set levels = boot.tiers and boot.tier_storage and boot.runners.run_levels -%}
{%- if levels -%}
{%- set call -%}
{{ boot.runners.run_levels }}({% if boot_shape != "host" %}NROS_ENTRY_LOCATOR, (uint8_t)NROS_ENTRY_DOMAIN_ID, {% endif %}nros_boot_config_node_name(&NROS_BOOT_CONFIG), nros_boot_config_namespace(&NROS_BOOT_CONFIG), __nros_tiers, {{ boot.n_tiers }}u, __nros_tier_executor_storage, sizeof(__nros_tier_executor_storage[0]), NROS_ENTRY_LEVEL_BACKINGS, {% if boot.task_memory %}__nros_tier_task_memory{% else %}NULL{% endif %}, __nros_scheduler_0, sizeof(__nros_scheduler_0))
{%- endset -%}
{%- endif -%}
{%- set backed = not levels and boot.tiers and boot.tier_storage and boot.task_memory and boot.runners.run_tiers_backed -%}
{%- set backed_call -%}
{{ boot.runners.run_tiers_backed }}(NROS_ENTRY_LOCATOR, (uint8_t)NROS_ENTRY_DOMAIN_ID, nros_boot_config_node_name(&NROS_BOOT_CONFIG), nros_boot_config_namespace(&NROS_BOOT_CONFIG), __nros_tiers, {{ boot.n_tiers }}u, __nros_tier_executor_storage, sizeof(__nros_tier_executor_storage[0]), __nros_tier_backings, __nros_tier_task_memory)
{%- endset -%}
{%- if boot_shape == "kernel" -%}
int main(void) {
{%- include "launch_remap_install.jinja" %}
{%- if backed %}
#if defined(NROS_ENTRY_TIERS_BACKED)
    return (int){{ backed_call }};
#else
    return (int){{ call }};
#endif
{%- else %}
    return (int){{ call }};
{%- endif %}
}
{% elif boot_shape == "app" -%}
int nros_app_main(int argc, char** argv) {
{%- include "launch_remap_install.jinja" %}
    (void)argc;
    (void)argv;
{%- if backed %}
#if defined(NROS_ENTRY_TIERS_BACKED)
    return {{ backed_call }};
#else
    return {{ call }};
#endif
{%- else %}
    return {{ call }};
{%- endif %}
}

NROS_APP_MAIN_REGISTER_VOID();
{% else -%}
int main(int argc, char** argv) {
{%- include "launch_remap_install.jinja" %}
    (void)argc;
    (void)argv;
    return {{ call }};
}
{% endif -%}
