{#-
  The entry point, in the board's boot shape.

  Three shapes, one derivation: `nros_entry_lower::BoardFamily::boot_shape`
  (phase-432 W2.2) answers which, and this template spells each in C++. The
  board CLASS is C++'s spelling of the family, through the `cpp_board_class`
  filter (phase-474 — it was `emit_cpp::board_cpp_path`).
  `static_cast<int>` belongs to the Zephyr/kernel shape alone — the other two
  return the board's `int32_t` directly.

  The board CALL is assembled here rather than handed over pre-rendered: it is
  three already-correct values (the board family, whether the plan runs tiers,
  how many) laid out, which is the line `render.rs` draws. Only the HOST board
  resolves its locator at run time, so it is the one `run_components` that
  takes no locator argument.

  Issue 1434 — the `run_components` call passes the launch-declared NAMESPACE
  beside the node name, both read out of the blob this entry already carries.
  Before that the namespace was baked and read by nothing. Issue 1442 — and so
  does `run_tiers`; the C pack's wrapper says what that cost. Here it is one
  more header overload per board class, so the call NAME does not move.

  Issue 1551 — when the runner takes the tiers' executor storage
  (`boot.tier_storage`, i.e. `CAbiRunners::tiers_take_static_storage`), the
  wrapper emits it here as a file-scope static and passes it with its per-tier
  stride. The runner then allocates no executor from the platform heap.

  Issue 1568 — every RTOS board's tier runner takes storage this way now
  (FreeRTOS and NuttX joined Zephyr). The single-executor `run_components`
  needs nothing here: `Board::run_components` already reaches the same `.bss`
  shape through `Node::GlobalStorageHolder<0>::storage`, and `nros::init` asks
  the linked library the same question the runners do.
-#}
{%- if boot.tier_storage -%}
/* Issues 1551 + 1568 — every tier's executor storage, one block per tier, as a
 * file-scope static the linker places and `mem-report` names. The runner used
 * to take each block out of the platform heap, and nothing multiplied the
 * storage by the tier count against it. The size is this build's own
 * NROS_CPP_EXECUTOR_STORAGE_SIZE, so the include is mandatory: without it there
 * is no honest size to write. The runner asks the linked library whether the
 * block is big enough and refuses it if not. */
#include <nros/nros_cpp_config_generated.h>
static uint64_t __nros_tier_executor_storage[{{ boot.n_tiers }}][(NROS_CPP_EXECUTOR_STORAGE_SIZE + 7u) / 8u];

{% if boot.task_memory -%}
/* Issue 1598 — each spawned tier's TASK memory (stack + control block), as
 * statics the linker places and prices: an image whose stacks do not fit RAM
 * fails at LINK, not at boot as a heap allocation failure. Sized from each
 * tier's `stack_bytes` (or the stated default) and raised to the port's floor
 * by the header's macro. The boot tier runs on the caller's task and has none. */
#include <{{ boot.task_memory.header }}>
{% for r in boot.task_memory.rows %}{% if r.spawned %}NROS_TIER_TASK_MEMORY_DEFINE({{ r.index }}, {{ r.bytes }}u);
{% endif %}{% endfor %}static const nros_tier_task_memory_t __nros_tier_task_memory[{{ boot.n_tiers }}] = {
{% for r in boot.task_memory.rows %}    {% if r.spawned %}NROS_TIER_TASK_MEMORY({{ r.index }}){% else %}NROS_TIER_TASK_MEMORY_NONE{% endif %},
{% endfor %}};

{% endif -%}
{% endif -%}
{%- set call -%}
{%- if boot.tiers -%}
{{ family | cpp_board_class }}::run_tiers(nros_boot_config_node_name(&NROS_BOOT_CONFIG), nros_boot_config_namespace(&NROS_BOOT_CONFIG), __nros_tiers, {{ boot.n_tiers }}u{% if boot.tier_storage %}, __nros_tier_executor_storage, sizeof(__nros_tier_executor_storage[0]){% endif %}{% if boot.task_memory %}, __nros_tier_task_memory{% endif %})
{%- elif boot_shape == "host" -%}
{{ family | cpp_board_class }}::run_components(nros_boot_config_node_name(&NROS_BOOT_CONFIG), nros_boot_config_namespace(&NROS_BOOT_CONFIG), &__nros_entry_setup)
{%- else -%}
{{ family | cpp_board_class }}::run_components(NROS_ENTRY_LOCATOR, nros_boot_config_node_name(&NROS_BOOT_CONFIG), nros_boot_config_namespace(&NROS_BOOT_CONFIG), &__nros_entry_setup)
{%- endif -%}
{%- endset -%}
{%- if boot_shape == "kernel" -%}
int main(void) {
    return static_cast<int>({{ call }});
}
{% elif boot_shape == "app" -%}
extern "C" int nros_app_main(int /*argc*/, char** /*argv*/) {
    return {{ call }};
}

NROS_APP_MAIN_REGISTER_VOID();
{% else -%}
int main(int /*argc*/, char** /*argv*/) {
    return {{ call }};
}
{% endif -%}
