# WHICH EMITTER IS THIS? (read before "fixing" a version or a dep here)
#
# There are TWO generated-manifest emitters and this is NOT the one production
# uses. `nros sync` / `nros generate-rust` write the on-disk Cargo.toml through
# `rosidl-bindgen::generate_cargo_toml`, which OVERWRITES whatever this template
# rendered. This template's output reaches a file only in
# `rosidl-codegen/tests/integration_test.rs`, which writes it and asserts the
# file exists — it never builds it.
#
# That duplication has already cost real time: RFC-0067 recorded "no codegen
# change is required for D2" because THIS file emits `version = "0.0.0"`, while
# the production emitter still wrote the ament version — the drift only surfaced
# when phase-333 W3 found 4.9.1 crates in the tree (fixed in c673faa40).
#
# So: message deps below are PATH deps (RFC-0067 D1), which needs no context
# because generated crates are siblings. The nros runtime crates keep a registry
# form here because this template has no way to know where the checkout is, and
# its output never resolves anyway; the production emitter path-deps them
# (RFC-0067 Q1). Do not treat the two as interchangeable — change both or
# neither.

[package]
name = "{{ package_name }}"
# Issue 0378 — CONSTANT, deliberately not the ament package version.
#
# These crates are generated per host by `nros sync` from whatever the
# consumer's ament environment provides; they are never published. Cargo
# records every resolved package in `Cargo.lock` INCLUDING path/patched ones,
# so an ament-derived version here is baked into a committed lockfile — i.e. a
# reproducibility artifact ends up asserting which ROS install produced it, and
# every other install reads as drift.
#
# Nothing depends on the number: all 113 in-tree message dependencies are
# declared `version = "*"`, so it carries no resolution meaning and normalizing
# it is free.
#
# The real ament version is still recorded, below, where "what produced this"
# belongs.
version = "0.0.0"
edition = "2021"
license = "Apache-2.0"

[package.metadata.nros]
# The ament package version this crate was generated from. Metadata, not
# identity: cargo ignores it, so it never reaches Cargo.lock.
ament_version = "{{ package_version }}"

[features]
default = ["std"]
std = ["nros-core/std", "nros-serdes/std"]
alloc = ["nros-core/alloc", "nros-serdes/alloc"]

[dependencies]
nros-core = { version = "0.1", default-features = false }
nros-serdes = { version = "0.1", default-features = false }
heapless = "0.8"
{%- if has_actions %}
# issue #234 — `RosAction::register_protocol_types` registers the fixed
# `action_msgs` protocol types (CancelGoal_{Request,Response}, GoalStatusArray)
# that the cancel service + status publisher serialize, through the generic
# `nros_rmw::register_type_descriptor` seam. That seam is a no-op unless a
# descriptor-needing backend (Cyclone DDS) installs a registrar, so no cfg
# gate and no named-backend dependency are needed (issue #60): the 8 action
# envelopes already register the same way via `register_type::<M>()` in
# nros-node. Replaces the pre-#234 `rmw-cyclonedds`-feature-gated
# `nros_rmw_cyclonedds::register::<M>()` path, which was inert whenever the
# consumer did not also turn on this crate's `rmw-cyclonedds` feature
# (the standard example build never did) → `ActionCreationFailed`.
nros-rmw = { version = "*", default-features = false }
{%- endif %}
{%- for dep in dependencies %}
{{ dep }} = { path = "../{{ dep }}", default-features = false }
{%- endfor %}
