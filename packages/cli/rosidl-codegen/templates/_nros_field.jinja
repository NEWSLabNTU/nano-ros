{#-
  Issue 0344 — the ONE deserialize arm shared by every Rust payload emitter.

  Why this file exists: message_nros.rs.jinja implemented RFC-0033 `heap` (and
  the `borrowed` view), while service_nros.rs.jinja and action_nros.rs.jinja
  carried hand-copied owned-only clones of the same arm. The storage mode was
  resolved for all three (srv.rs/action.rs call field_to_nros_field_with_mode
  exactly like msg.rs), so a heap-configured .srv field got the heap TYPE with an
  owned serde body — code that does not compile (issue 0343).

  Only DESERIALIZE needs the mode: serialization is already container-agnostic
  (`.as_str()`, `.len()`, `&self.field` iteration work for heapless and heap
  alike), and the struct field type comes from the field builder. So this single
  macro is the whole shared surface.

  Keep it byte-identical in output to what the message template emitted before —
  every committed generated file depends on that.
-#}
{%- macro deser_field(field, inline_mode) -%}
{%- if field.is_primitive %}
            {{ field.name }}: reader.read_{{ field.primitive_method }}()?,
{%- else if field.is_string %}
            {{ field.name }}: {
                let s = reader.read_string()?;
{%- if field.is_heap %}
                nros_core::heap::String::from(s)
{%- else if inline_mode %}
                nros_core::heapless::String::try_from(s).map_err(|_| DeserError::CapacityExceeded)?
{%- else %}
                heapless::String::try_from(s).map_err(|_| DeserError::CapacityExceeded)?
{%- endif %}
            },
{%- else if field.is_array %}
            {{ field.name }}: {
{%- if field.is_large_array %}
                let mut arr: {{ field.rust_type }} = [Default::default(); {{ field.array_size }}];
{%- else %}
                let mut arr: {{ field.rust_type }} = Default::default();
{%- endif %}
                for i in 0..{{ field.array_size }} {
{%- if field.is_primitive_element %}
                    arr[i] = reader.read_{{ field.element_primitive_method }}()?;
{%- else if field.is_string_element %}
                    let s = reader.read_string()?;
{%- if inline_mode %}
                    arr[i] = nros_core::heapless::String::try_from(s).map_err(|_| DeserError::CapacityExceeded)?;
{%- else %}
                    arr[i] = heapless::String::try_from(s).map_err(|_| DeserError::CapacityExceeded)?;
{%- endif %}
{%- else %}
                    arr[i] = Deserialize::deserialize(reader)?;
{%- endif %}
                }
                arr
            },
{%- else if field.is_sequence %}
            {{ field.name }}: {
                let len = reader.read_u32()? as usize;
{%- if field.is_heap %}
                let mut vec = nros_core::heap::Vec::new();
{%- else if inline_mode %}
                let mut vec = nros_core::heapless::Vec::new();
{%- else %}
                let mut vec = heapless::Vec::new();
{%- endif %}
                for _ in 0..len {
{%- if field.is_primitive_element %}
{%- if field.is_heap %}
                    vec.push(reader.read_{{ field.element_primitive_method }}()?);
{%- else %}
                    vec.push(reader.read_{{ field.element_primitive_method }}()?).map_err(|_| DeserError::CapacityExceeded)?;
{%- endif %}
{%- else if field.is_string_element %}
                    let s = reader.read_string()?;
{%- if inline_mode %}
                    let elem = nros_core::heapless::String::try_from(s).map_err(|_| DeserError::CapacityExceeded)?;
{%- else %}
                    let elem = heapless::String::try_from(s).map_err(|_| DeserError::CapacityExceeded)?;
{%- endif %}
{%- if field.is_heap %}
                    vec.push(elem);
{%- else %}
                    vec.push(elem).map_err(|_| DeserError::CapacityExceeded)?;
{%- endif %}
{%- else %}
{%- if field.is_heap %}
                    vec.push(Deserialize::deserialize(reader)?);
{%- else %}
                    vec.push(Deserialize::deserialize(reader)?).map_err(|_| DeserError::CapacityExceeded)?;
{%- endif %}
{%- endif %}
                }
                vec
            },
{%- else %}
            {{ field.name }}: Deserialize::deserialize(reader)?,
{%- endif %}
{%- endmacro -%}
