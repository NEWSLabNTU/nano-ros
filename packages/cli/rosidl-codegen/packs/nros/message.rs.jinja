impl Serialize for {{ message_name }} {
{%- if has_fields %}
    fn serialize(&self, writer: &mut CdrWriter) -> Result<(), SerError> {
        // phase-303 W4 (#0267) — DHEADER wrap for XCDR2 appendable structs.
        // No-op under XCDR1 (byte-identical); under XCDR2 delimits this struct.
        let __dh = writer.begin_dheader()?;
{%- for field in fields %}
{%- if field.is_primitive %}
        writer.write_{{ field.primitive_method }}(self.{{ field.name }})?;
{%- elif field.is_string %}
        writer.write_string(self.{{ field.name }}.as_str())?;
{%- elif field.is_array %}
        for item in &self.{{ field.name }} {
{%- if field.is_primitive_element %}
            writer.write_{{ field.element_primitive_method }}(*item)?;
{%- elif field.is_string_element %}
            writer.write_string(item.as_str())?;
{%- else %}
            item.serialize(writer)?;
{%- endif %}
        }
{%- elif field.is_sequence %}
        writer.write_u32(self.{{ field.name }}.len() as u32)?;
        for item in &self.{{ field.name }} {
{%- if field.is_primitive_element %}
            writer.write_{{ field.element_primitive_method }}(*item)?;
{%- elif field.is_string_element %}
            writer.write_string(item.as_str())?;
{%- else %}
            item.serialize(writer)?;
{%- endif %}
        }
{%- else %}
        self.{{ field.name }}.serialize(writer)?;
{%- endif %}
{%- endfor %}
        writer.end_dheader(__dh)?;
        Ok(())
    }
{%- else %}
    // Empty message — under XCDR2 an appendable struct still carries a DHEADER
    // (size 0); under XCDR1 this is a no-op (byte-identical: nothing written).
    fn serialize(&self, writer: &mut CdrWriter) -> Result<(), SerError> {
        let __dh = writer.begin_dheader()?;
        writer.end_dheader(__dh)?;
        Ok(())
    }
{%- endif %}
}

