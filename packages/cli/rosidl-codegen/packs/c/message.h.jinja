{%- import "_field.jinja" as c -%}
// nros-c message type - C header for embedded systems
// Package: {{ package_name }}
// Message: {{ message_name }}
// Auto-generated by rosidl-codegen - do not edit

#ifndef {{ guard_name }}
#define {{ guard_name }}

#include <stdint.h>
#include <stdbool.h>
#include <stddef.h>

#include <nros/types.h>
{%- if has_borrowed %}
#include <nros/view.h>
{%- endif %}

#ifdef __cplusplus
extern "C" {
#endif

{%- for inc in type_includes %}
#include "{{ inc }}"
{%- endfor %}

// Constants
{%- for constant in constants %}
#define {{ constant_prefix }}_{{ constant.name }} {{ constant.value }}
{%- endfor %}

/// {{ message_name }} message structure
typedef struct {{ struct_name }} {
{%- for field in fields %}
    {{ field | c_type }} {{ field.name }}{{ field | c_array_suffix }};
{%- endfor %}
{%- if not has_fields %}
    uint8_t _dummy; // Empty struct placeholder
{%- endif %}
} {{ struct_name }};
{%- if has_borrowed %}

/// Borrowed (zero-copy) view of {{ message_name }} — RFC-0033 `borrowed` mode.
/// `mode = "borrowed"` fields point directly into the CDR receive buffer (set
/// by {{ struct_name }}_deserialize_view); all other fields are copied as in
/// the owned struct. The borrowed pointers are valid ONLY while the source
/// buffer lives (e.g. the subscription callback) — copy out anything retained.
typedef struct {{ struct_name }}_View {
{%- for field in fields %}
{{- c.view_field_decl(field) }}
{%- endfor %}
} {{ struct_name }}_View;
{%- endif %}

/// Get the ROS type name for {{ message_name }}
static inline const char* {{ struct_name }}_get_type_name(void) {
    return "{{ package_name }}::msg::dds_::{{ message_name }}_";
}

/// Get the type hash for {{ message_name }}
static inline const char* {{ struct_name }}_get_type_hash(void) {
    return "{{ type_hash }}";
}

/// Initialize a {{ message_name }} message to default values
void {{ struct_name }}_init({{ struct_name }}* msg);

/// Release heap-backed (`mode = "heap"`, RFC-0033) fields and re-zero them.
/// Safe on a zero-initialized or already-fini'd message; a no-op when the
/// message has no heap fields. Call after deserializing a message with heap
/// sequences to avoid leaking the malloc'd element buffers.
void {{ struct_name }}_fini({{ struct_name }}* msg);

/// Serialize a {{ message_name }} message to CDR format (writes a fresh
/// 4-byte CDR encapsulation header followed by the fields).
/// Returns 0 on success, -1 on error. On success, *serialized_size contains
/// bytes written.
int32_t {{ struct_name }}_serialize(const {{ struct_name }}* msg, uint8_t* buffer, size_t buffer_size, size_t* serialized_size);

/// Deserialize a {{ message_name }} message from CDR format (expects a
/// 4-byte CDR encapsulation header followed by the fields).
/// Returns 0 on success, -1 on error
int32_t {{ struct_name }}_deserialize({{ struct_name }}* msg, const uint8_t* buffer, size_t buffer_size);
{%- if has_borrowed %}

/// Deserialize a {{ message_name }} into a borrowed view (RFC-0033 `borrowed`):
/// `mode = "borrowed"` fields are set to point into `buffer` (zero-copy, no
/// allocation); other fields are copied. `out` is fully overwritten. The
/// borrowed pointers alias `buffer` and are valid only while it lives.
/// Returns 0 on success, -1 on error.
int32_t {{ struct_name }}_deserialize_view({{ struct_name }}_View* out, const uint8_t* buffer, size_t buffer_size);
{%- endif %}

/// Serialize a {{ message_name }} inline into an already-open CDR stream,
/// without emitting its own encapsulation header. Used by parent messages,
/// services, and actions that embed this type as a nested field.
/// - ptr_ref: in/out current write pointer (advanced on success)
/// - end: one-past-last byte of the destination buffer
/// - origin: CDR alignment origin (start of the surrounding encapsulation)
/// Returns 0 on success, -1 on error.
int32_t {{ struct_name }}_serialize_inline(const {{ struct_name }}* msg, uint8_t** ptr_ref, const uint8_t* end, const uint8_t* origin);

/// Deserialize a {{ message_name }} inline from an already-open CDR stream,
/// without consuming an encapsulation header. Parameters mirror the inline
/// serialize variant.
int32_t {{ struct_name }}_deserialize_inline({{ struct_name }}* msg, const uint8_t** ptr_ref, const uint8_t* end, const uint8_t* origin);

/// Get the nros_message_type_t for this message type
const nros_message_type_t* {{ struct_name }}_get_type_support(void);

{% if tx_max_serialized_size %}
/// Largest CDR payload this type can produce, encapsulation header included.
///
/// Computed by `nros_serdes::size::max_serialized_size` over this type's own
/// schema -- THE size rule, not a copy of it -- so it cannot disagree with the
/// Rust `MAX_SERIALIZED_SIZE_XCDR*` const for the same type (issue 0896).
///
/// Two constants because the encodings differ: XCDR2 adds a 4-byte DHEADER and
/// aligns 8-byte primitives to 4 instead of 8. This stack WRITES XCDR1, so the
/// publish helper below uses that one; a RECEIVE buffer must hold either, so a
/// subscription wants the larger.
#define {{ constant_prefix }}_TX_MAX_SERIALIZED_SIZE {{ tx_max_serialized_size }}
#define {{ constant_prefix }}_RX_MAX_SERIALIZED_SIZE {{ rx_max_serialized_size }}
{% else %}
/// NO size bound is emitted for this type.
///
/// Reason: {{ unbounded_reason }}
///
/// "unbounded member" means the bound was computed and does not exist -- bound
/// the field in the `.msg` (`string<=64`) or give it a `cap` in
/// `nros-codegen.toml`. "could not be resolved" means the bound was NOT
/// computed, because a nested type was not reachable; that is a search-path
/// problem, not a property of the message. Issue 0896.

/* issue 0896 layer 5 -- naming the size constant of an unbounded type is a
   deliberate error, and this makes the compiler SAY SO. Without it the
   constant is simply absent and the user gets "undeclared identifier", which
   names neither the type nor the member that costs it the bound. */
#define {{ constant_prefix }}_TX_MAX_SERIALIZED_SIZE \
    {{ unbounded_token }}
#define {{ constant_prefix }}_RX_MAX_SERIALIZED_SIZE \
    {{ unbounded_token }}
{% endif %}

/// Typed publish helper. Serializes `msg` into a stack buffer sized from the
/// type's own bound where one exists, and from `NROS_PUB_BUFFER_SIZE`
/// otherwise. nros_ret_t / nros_publisher_t / nros_publish_raw all come in via
/// <nros/types.h> (already included at the top of this header).
#ifndef NROS_PUB_BUFFER_SIZE
#define NROS_PUB_BUFFER_SIZE 256
#endif
static inline nros_ret_t {{ struct_name }}_publish(struct nros_publisher_t* publisher,
                                                   const {{ struct_name }}* msg) {
{% if tx_max_serialized_size %}
    /* Exactly what this type can produce -- no guess, and no 256-byte cliff
       for a type that needs more. */
    uint8_t buf[{{ constant_prefix }}_TX_MAX_SERIALIZED_SIZE];
{% else %}
    /* No bound for this type ({{ unbounded_reason }}), so the global knob is
       still the only available answer. */
    uint8_t buf[NROS_PUB_BUFFER_SIZE];
{% endif %}
    size_t n = 0;
    int32_t r = {{ struct_name }}_serialize(msg, buf, sizeof(buf), &n);
    if (r != 0) return r;
    return nros_publish_raw(publisher, buf, n);
}

/// Typed subscribe helper -- the sibling of {{ struct_name }}_publish above.
///
/// A MACRO, not a function, deliberately. It expands at the CALL SITE, where
/// <nros/component.h> is already included, so this header keeps its single
/// include of <nros/types.h> and takes no dependency on the component ABI.
/// nros_cpp_subscription_register, nros_cpp_node_t, nros_c_qos_default and
/// nros_c_subscription_callback_t all come from component.h and none of them is
/// named until the macro is actually used.
///
/// ONE token names the type. The ROS type name, the type hash and the
/// receive-buffer size hint are all derived from it, so they cannot disagree.
/// The hand-written raw register this replaces named the type TWICE -- once for
/// _get_type_name() and once for the buffer hint -- with nothing checking the
/// two agreed (issue 0896).
///
/// The `_subscribe_sized` form is the same call with the hint chosen by the
/// caller: for a type with no receive bound, and for anyone deliberately
/// overriding the type's own number. `rx_bytes` is a HINT (0 = image default),
/// never a promise that larger samples are refused.
///
/// C ONLY. The options struct is passed as a compound literal, and C++ cannot
/// take the address of one ("taking address of rvalue"), so the C++ arm below
/// names a C++ answer instead of leaving that diagnostic to be decoded. C++
/// callers have a typed subscription already -- nros::Subscription<M> over the
/// generated .hpp -- and it carries no hint yet; that is the C++ sibling of
/// this work, not something this macro can supply.
#define {{ struct_name }}_subscribe_sized(node, topic, cb, ctx, out_handle, rx_bytes) \
    nros_cpp_subscription_register_hinted( \
        (node), (topic), {{ struct_name }}_get_type_name(), {{ struct_name }}_get_type_hash(), \
        nros_c_qos_default(), (cb), (ctx), (out_handle), (uint32_t)(rx_bytes))
{% if rx_max_serialized_size %}
/// Subscribe with the receive-buffer hint this type computes for itself --
/// max(XCDR1, XCDR2), because a non-default peer may negotiate either.
#define {{ struct_name }}_subscribe(node, topic, cb, ctx, out_handle) \
    {{ struct_name }}_subscribe_sized( \
        (node), (topic), (cb), (ctx), (out_handle), \
        {{ constant_prefix }}_RX_MAX_SERIALIZED_SIZE)
{% else %}
/* issue 0896 layer 5 -- this type has NO receive bound
   ({{ unbounded_reason }}), so there is no number a plain `_subscribe` could
   pass, and sizing the buffer is a decision only the caller can make. The macro
   is emitted anyway, POISONED, so the diagnostic names the type and the member
   that costs it the bound instead of reporting an undeclared function.
   Either remove the cause -- see the reason block above, which says whether the
   bound is ABSENT (bound the field) or merely UNCOMPUTED (fix the search path)
   -- or call the `_subscribe_sized` form above with a byte count you chose. */
#define {{ struct_name }}_subscribe(node, topic, cb, ctx, out_handle) \
    {{ unbounded_token }}
{% endif %}
#ifdef __cplusplus
}
#endif

#endif // {{ guard_name }}
