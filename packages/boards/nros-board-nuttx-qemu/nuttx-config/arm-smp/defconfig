#
# nano-ros fragment over NuttX's `qemu-armv7a:smp` (phase-550 W10, RFC-0126 decision 17).
#
# NuttX's own configure (`tools/configure.sh`) expands the `#include` below
# with `tools/process_config.sh`; a later line wins over the included one.
# What follows says only how this board differs from upstream's config: the
# resolved `.config` is byte-identical to the full defconfig this replaced.
#
# The SMP twin of the arm fragment: the same additions over upstream's SMP config.

#include "boards/arm/qemu/qemu-armv7a/configs/smp/defconfig"

# Restated, though upstream says the same: nano-ros reads these from this
# file rather than from the resolved .config. The kernel build keys its
# export on the arch, the make road finds the board's Make.defs from
# arch/chip/board, and the board crate takes its network from NETINIT_*.
CONFIG_ARCH="arm"
CONFIG_ARCH_CHIP="qemu"
CONFIG_ARCH_BOARD="qemu-armv7a"

# CONFIG_OPENAMP is not set

# --- UART (PL011 serial console) ---
CONFIG_SMP_NCPUS=2

# --- Toolchain ---
CONFIG_ARM_TOOLCHAIN_GNU_EABI=y

# --- Apps directory (relative to NUTTX_DIR, matches just setup-nuttx layout) ---
CONFIG_APPS_DIR="../nuttx-apps"

# --- Build options ---
CONFIG_SIG_DEFAULT=y

# --- Scheduling ---
CONFIG_DEFAULT_TASK_STACKSIZE=8192
CONFIG_SCHED_LPWORK=y
CONFIG_SCHED_LPNTHREADS=2
CONFIG_SCHED_WAITPID=y

# --- Timers ---
CONFIG_ONESHOT=y

# --- 64-bit time_t (required: Rust libc crate assumes time_t = i64) ---
CONFIG_SYSTEM_TIME64=y

# --- I/O buffers (required by virtio-net for packet buffers) ---
CONFIG_IOB_ALIGNMENT=16
CONFIG_IOB_BUFSIZE=1534
CONFIG_IOB_NBUFFERS=64
CONFIG_IOB_THROTTLE=8

# --- Networking (BSD sockets, TCP/UDP) ---
CONFIG_NET=y
CONFIG_NET_TCP=y
CONFIG_NET_TCP_NODELAY=y
CONFIG_NET_TCPBACKLOG=y
CONFIG_NET_UDP=y
CONFIG_NET_BROADCAST=y

# Phase 97.4.nuttx — RTPS SPDP multicast (239.255.0.1:7400+).
CONFIG_NET_IGMP=y
CONFIG_NET_IGMPv2=y
CONFIG_NET_ICMP_SOCKET=y
CONFIG_NET_SOCKOPTS=y
CONFIG_NET_ETH_PKTSIZE=1514
CONFIG_NET_LL_GUARDSIZE=32
CONFIG_NET_RECV_BUFSIZE=32768
CONFIG_NET_MAX_LISTENPORTS=8
CONFIG_NET_STATISTICS=y
CONFIG_NET_ROUTE=y
CONFIG_NETDEV_WORK_THREAD=y
CONFIG_NETDEV_WORK_THREAD_POLLING_PERIOD=10000
CONFIG_NETDEV_IFINDEX=y

# --- Network initialization (QEMU slirp subnet: 10.0.2.0/24) ---
CONFIG_NETUTILS_NETINIT=y
CONFIG_NSH_NETINIT=y
CONFIG_NETINIT_IPADDR=0x0a00020f
CONFIG_NETINIT_DRIPADDR=0x0a000202
CONFIG_NETINIT_NETMASK=0xffffff00
# CONFIG_NETINIT_NOMAC is not set

# Phase 127.B.5 — virtio-net derives its MAC from the QEMU
# `-device virtio-net-device,mac=…` argument via VIRTIO_NET_F_MAC, so
# the per-instance MAC chosen by the test harness propagates correctly.
# With NETINIT_NOMAC=y the netinit stage overwrites that with
# CONFIG_NETINIT_MACADDR_{1,2} defaults (`00:e0:de:ad:be:ef`), giving
# every NuttX QEMU instance the same MAC — QEMU's `-netdev socket,mcast=`
# tunnel then filters out frames whose source MAC matches our own,
# silently dropping every peer's RTPS SPDP/data.
# --- Virtio drivers (virtio-net for QEMU networking) ---
CONFIG_DRIVERS_VIRTIO=y
CONFIG_DRIVERS_VIRTIO_MMIO=y
CONFIG_DRIVERS_VIRTIO_NET=y
CONFIG_DEV_SIMPLE_ADDRENV=y
CONFIG_NET_LL_GUARDSIZE=28

# --- Device tree (virtio device discovery) ---
CONFIG_DEVICE_TREE=y

# --- POSIX threading (required by zenoh-pico + Rust std TLS) ---
# Issue 1907: nano-ros mutexes inherit priority. With this set, the
# pthread mutex protocol defaults to PTHREAD_PRIO_INHERIT, and
# nros-platform-posix refuses to build without it. Counting semaphores
# stay SEM_PRIO_NONE, so signalling semaphores are unaffected.
CONFIG_PRIORITY_INHERITANCE=y
CONFIG_PTHREAD_MUTEX_TYPES=y
CONFIG_PTHREAD_MUTEX_BOTH=y
CONFIG_PTHREAD_STACK_DEFAULT=65536
CONFIG_TLS_NELEM=64

# --- Random device (required by zenoh-pico RNG) ---
CONFIG_DEV_URANDOM=y
CONFIG_CRYPTO=y
CONFIG_CRYPTO_RANDOM_POOL=y

# --- Filesystem ---
CONFIG_DEV_ZERO=y
CONFIG_PIPES=y

# --- DNS / network database (for getaddrinfo) ---
CONFIG_LIBC_NETDB=y

# --- NSH shell (interactive debugging) ---
CONFIG_INIT_ENTRYPOINT="nros_nuttx_entry"
CONFIG_INIT_STACKSIZE=524288
CONFIG_SYSTEM_PING=y
CONFIG_NETUTILS_NETCAT=y
CONFIG_NETUTILS_WEBCLIENT=y

# --- Misc ---
CONFIG_STACK_USAGE_WARNING=0

# phase-296 W5.9 - POSIX sporadic server: the budget dim's kernel-native
# realization (nros_nuttx_apply_current_sporadic; RFC-0052).
CONFIG_SCHED_SPORADIC=y
CONFIG_SCHED_SPORADIC_MAXREPL=3

# --- Upstream sets these; this board resolves them as below ---
# CONFIG_ARM_PSCI is not set
# CONFIG_DEBUG_ASSERTIONS is not set
# CONFIG_DEBUG_FEATURES is not set
# CONFIG_EXAMPLES_HELLO is not set
# CONFIG_MM_KASAN is not set
# CONFIG_MM_KASAN_GLOBAL is not set
# CONFIG_SYSTEM_SYSTEM is not set
# CONFIG_TESTING_GETPRIME is not set
# CONFIG_TESTING_KASAN is not set
# CONFIG_TESTING_OSTEST is not set
CONFIG_BOARD_LOOPSPERMSEC=-1
CONFIG_START_DAY=1
CONFIG_START_MONTH=1
CONFIG_START_YEAR=2018
