#
# nano-ros fragment over NuttX's `rv-virt:netnsh` (phase-550 W10, RFC-0126 decision 17).
#
# NuttX's own configure (`tools/configure.sh`) expands the `#include` below
# with `tools/process_config.sh`; a later line wins over the included one.
# What follows says only how this board differs from upstream's config: the
# resolved `.config` is byte-identical to the full defconfig this replaced.
#
# Additions: the RV32 soft-float toolchain profile, POSIX threading, /dev/urandom, larger stacks for zenoh-pico.

#include "boards/risc-v/qemu-rv/rv-virt/configs/netnsh/defconfig"

# Restated, though upstream says the same: nano-ros reads these from this
# file rather than from the resolved .config. The kernel build keys its
# export on the arch, the make road finds the board's Make.defs from
# arch/chip/board, and the board crate takes its network from NETINIT_*.
CONFIG_ARCH="risc-v"
CONFIG_ARCH_CHIP="qemu-rv"
CONFIG_ARCH_BOARD="rv-virt"
CONFIG_NETINIT_IPADDR=0x0a00020f
CONFIG_NETINIT_DRIPADDR=0x0a000202
CONFIG_NETINIT_NETMASK=0xffffff00

CONFIG_APPS_DIR="../nuttx-apps"

# 194.3c — force the RV32 GNU toolchain profile (-march=rv32imac… -mabi=ilp32,
# soft-float). The stock netnsh defaults to the RV64 multilib whose double-float
# ABI mismatches the soft-float Rust target `riscv32imac-unknown-nuttx-elf` at
# the FFI link. ilp32 keeps the kernel libs + Rust objects ABI-compatible.
CONFIG_RISCV_TOOLCHAIN_GNU_RV32=y

# 194.3c — disable the kernel FPU so the ABI is ilp32 (soft), not ilp32d. The
# stock netnsh enables DPFPU → -mabi=ilp32d, but rustc ships no
# riscv32imafdc-unknown-nuttx-elf; the matching nuttx target is
# riscv32imac-unknown-nuttx-elf (ilp32, soft-float). Soft-float keeps the kernel
# libs ABI-compatible with the Rust FFI objects at the final link.
# CONFIG_ARCH_FPU is not set
# CONFIG_ARCH_DPFPU is not set
CONFIG_DEFAULT_TASK_STACKSIZE=16384
CONFIG_INIT_ENTRYPOINT="nros_nuttx_entry"
CONFIG_INIT_STACKSIZE=524288
CONFIG_PIPES=y
CONFIG_SYSTEM_NSH_STACKSIZE=524288

# --- POSIX threading (required by zenoh-pico + Rust std TLS keys) ---
# #134 follow-up: mirrors the arm defconfig block; without CONFIG_TLS_NELEM
# the Rust std TLS (pthread_key_create/set/getspecific) fails to link.
# Issue 1907: nano-ros mutexes inherit priority. With this set, the
# pthread mutex protocol defaults to PTHREAD_PRIO_INHERIT, and
# nros-platform-posix refuses to build without it. Counting semaphores
# stay SEM_PRIO_NONE, so signalling semaphores are unaffected.
CONFIG_PRIORITY_INHERITANCE=y
CONFIG_PTHREAD_MUTEX_TYPES=y
CONFIG_PTHREAD_MUTEX_BOTH=y
CONFIG_PTHREAD_STACK_DEFAULT=65536
CONFIG_TLS_NELEM=64

# --- Random device (required by zenoh-pico RNG) ---
CONFIG_DEV_URANDOM=y
CONFIG_CRYPTO=y
CONFIG_CRYPTO_RANDOM_POOL=y

# phase-285 W6 — 64-bit time_t, matching the arm defconfig and the patched
# Rust libc fork (time_t = i64); the 32-bit default makes std's clock_gettime
# read garbage (panic "invalid timestamp") on the rust entry.
CONFIG_SYSTEM_TIME64=y

# phase-296 W5.9 - POSIX sporadic server: the budget dim's kernel-native
# realization (nros_nuttx_apply_current_sporadic; RFC-0052).
CONFIG_SCHED_SPORADIC=y
CONFIG_SCHED_SPORADIC_MAXREPL=3

# --- Upstream sets these; this board resolves them as below ---
# CONFIG_NETUTILS_TELNETD is not set
