<?xml version="1.0"?>
<package format="3">
  <name>nros_board_nuttx_qemu</name>
  <version>0.0.0</version>
  <description>
    NuttX board support for nano-ros, ARM and RISC-V QEMU targets.

    phase-348 W2: this file exists so the provider is DISCOVERABLE — the
    `nano_ros_provides` export below is what a source-time scan reads. What it
    lowers to is declared in the sibling `nros-board.toml` descriptor, which is
    read only when this provider is the one selected.
  </description>
  <maintainer email="dev@example.com">Developer</maintainer>
  <license>Apache-2.0</license>

  <export>
    <build_type>nros_cargo</build_type>
    <!--
      Provision, NOT consumption: this package IS a board, rather than
      selecting one. Must equal the descriptor's declared names, canonical
      first — `check-provider-announcements.py` compares them, because two
      spellings of one fact drift.
    -->
    <nano_ros_provides kind="board" name="nuttx"/>
    <nano_ros_provides kind="board" name="NuttX"/>
    <nano_ros_provides kind="board" name="nuttx-qemu-arm"/>
    <nano_ros_provides kind="board" name="qemu-armv7a-nsh"/>
    <nano_ros_provides kind="board" name="nuttx-riscv"/>
    <nano_ros_provides kind="board" name="NuttX-riscv"/>
    <nano_ros_provides kind="board" name="nuttx-qemu-riscv"/>
  </export>
</package>
