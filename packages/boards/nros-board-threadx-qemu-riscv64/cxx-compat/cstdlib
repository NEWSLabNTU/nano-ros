// C++ compat for picolibc
//
// See `cstring` beside this file: this directory is the whole C++ library of a
// riscv64-threadx build, so the list is the C-library half of <cstdlib> — the
// set `zephyr/cxx-compat/cstdlib` has carried on picolibc — rather than the
// names some caller happened to need first.
#ifndef _CXX_CSTDLIB
#define _CXX_CSTDLIB
#include <stdlib.h>
namespace std {
using ::size_t;
using ::div_t;
using ::ldiv_t;
using ::lldiv_t;
using ::abort;
// ^ RFC-0089 W3.b's refusal path calls `::std::abort()` (`nros.hpp:369`), so
// without this every ThreadX-RISCV64 C++ image failed to compile the moment
// `rclcpp::init` entered the umbrella header. picolibc's <stdlib.h> declares
// `abort`; only the `std::` re-export was missing. Found by the -nostdinc++
// header lane, not by any build -- the freestanding probe compiles against the
// HOST's full libstdc++, where `std::abort` is always there.
using ::abs;
using ::atexit;
using ::atoi;
using ::atol;
using ::atoll;
using ::calloc;
using ::div;
using ::exit;
using ::free;
using ::getenv;
using ::labs;
using ::ldiv;
using ::llabs;
using ::lldiv;
using ::malloc;
using ::qsort;
using ::rand;
using ::realloc;
using ::srand;
using ::strtod;
using ::strtof;
using ::strtol;
using ::strtoll;
using ::strtoul;
using ::strtoull;
}
#endif
