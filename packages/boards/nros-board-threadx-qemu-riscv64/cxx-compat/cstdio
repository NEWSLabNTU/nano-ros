using ::fread;
using ::fwrite;
using ::printf;
using ::puts;
using ::snprintf;
using ::sprintf;
using ::sscanf;
using ::vfprintf;
using ::vprintf;
using ::vsnprintf;
using ::vsprintf;
}
#endif
