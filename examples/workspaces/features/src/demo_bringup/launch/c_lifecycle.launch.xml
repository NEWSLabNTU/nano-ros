<?xml version="1.0"?>
<!-- A managed (lifecycle) C node. `<lifecycle_node>` marks `talker` managed, so
     the generated entry registers its own REP-2002 machine under its name
     (`/talker/get_state`, ...) right after building it, and drives it to the
     bringup's `[lifecycle] autostart` ("active": Configure then Activate) with
     no manual transition. -->
<launch>
  <lifecycle_node pkg="c_lifecycle_talker_pkg" exec="c_talker" name="talker"/>
</launch>
