<?xml version="1.0"?>
<!-- A managed (lifecycle) Rust system. `<lifecycle_node>` marks `talker`
     managed, so the runtime registers its own 5 REP-2002 lifecycle services
     under its name and autostarts it to the bringup's `[lifecycle] autostart`. -->
<launch>
  <lifecycle_node pkg="rust_lifecycle_talker_pkg" exec="talker" name="talker"/>
</launch>
