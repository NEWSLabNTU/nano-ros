<?xml version="1.0"?>
<!-- phase-326 (issue 0364) — multi-host launch via a standard launch argument.
     `host` selects which host's nodes survive the RESOLVE: robot1 runs the
     talker, robot2 the listener, `all` (the default) keeps both. A node with
     no `if=` would be shared across hosts. Bake one model per host:
       nros-launch-resolve … multihost.launch.xml host:=robot1 -o config/multihost_robot1_model.yaml
     This file is plain ROS 2 XML — `ros2 launch` runs it too (the retired
     `<node machine=…>` form was ROS 1 syntax the ROS 2 frontend rejects). -->
<launch>
  <arg name="host" default="all"/>
  <node pkg="talker_pkg" exec="talker" name="talker"
        if="$(eval '&quot;$(var host)&quot; in (&quot;robot1&quot;, &quot;all&quot;)')"/>
  <node pkg="listener_pkg" exec="listener" name="listener"
        if="$(eval '&quot;$(var host)&quot; in (&quot;robot2&quot;, &quot;all&quot;)')"/>
</launch>
