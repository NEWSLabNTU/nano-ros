<?xml version="1.0"?>
<!-- phase-326 (issue 0364) — multi-host launch via a standard launch argument
     (C parity with the Rust workspace). `host` selects which host's nodes
     survive the RESOLVE: robot1 runs the talker, robot2 the listener, `all`
     (the default) keeps both. Bake one model per host:
       nros-launch-resolve … multihost.launch.xml host:=robot1 -o config/multihost_robot1_model.yaml
     `native_entry_robot1` consumes the robot1 model (talker-only),
     `native_entry_robot2` the robot2 model (listener-only). Plain ROS 2 XML —
     the retired `<node machine=…>` form was ROS 1 syntax ROS 2 rejects. -->
<launch>
  <arg name="host" default="all"/>
  <node pkg="c_talker_pkg" exec="talker" name="talker"
        if="$(eval '&quot;$(var host)&quot; in (&quot;robot1&quot;, &quot;all&quot;)')"/>
  <node pkg="c_listener_pkg" exec="listener" name="listener"
        if="$(eval '&quot;$(var host)&quot; in (&quot;robot2&quot;, &quot;all&quot;)')"/>
</launch>
