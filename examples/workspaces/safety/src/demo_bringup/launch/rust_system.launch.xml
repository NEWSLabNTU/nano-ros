<?xml version="1.0"?>
<!-- The RUST two-node image: talker + safe_listener in ONE process.

     phase-331 W4 folded ws-safety-{c,cpp,rust} into this workspace, and the
     shared `system.launch.xml` became the C catalog. `zephyr_rust_safety_entry`
     resolved `demo_bringup` (i.e. that default) and failed to compile — a Rust
     Entry cannot register a C node pkg. This is the rust-only resolve it used
     to get from its own workspace's `system.launch.xml`, expressed the way this
     bringup already expresses every other per-language variant: a `[[model]]`
     block, not a second bringup.

     Unlike the native halves (split into two processes because in-process
     delivery over one zenoh session does not happen — issue 0096), the embedded
     image runs both nodes: the listener republishes its CRC-validated receive
     count on /safe_ok for a cross-process observer. -->
<launch>
  <node pkg="rust_safety_talker_pkg" exec="talker" name="talker"/>
  <node pkg="rust_safety_listener_pkg" exec="safe_listener" name="safe_listener"/>
</launch>
