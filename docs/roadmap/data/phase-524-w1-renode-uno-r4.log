=== serial.conf (merged last) ===
# phase-524 W1 spike -- arduino_uno_r4_minima, zenoh over SERIAL (sci9 = D11/D12,
# label ZUART), console stays on the board's uart2 (sci2, D0/D1).
# Delta merged LAST after the leaf's prj.conf + prj-zenoh.conf, the shape of
# cmake/zephyr/mps2-an385-serial.conf.
CONFIG_NROS_TRANSPORT_SERIAL=y
CONFIG_NETWORKING=n
CONFIG_RING_BUFFER=y
CONFIG_TEST_RANDOM_GENERATOR=y
# issue 0852: interrupt-driven RX (the board defconfig already sets it).
CONFIG_SERIAL=y
CONFIG_UART_INTERRUPT_DRIVEN=y
# issue 2164: main below zenoh-pico's read task.
CONFIG_MAIN_THREAD_PRIORITY=5

=== app.overlay (sci9 = D11/D12 as the zenoh UART, label ZUART; console stays on sci2) ===
/* phase-524 W1 spike: a second SCI for the zenoh serial link. */
&pinctrl {
	sci9_default: sci9_default {
		group1 {
			pinmux = <P110_RXD9>, <P109_TXD9>;
		};
	};
};
&sci9 {
	status = "okay";
	pinctrl-0 = <&sci9_default>;
	pinctrl-names = "default";
	uart9: uart {
		current-speed = <115200>;
		status = "okay";
		label = "ZUART";
	};
};

=== size.conf (attempt 4) ===
# phase-524 W1 spike -- one size-diet attempt to measure the floor against the
# RA4M1's 256 KiB flash (240 KiB code partition) / 32 KiB SRAM.
CONFIG_SIZE_OPTIMIZATIONS=y
CONFIG_LOG=n
CONFIG_HEAP_MEM_POOL_SIZE=2048
CONFIG_MAIN_STACK_SIZE=4096
CONFIG_ISR_STACK_SIZE=1024
CONFIG_SYSTEM_WORKQUEUE_STACK_SIZE=1024
CONFIG_ASSERT=n

