=== 2b eth.conf ===
# phase-524 W1 spike -- nucleo_f767zi, zenoh over the on-chip ETH MAC
# (eth_stm32_hal), static IPv4 on a Renode switch bridged to a tap that lives
# in a rootless user+net namespace (no sudo). Merged LAST after the leaf's
# prj.conf + prj-zenoh.conf (which carry NETWORKING/NET_TCP/POSIX).
CONFIG_NET_L2_ETHERNET=y
CONFIG_NET_CONFIG_SETTINGS=y
CONFIG_NET_CONFIG_NEED_IPV4=y
CONFIG_NET_CONFIG_MY_IPV4_ADDR="192.0.2.2"
CONFIG_NET_CONFIG_MY_IPV4_NETMASK="255.255.255.0"
CONFIG_NET_CONFIG_MY_IPV4_GW="192.0.2.1"
CONFIG_NET_DHCPV4=n
CONFIG_NET_CONFIG_INIT_TIMEOUT=10
# 384 KiB sram0 (same reasoning as serial.conf).
CONFIG_HEAP_MEM_POOL_SIZE=16384
CONFIG_NET_PKT_RX_COUNT=16
CONFIG_NET_PKT_TX_COUNT=16
CONFIG_NET_BUF_RX_COUNT=32
CONFIG_NET_BUF_TX_COUNT=32
