# phase-524 W1 spike 2 -- Renode, nucleo_f767zi: zenoh over serial (USART3, the
# ST-LINK VCP), then over the ETH MAC on a Renode switch bridged to a host tap
# date:     2026-11-01 (box: distrobox ros2, Ubuntu 22.04, ROS 2 humble)
# repo:     nano-ros 9e6bf0d4e2 (origin/main), zenoh-pico 8d5ac2fe10 (the pin)
# zephyr:   3.7.0 (box workspace), SDK 0.16.8; leaf examples/zephyr/c/talker
# module:   hal_stm32 f1317150eac951fdd8259337a47cbbc4c2e6d335 (zephyr v3.7.0's pin),
#           fetched by hand into modules/hal/stm32 (639 MiB shallow), via ZEPHYR_EXTRA_MODULES
# renode:   1.17.0 portable, sha256 4ba7c68b59e2447f188ef4b4b112fcccd2802582c460beedceb63b84e5605a5f
#           platforms/boards/nucleo_f767zi.repl (-> cpus/stm32f777.repl: STM32F7_USART,
#           SynopsysEthernetMAC @0x40028000 + EthernetPhysicalLayer, STM32_RNG)
# router:   nros_zenohd_bin (scripts/dev/zenohd.sh) -> humble's rmw_zenohd
# renode state: --config tmp/spike-524/renode-config/renode.config, HOME and
#           XDG_CONFIG_HOME overridden for the Renode process (it otherwise writes
#           ~/.config/renode even with --config), so nothing lands in ~/.config.
#
# --- 2a serial ---
#   tmp/spike-524/scripts/build.sh nucleo_f767zi tmp/spike-524/build/nucleo-serial \
#       tmp/spike-524/boards/nucleo_f767zi/serial.conf \
#       tmp/spike-524/boards/nucleo_f767zi/app-serial.overlay \
#       'serial/serial@40004800#baudrate=115200' ~/.nros-box/workspaces/zephyr/3.7/modules/hal/stm32 \
#       -DNROS_OVERRIDE_ZENOH_MAX_LARGE_SUBSCRIBERS=0
#     (west build -b nucleo_f767zi ... examples/zephyr/c/talker -- -DCONF_FILE="prj.conf;prj-zenoh.conf;<serial.conf>"
#      -DCONFIG_NROS_ZENOH_LOCATOR=... -DZEPHYR_EXTRA_MODULES="<repo>;<hal_stm32>" -DDTC_OVERLAY_FILE=<overlay> <override>)
#   tmp/spike-524/scripts/run-serial.sh nucleo-serial nucleo_f767zi.repl \
#       tmp/spike-524/build/nucleo-serial/zephyr/zephyr.elf usart3 usart6 17524 33524 90
#     resc: mach create; LoadPlatformDescription @platforms/boards/nucleo_f767zi.repl;
#           emulation CreateUartPtyTerminal "zlink" "<run>/zlink" true; connector Connect sysbus.usart3 zlink;
#           sysbus.usart6 CreateFileBackend @<run>/console.log true; sysbus LoadELF @<elf>; (start via monitor)
#     router: ZENOH_CONFIG_OVERRIDE='listen/endpoints=["serial/<run>/zlink#baudrate=115200","tcp/127.0.0.1:17524"];scouting/multicast/enabled=false' rmw_zenohd
#     echo:   RMW_IMPLEMENTATION=rmw_zenoh_cpp ROS_DOMAIN_ID=0 \
#             ZENOH_CONFIG_OVERRIDE='connect/endpoints=["tcp/127.0.0.1:17524"];scouting/multicast/enabled=false' \
#             ros2 topic echo /chatter std_msgs/msg/String
#
# --- 2b ethernet ---
#   tmp/spike-524/scripts/build.sh nucleo_f767zi tmp/spike-524/build/nucleo-eth \
#       tmp/spike-524/boards/nucleo_f767zi/eth.conf - 'tcp/192.0.2.1:7447' <hal_stm32> \
#       -DNROS_OVERRIDE_ZENOH_MAX_LARGE_SUBSCRIBERS=0 -DNROS_OVERRIDE_ZENOH_MAX_SUBSCRIBERS=1 \
#       -DNROS_OVERRIDE_ZENOH_SERVICE_BUFFER_SIZE=1024 -DNROS_OVERRIDE_ZEPHYR_HEAP_SIZE=32768
#   unshare -rn tmp/spike-524/scripts/run-eth.sh nucleo-eth tmp/spike-524/build/nucleo-eth/zephyr/zephyr.elf 120
#     A tap needs CAP_NET_ADMIN. No sudo: the run is a ROOTLESS user+net namespace
#     (`unshare -rn`; /dev/net/tun is 0666 in the box). Inside it:
#       ip tuntap add dev tap0 mode tap; ip addr add 192.0.2.1/24 dev tap0; ip link set tap0 up
#     resc: ... emulation CreateSwitch "switch"; connector Connect sysbus.ethernet switch;
#           emulation CreateTap "tap0" "tap"; connector Connect host.tap switch; sysbus.usart3 CreateFileBackend ...
#     router: listen tcp/192.0.2.1:7447 (the board's locator) + tcp/127.0.0.1:7448 (echo side)
#     The router and ros2 run in the same namespace as the tap; a router in the host's
#     own netns would need a forwarder (pasta/slirp4netns) -- NOT tried here.

=== 2a serial.conf ===
# phase-524 W1 spike -- nucleo_f767zi, zenoh over SERIAL on USART3 (the
# ST-LINK virtual COM port); console moved to USART6 by app-serial.overlay.
# Delta merged LAST, the shape of cmake/zephyr/mps2-an385-serial.conf.
CONFIG_NROS_TRANSPORT_SERIAL=y
CONFIG_NETWORKING=n
CONFIG_RING_BUFFER=y
CONFIG_TEST_RANDOM_GENERATOR=y
# issue 0852: interrupt-driven RX.
CONFIG_SERIAL=y
CONFIG_UART_INTERRUPT_DRIVEN=y
# issue 2164: main below zenoh-pico's read task.
CONFIG_MAIN_THREAD_PRIORITY=5
# 384 KiB sram0: the leaf's 64 KiB kernel heap is not what nano-ros allocates
# from (NROS_ZEPHYR_HEAP_SIZE is); 16 KiB keeps Zephyr's own users fed.
CONFIG_HEAP_MEM_POOL_SIZE=16384
=== 2a app-serial.overlay ===
/* phase-524 W1 spike: USART3 (ST-LINK VCP) carries zenoh; console on USART6. */
/ {
	chosen {
		zephyr,console = &usart6;
		zephyr,shell-uart = &usart6;
	};
};
