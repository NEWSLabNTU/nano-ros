+//! A multicast transport with a NON-DEFAULT sequence-number resolution.
+//!
+//! Every receiver compares the resolution a `Join` advertises against its own
+//! configured one and ignores the peer on a mismatch. The multicast TX task
+//! used to advertise `Resolution::default()` whatever the manager was
+//! configured with, so two peers configured identically with, say, an 8-bit
+//! frame SN each ignored every `Join` the other sent and never met.
+//!
+//! This matters beyond tidiness: an 8-bit frame SN is what lets a `Join`
+//! carrying the QoS extension (eight `PrioritySn`) fit one 63-byte CAN FD frame
+//! — see `multicast_can.rs`.
+#[cfg(target_family = "unix")]
+#[cfg(feature = "transport_udp")]
+mod tests {
+    use std::{sync::Arc, time::Duration};
+
+    use zenoh_core::ztimeout;
+    use zenoh_protocol::core::{Bits, EndPoint, Field, Resolution, WhatAmI, ZenohIdProto};
+    use zenoh_transport::{DummyTransportEventHandler, TransportManager};
+
+    const TIMEOUT: Duration = Duration::from_secs(60);
+    /// Two `join_interval`s (2.5 s by default) and some slack: a peer that has
+    /// not accepted the other's `Join` by then never will.
+    const JOIN_DEADLINE: Duration = Duration::from_secs(8);
+    const SLEEP_COUNT: Duration = Duration::from_millis(10);
+
+    async fn peers_meet(bits: Bits) -> bool {
+        let endpoint: EndPoint = format!(
+            "udp/224.{}.{}.{}:20001",
+            rand::random::<u8>(),
+            rand::random::<u8>(),
+            rand::random::<u8>()
+        )
+        .parse()
+        .unwrap();
+
+        let mut resolution = Resolution::default();
+        resolution.set(Field::FrameSN, bits);
+
+        let id01 = ZenohIdProto::try_from([0x11]).unwrap();
+        let id02 = ZenohIdProto::try_from([0x12]).unwrap();
+        let m01 = TransportManager::builder()
+            .zid(id01)
+            .whatami(WhatAmI::Peer)
+            .resolution(resolution)
+            .build_test(Arc::new(DummyTransportEventHandler))
+            .unwrap();
+        let m02 = TransportManager::builder()
+            .zid(id02)
+            .whatami(WhatAmI::Peer)
+            .resolution(resolution)
+            .build_test(Arc::new(DummyTransportEventHandler))
+            .unwrap();
+
+        let _ = ztimeout!(m01.open_transport_multicast(endpoint.clone())).unwrap();
+        let _ = ztimeout!(m02.open_transport_multicast(endpoint.clone())).unwrap();
+
+        let met = tokio::time::timeout(JOIN_DEADLINE, async {
+            while m01.get_transport_multicast(&id02).await.is_none()
+                || m02.get_transport_multicast(&id01).await.is_none()
+            {
+                tokio::time::sleep(SLEEP_COUNT).await;
+            }
+        })
+        .await
+        .is_ok();
+
+        ztimeout!(m01.close());
+        ztimeout!(m02.close());
+        met
+    }
+
+    /// The default resolution is the case that always worked, and is the
+    /// control for the one below: if this fails, the rig (multicast on this
+    /// host) is broken, not the resolution handling.
+    #[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+    async fn multicast_peers_meet_at_default_sn_resolution() {
+        zenoh_util::init_log_from_env_or("error");
+        assert!(peers_meet(Bits::from(u32::MAX)).await);
+    }
+
+    /// Fails without the fix: each peer logs "Unsupported SN resolution" for
+    /// every `Join` the other sends and they never meet.
+    #[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+    async fn multicast_peers_meet_at_8bit_sn_resolution() {
+        zenoh_util::init_log_from_env_or("error");
+        assert!(
+            peers_meet(Bits::U8).await,
+            "two peers configured with an 8-bit frame SN never accepted each \
+             other's Join — the Join is advertising a resolution that is not \
+             the configured one"
+        );
+    }
+}
