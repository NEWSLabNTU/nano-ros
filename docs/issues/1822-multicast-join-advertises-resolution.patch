diff --git a/io/zenoh-transport/tests/multicast_can.rs b/io/zenoh-transport/tests/multicast_can.rs
index 4afb2d41..40790e44 100644
--- a/io/zenoh-transport/tests/multicast_can.rs
+++ b/io/zenoh-transport/tests/multicast_can.rs
@@ -582,6 +582,63 @@ mod tests {
         );
     }
 
+    /// The way past the blocker above, inside the protocol as it stands: an
+    /// **8-bit frame SN**. Each `PrioritySn` is two varints, and at the default
+    /// 32-bit resolution a randomly seeded SN is four bytes; at 8 bits it is at
+    /// most two. With the SNs at the TOP of the 8-bit range (two-byte varints,
+    /// the worst case) and a full 16-byte zid, a QoS `Join` is 61 bytes — it
+    /// fits. 16 bits does not (77).
+    ///
+    /// Reachable by config alone (`transport/link/tx/sequence_number_resolution:
+    /// "8bit"`) once the multicast TX task advertises the configured resolution
+    /// instead of the default — see `multicast_resolution.rs`. Every peer on
+    /// the bus must agree, zenoh-pico included (`Z_SN_RESOLUTION 0x00`).
+    #[test]
+    fn join_with_qos_fits_one_can_frame_at_8bit_sn() {
+        use zenoh_buffers::writer::HasWriter;
+        use zenoh_codec::{WCodec, Zenoh080};
+        use zenoh_protocol::{
+            core::{Bits, Field, Resolution, WhatAmI, ZenohIdProto},
+            transport::{join::ext::PatchType, Join, PrioritySn, TransportMessage},
+        };
+
+        const CAN_FD_MTU: usize = 63;
+
+        fn encoded_len(bits: Bits) -> usize {
+            let mut resolution = Resolution::default();
+            resolution.set(Field::FrameSN, bits);
+            let top = bits.mask() as u32;
+            let sn = PrioritySn {
+                reliable: top,
+                best_effort: top,
+            };
+            let msg: TransportMessage = Join {
+                version: 0x09,
+                whatami: WhatAmI::Peer,
+                zid: ZenohIdProto::try_from([0xA5u8; 16]).unwrap(),
+                resolution,
+                batch_size: CAN_FD_MTU as u16,
+                lease: Duration::from_secs(60),
+                // What the TX task writes when QoS is on.
+                next_sn: PrioritySn::DEFAULT,
+                ext_qos: Some(Box::new([sn; Priority::NUM])),
+                ext_shm: None,
+                ext_patch: PatchType::CURRENT,
+            }
+            .into();
+
+            let mut buf = Vec::new();
+            Zenoh080::new().write(&mut buf.writer(), &msg).unwrap();
+            buf.len()
+        }
+
+        let u8_len = encoded_len(Bits::U8);
+        let u16_len = encoded_len(Bits::U16);
+        println!("QoS Join, worst-case SNs: 8-bit {u8_len} B, 16-bit {u16_len} B; CAN FD MTU {CAN_FD_MTU}");
+        assert!(u8_len <= CAN_FD_MTU, "8-bit QoS Join no longer fits: {u8_len}");
+        assert!(u16_len > CAN_FD_MTU, "16-bit QoS Join now fits ({u16_len}); 8-bit is no longer the only way");
+    }
+
     /// Four peers on one bus, which is the first test that is not a pair.
     ///
     /// It exercises the thing a pair cannot: each peer has to track three
