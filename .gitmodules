	path = packages/rmw/xrce/xrce-sys/micro-xrce-dds-client
	url = https://github.com/eProsima/Micro-XRCE-DDS-Client.git
[submodule "packages/rmw/xrce/xrce-sys/micro-cdr"]
	path = packages/rmw/xrce/xrce-sys/micro-cdr
	url = https://github.com/eProsima/Micro-CDR.git
[submodule "packages/rmw/zenoh/zpico-sys/mbedtls"]
	path = packages/rmw/zenoh/zpico-sys/mbedtls
	url = https://github.com/Mbed-TLS/mbedtls.git
[submodule "third-party/freertos/kernel"]
	path = third-party/freertos/kernel
	url = https://github.com/FreeRTOS/FreeRTOS-Kernel.git
[submodule "third-party/freertos/lwip"]
	path = third-party/freertos/lwip
	url = https://github.com/jerry73204/lwip.git
	branch = nano-ros
[submodule "third-party/threadx/kernel"]
	path = third-party/threadx/kernel
	url = https://github.com/NEWSLabNTU/threadx.git
	branch = nros-lp64-ulong
	# NEWSLabNTU/threadx forks eclipse-threadx/threadx for one patch the
	# upstream linux/gnu port needs on any LP64 host that is not x86_64:
	# `tx_port.h` keyed LONG/ULONG narrowing and ALIGN_TYPE on `__x86_64__`,
	# so on aarch64/riscv64 ULONG silently became 64-bit and ALIGN_TYPE fell
	# back to it — truncating every pointer a byte-pool block stores. Keyed
	# on `__LP64__` instead. Upstream issue eclipse-threadx/threadx#532.
[submodule "third-party/threadx/netxduo"]
	path = third-party/threadx/netxduo
	url = https://github.com/NEWSLabNTU/netxduo.git
	branch = nano-ros
[submodule "third-party/esp32/qemu"]
	path = third-party/esp32/qemu
	url = https://github.com/espressif/qemu.git
[submodule "third-party/nuttx/libc"]
	path = third-party/nuttx/libc
	url = https://github.com/jerry73204/libc.git
	branch = nuttx-0.2
[submodule "third-party/xrce/agent"]
	path = third-party/xrce/agent
	url = https://github.com/eProsima/Micro-XRCE-DDS-Agent.git
[submodule "third-party/nuttx/nuttx"]
	path = third-party/nuttx/nuttx
	url = https://github.com/jerry73204/nuttx.git
	branch = nano-ros
[submodule "third-party/nuttx/nuttx-apps"]
	path = third-party/nuttx/nuttx-apps
	url = https://github.com/apache/nuttx-apps.git
[submodule "third-party/tracing/Tonbandgeraet"]
	path = third-party/tracing/Tonbandgeraet
	url = https://github.com/schilkp/Tonbandgeraet.git
[submodule "third-party/px4/px4-rs"]
	path = third-party/px4/px4-rs
	url = https://github.com/jerry73204/px4-rs.git
	branch = main
[submodule "third-party/px4/PX4-Autopilot"]
	path = third-party/px4/PX4-Autopilot
	url = https://github.com/PX4/PX4-Autopilot.git
[submodule "third-party/dds/cyclonedds"]
	path = third-party/dds/cyclonedds
	url = https://github.com/NEWSLabNTU/cyclonedds.git
	branch = nano-ros
[submodule "third-party/qemu/qemu"]
	path = third-party/qemu/qemu
	url = https://github.com/NEWSLabNTU/qemu.git
	branch = nano-ros-v11.0.0-patches
	# NEWSLabNTU/qemu fork carries the nano-ros patch set on top of
	# upstream QEMU release tags. Bump the submodule pointer to the
	# fork's latest patched commit; the legacy patches/ dir was
	# removed since the patches live in the fork's git history now.
[submodule "packages/cli/testing_workspaces/ros2_rust_examples"]
	path = packages/cli/testing_workspaces/ros2_rust_examples
	url = https://github.com/jerry73204/ros2_rust_examples.git
	branch = add-justfile
