# nano-ros link fragment for an NXP S32 Design Studio (Eclipse CDT) project.
# RFC-0062 — integrations/s32ds.
#
# INSTALL: copy this file, and the generated `nros-libs.mk`, into the S32DS
# PROJECT ROOT (the directory holding `.cproject`), i.e. one level above
# `Debug_FLASH/`:
#
#     <project>/makefile.defs      <- this file
#     <project>/nros-libs.mk       <- generated by the cmake shell
#
# WHY THIS WORKS WITHOUT EDITING GENERATED FILES
#
# CDT's `Debug_FLASH/makefile` is stamped "Automatically-generated file. Do not
# edit!", but it already provides the hooks:
#
#     -include ../makefile.init
#     -include objects.mk            # USER_OBJS :=   LIBS := -lc -lm -lgcc
#     -include ../makefile.defs      # <- THIS FILE, before any rule
#     ...
#     <proj>.elf: $(OBJS) <ld> $(USER_OBJS)
#             arm-none-eabi-gcc -o "<proj>.elf" "@<proj>.args"  $(USER_OBJS)
#     -include ../makefile.targets
#
# None of the three `../makefile.*` files exist in a stock project, and
# `USER_OBJS` is declared empty. Because `makefile.defs` is included before the
# rules, appending here reaches both the prerequisite list and the link line.
# Only FILES belong there: an option would be read as a prerequisite too.
#
# Regenerating the project from S32DS does NOT overwrite these files; that is
# the point of the hook.

# The generated fragment: `USER_OBJS += <nano-ros static libs>`.
# Relative to Debug_FLASH/, which is where make runs.
-include ../nros-libs.mk

# No duplicate-symbol relaxation, by design (issue 1664). `nros-libs.mk` puts
# exactly ONE Rust runtime archive on the line — `libnros_cpp.a` for a C++-API
# image (it bundles nros-c), `libnros_c.a` otherwise — so a duplicate symbol
# here is a real defect: two copies of the runtime, each with its own statics
# (the backend `REGISTRY` among them), and ld must refuse it. Do not append a
# second runtime archive or a per-package Rust FFI staticlib to USER_OBJS.
#
# (Also: USER_OBJS is a PREREQUISITE of the CDT `.elf` rule, so a `-Wl,` option
# appended to it is "No rule to make target" — put linker flags in the
# project's own settings, never here.)

# ---------------------------------------------------------------------------
# YOUR APPLICATION ENTRY
#
# nano-ros does not inject a `main`. The S32DS project keeps its own, and it
# calls into the generated entry after board bring-up:
#
#     /* <project>/src/main.c */
#     extern void nros_app_main(void);   /* emitted by `nros codegen-system` */
#
#     int main(void) {
#         Clock_Ip_Init(...);            /* your existing bring-up */
#         Siul2_Port_Ip_Init(...);
#         /* bring the network interface up before the executor opens */
#         nros_app_main();               /* never returns; owns the scheduler */
#     }
#
# Add `-I<nano-ros>/packages/api/nros-c/include` and the generated system dir
# to the project's include paths (Project Properties -> C/C++ Build -> Settings)
# if your `main.c` includes nano-ros headers directly. It does not have to:
# the single `extern void nros_app_main(void);` declaration above is enough.
# ---------------------------------------------------------------------------
