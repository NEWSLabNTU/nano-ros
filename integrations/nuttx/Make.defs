############################################################################
# Phase 139.4 / 152.7 — NuttX integration shell (Make.defs).
#
# NuttX apps under `apps/external/<name>/` are discovered when this
# file exists. Inclusion is gated on CONFIG_NROS (Kconfig sibling).
#
# Phase 152.7 — wire upstream `apps/tools/Rust.mk` so the Cargo
# build of `nros-c` / `nros-cpp` runs in the NuttX `context::` phase
# and the resulting staticlib lands on `EXTRA_LIBS` for the
# monolithic link. The Makefile sibling owns the `context::` hook;
# Make.defs only registers the app and the lib paths.
############################################################################

ifneq ($(CONFIG_NROS),)
CONFIGURED_APPS += $(APPDIR)/external/nano-ros

# Phase 157.C — `apps/external/nano-ros` is a SYMLINK to
# `integrations/nuttx/` (the integration shell), NOT to the
# nano-ros repo root. `$(APPDIR)/external/nano-ros/packages/...`
# would resolve through the symlink target literally and miss
# `packages/core/`. `realpath` follows the symlink so we land on
# `integrations/nuttx/`, then `../..` walks up to the repo root.
NANO_ROS_ROOT_DEFS := $(realpath $(APPDIR)/external/nano-ros/../..)

# Pull upstream `apps/tools/Rust.mk` for RUST_CARGO_BUILD /
# RUST_CARGO_CLEAN / RUST_GET_BINDIR / RUST_GET_LIBDIR /
# RUST_TARGET_TRIPLE. Optional include — older NuttX trees without
# Rust.mk just skip the EXTRA_LIBS append; the user falls back to
# pre-building the staticlib out-of-band and pointing EXTRA_LIBS at
# it manually.
-include $(APPDIR)/tools/Rust.mk

ifneq ($(wildcard $(APPDIR)/tools/Rust.mk),)
# Phase 157.C.10 — direct paths to the cargo-built staticlib.
# Upstream `RUST_GET_BINDIR` / `RUST_GET_LIBDIR` assume a
# per-crate `target/` dir under the prefix (`$(2)/$(1)/target/`)
# AND name the lib `lib$(1).a` with no underscore transform.
# Both assumptions break for nano-ros's layout:
#   * Cargo defaults to `<workspace-root>/target/` (shared across
#     every crate); nros-c doesn't have its own `target/`.
#   * Cargo emits `libnros_c.a` (rust hyphen→underscore convention).
# Phase-484 W6b (RFC-0103 D7) — so the paths are ASKED for, never spelled:
# `nros locate artifact` joins cargo's own target dir (which honours
# `CARGO_TARGET_DIR` and `[build] target-dir`) with the one layout the build
# scripts write (`nros_build_paths::artifact`). This file used to hard-code
# `<root>/target/...`, right only while nothing moved the target dir.
NROS_CLI ?= nros
# RFC-0071 D9 (phase-506 W4c) — the archives come from the generated image
# root the Makefile builds (`cmake/NanoRosImageCrate.cmake`), not from the
# API crates' own workspace, so locate them under THAT root's target dir.
# Per ARCH, like the Makefile's object dir (issue 0525).
NROS_IMAGE_ROOT := $(APPDIR)/external/.nros-build/$(patsubst "%",%,$(CONFIG_ARCH))/image
NROS_IMAGE_TARGET_DIR := $(NROS_IMAGE_ROOT)/target
NROS_NUTTX_TRIPLE := armv7a-nuttx-eabihf
nros_artifact = $(or $(shell $(NROS_CLI) locate artifact $(1) $(2) --index $(NANO_ROS_ROOT_DEFS)/nros-sdk-index.toml),$(error nano-ros: `$(NROS_CLI) locate artifact $(1)` answered nothing — put the nros CLI on PATH (source activate.sh) or set NROS_CLI))
NROS_CARGO_ARCHIVE_ARGS := --target $(NROS_NUTTX_TRIPLE) --profile release --target-dir $(NROS_IMAGE_TARGET_DIR)
NROS_CARGO_LIB_DIR := $(patsubst %/,%,$(dir $(call nros_artifact,c-archive,$(NROS_CARGO_ARCHIVE_ARGS))))
# Issue 1636 — exactly ONE Rust staticlib reaches the kernel link.
#
# `libnros_cpp.a` bundles `nros-c` (nros-cpp depends on it, and its image crate
# bundles the backend), so it already defines every `nros_*` C-ABI symbol
# `libnros_c.a` does (measured: 299 of 299). Linking BOTH defined 392 strong
# symbols twice — 297 `nros_*`, the `rcl*`/`rmw_*` compat surface, the QoS and
# `__NROS_SIZE_*` constants, and `REGISTRY`, the backend registry — from two
# different `nros-c` builds, each with its own statics. The
# `--allow-multiple-definition` this file carried (Phase 157.C.17) bound every
# caller to whichever copy ld met first. So a C++ image takes `libnros_cpp.a`
# INSTEAD of `libnros_c.a`; a C image keeps `libnros_c.a`. A duplicate is a
# link error again.
ifneq ($(CONFIG_NROS_CPP_API),)
EXTRA_LIBS    += $(call nros_artifact,cpp-archive,$(NROS_CARGO_ARCHIVE_ARGS))
else
EXTRA_LIBS    += $(call nros_artifact,c-archive,$(NROS_CARGO_ARCHIVE_ARGS))
endif
EXTRA_LIBPATHS+= -L$(NROS_CARGO_LIB_DIR)
# Phase 157.C.17 — optional per-package C++ FFI staticlibs, one
# `EXTRA_LIBS += <path>` per line. Nothing in-tree WRITES this fragment any
# more (the per-example staging loop that did was retired in Phase 212.M-F.12),
# so it is a user hook only. Each such archive is a second Rust staticlib and
# re-defines the runtime closure (issue 1645); without
# `--allow-multiple-definition` that is now a link error, not a silent
# first-wins.
-include $(APPDIR)/external/nano-ros/extra_libs.mk
endif

# Phase 157.C.8 — per-build `nros_config_generated.h` lands at
# `$CARGO_TARGET_DIR/nros-c-generated/rclc/detail/` after `cargo build
# -p nros-c` (phase-501 W2). Add `nros-c-generated` to the include path
# FIRST (gcc resolves `-I` left-to-right) so `#include
# <rclc/detail/nros_config_generated.h>` picks up the per-build variant header
# instead of the source-tree stub (which deliberately errors via
# `#error` to flag mis-configured builds).
# Where that directory is, is `nros locate artifact c-include` (above).
NROS_C_GENERATED_INCLUDE := $(call nros_artifact,c-include,--target-dir $(NROS_IMAGE_TARGET_DIR))
CFLAGS += ${INCDIR_PREFIX}$(NROS_C_GENERATED_INCLUDE)

# CFLAGS — surface the nano-ros C headers to user code that
# `#include <rclc/...>` (and `<rcl/...>`, ...). Same symlink-resolution applies; route
# through the repo-root realpath.
CFLAGS += ${INCDIR_PREFIX}$(NANO_ROS_ROOT_DEFS)/packages/api/nros-c/include

# Phase 157.C.11 — C++ surface. Mirror the C-side header
# precedence + add the cbindgen-emitted `nros_cpp_ffi.h` parent
# (in `packages/api/nros-cpp/include/`). nros-cpp's per-build
# `nros_cpp_config_generated.h` lands at
# `$CARGO_TARGET_DIR/nros-cpp-generated/rclcpp/detail/` analogous to nros-c.
ifneq ($(CONFIG_NROS_CPP_API),)
CXXFLAGS += ${INCDIR_PREFIX}$(call nros_artifact,cpp-include,--target-dir $(NROS_IMAGE_TARGET_DIR))
CXXFLAGS += ${INCDIR_PREFIX}$(NANO_ROS_ROOT_DEFS)/packages/api/nros-cpp/include
# nros-cpp depends on nros-c headers — keep the C-side -I on the
# C++ compile line too.
CXXFLAGS += ${INCDIR_PREFIX}$(NROS_C_GENERATED_INCLUDE)
CXXFLAGS += ${INCDIR_PREFIX}$(NANO_ROS_ROOT_DEFS)/packages/api/nros-c/include
endif
endif
