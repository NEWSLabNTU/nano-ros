set(NROS_KNOB_KEY_CLOCK_EPOCH_FAILURE clock.epoch_failure)
set(NROS_KNOB_CHOICE_SYMBOL_CLOCK_EPOCH_FAILURE NROS_CLOCK_EPOCH_FAILURE)
set(NROS_KNOB_CHOICE_WANT_CLOCK_EPOCH_FAILURE "one of: unstamped, halt")
set(NROS_KNOB_MEMBER_SYMBOLS_CLOCK_EPOCH_FAILURE "")
