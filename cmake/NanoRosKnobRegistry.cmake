# CHOICE knobs (`type = "enum"` / `"enum_list"`): a value is one member, or
# an ordered list of distinct members comma-joined. NROS_KNOB_CHOICES_<id> are
# the members, NROS_KNOB_CHOICE_KIND_<id> the type, NROS_KNOB_KEY_<id> its
# system.toml key, NROS_KNOB_CHOICE_WANT_<id> what it takes in words and
# NROS_KNOB_MEMBER_SYMBOLS_<id> its derived `member=SYMBOL` bools. Checked by
# `_nros_knob_choice_check` (cmake/NanoRosKnobEnv.cmake).
set(NROS_KNOB_CHOICE_REFUSED_TEMPLATE "{spelling} = \"{value}\" is refused ({why}): {key} takes {want}")
set(NROS_KNOB_CHOICE_IDS "CLOCK_EPOCH_FAILURE;CLOCK_SOURCE;CLOCK_UPGRADE")
set(NROS_KNOB_CHOICE_KIND_CLOCK_EPOCH_FAILURE enum)
