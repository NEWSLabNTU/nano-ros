set(NROS_KNOB_CHOICE_SYMBOL_CLOCK_SOURCE NROS_CLOCK_SOURCE)
set(NROS_KNOB_CHOICE_WANT_CLOCK_SOURCE "an ordered list of distinct members, comma-separated, at least one, of: platform, sntp, zenoh-hlc, board")
