/* Generated by nano_ros_node_register(TYPED ... DEPLOY freertos) — the FreeRTOS
 * carrier's NROS_APP_CONFIG definition. DO NOT EDIT (regenerated at configure
 * time from cmake/templates/freertos_app_config.c.in).
 *
 * Phase 240.6 (RFC-0043) — in the typed C/C++ carrier the bootable ELF is
 * linked from cmake (add_executable + nros_platform_link_app); the Rust board
 * crate `nros-board-mps2-an385-freertos` (whose build.rs emits NROS_APP_CONFIG
 * into the board staticlib for the Rust path) is NOT linked.
 * `nros-board-freertos/c/freertos_c_entry.c` — added to the app target via
 * FREERTOS_STARTUP_SOURCE — reads `NROS_APP_CONFIG` for the network bring-up
 * and the FreeRTOS task priorities/stacks, so the carrier supplies the symbol
 * here.
 *
 * phase-337 W5.d folded the board `build.rs`'s hand-written mirror onto
 * `BaseConfig` + `FreertosScheduling`; this template is the ONE remaining
 * hand-maintained copy, and it is deliberately not identical — the carrier
 * varies `.locator` / `.domain_id` / the IP last octet per image. Retiring it
 * means teaching the carrier to read the board's emitted TU; until then, keep
 * it in sync when the board defaults change.
 *
 * `.app_stack_bytes` is 64 KiB, and it is MEASURED ON BOTH HALVES (issue 1146
 * part 2). It sat at 512 KiB while the Rust default moved to 128 KiB, because
 * ONE number serves the C and the C++ typed carriers and the C++ half could not
 * be BUILT at all — every embedded C++ FreeRTOS target died in `<string>` ->
 * `requires_hosted.h` under `-ffreestanding` (issue 1187, then issue 1330's
 * one-byte `nros_log_severity_t`). Both are fixed, so the number was taken.
 *
 * `uxTaskGetStackHighWaterMark` on the app task, every image RUN on qemu
 * mps2-an385 against a live `rmw_zenohd`, 2026-09-12 — the pubsub and service
 * pairs delivering, the action pairs serving a goal to completion:
 *
 *   | role           |      C |    C++ |
 *   | talker         |  6 096 |  8 832 |
 *   | listener       |  7 840 |  8 832 |
 *   | service-server |  9 320 |  8 832 |
 *   | service-client |  9 344 |  8 832 |
 *   | action-server  | 18 792 | 19 112 |   <- worst of each half
 *   | action-client  | 17 112 | 17 472 |
 *
 * The two halves agree to within 2 % at their worst (18 792 against 19 112),
 * which is what makes ONE number legitimate here rather than merely convenient
 * — and it could not be known until the C++ half ran. Both are SHALLOWER than
 * the Rust path (36 936) because this carrier keeps the executor and every node
 * struct in `.bss`.
 *
 * 65 536 is 3.4x the worse of the two, the same margin the Rust default carries
 * over its own worst (131 072 / 36 936 = 3.5x). The MARGIN is the shared
 * decision; the numbers differ because the measurements do.
 *
 * Read it off an image's own boot line rather than re-deriving it:
 * `report_app_stack_peak` in `nros-board-freertos/c/freertos_c_entry.c` prints
 * `nros: app task stack peak <used> of <total> bytes` once per boot, and
 * `report_heap_peak` beside it prints what the whole heap ever needed. Rebuild
 * with `bash scripts/build/fixtures-build.sh freertos {c,cpp} zenoh`.
 *
 * `.zenoh.locator` is cosmetic on the typed C/C++ path: the connect locator the
 * runtime actually dials is baked into the generated entry TU
 * (`FreertosBoard::run_components("@NROS_ENTRY_LOCATOR@", ...)`), not read from
 * here. `.network.*` and `.scheduling.*` ARE consumed by startup.c.
 */

#include <stdint.h>
#include <nros/app_config.h>

const nros_app_config_t NROS_APP_CONFIG = {
    .zenoh = {
        .locator   = "@NROS_ENTRY_LOCATOR@",
        .domain_id = @NROS_ENTRY_APP_DOMAIN_ID@,
    },
    .network = {
        /* Last octet is per-image (@NROS_ENTRY_IP_LAST@, default 10): two QEMU
         * nodes of a test pair MUST differ — the board seeds its PRNG from
         * IP+MAC, and identical seeds give identical zenoh ZIDs, which the
         * router treats as ONE peer (max_links=1) → silent no-delivery
         * (phase-287 W6; same lesson as the threadx-riscv64 .40/.41 split). */
        .ip      = { 192, 0, 3, @NROS_ENTRY_IP_LAST@ },
        .mac     = { 0x02, 0x00, 0x00, 0x00, 0x00, @NROS_ENTRY_IP_LAST@ },
        .gateway = { 192, 0, 3, 1 },
        .netmask = { 255, 255, 255, 0 },
        .prefix  = 24,
    },
    .scheduling = {
        /* RAW FreeRTOS priorities (issue 0623). These were the normalized 0-31
         * values (12 / 16 / 16 / 16), which every consumer converted for
         * itself — and the C entry's saturating clamp turned all four into 7,
         * flattening app, transport and net-poll into one priority. The band
         * conversion now happens once, in
         * `nros_board_common::freertos_config::to_freertos_priority`; these are
         * its outputs (12 -> 3, 16 -> 4) so this template agrees with the TU
         * the build script emits, and reads in the same units as a
         * `[tiers.*.freertos] priority`. */
        .app_priority            = 3,
        .zenoh_read_priority     = 4,
        .zenoh_lease_priority    = 4,
        .poll_priority           = 4,
        .app_stack_bytes         = 65536u,
        .zenoh_read_stack_bytes  = 5120u,
        .zenoh_lease_stack_bytes = 5120u,
        .poll_interval_ms        = 5u,
    },
};
