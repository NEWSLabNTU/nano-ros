# NanoRosComponentMain.cmake — the entry point `rclcpp_components_register_node(
# ... EXECUTABLE <exe>)` generates for a component (phase-488).
#
# Its own file so that `just check cpp` can write the same source in script mode
# and compile it against a component, without a project:
#
#   cmake -DPLUGIN=<ns::Class> -DEXECUTABLE=<exe> -DOUT=<file> \
#         -P cmake/NanoRosComponentMain.cmake
#
# The generated main cannot include the class's header: upstream's never does
# (class_loader loads the plugin), so a stock CMakeLists names only the class.
# The factory is the explicit specialization that
# `RCLCPP_COMPONENTS_REGISTER_NODE(<class>)` defines in the component's own TU
# (`<rclcpp_components/register_node_macro.hpp>`); this file forward-declares
# the class and declares that specialization, and the linker joins them. Every
# qualifier is taken to be a namespace: a PLUGIN nested in a class cannot be
# forward-declared, and its main fails to compile at the generated declaration.

include_guard(GLOBAL)

# Set `<out_var>` to the source of the main for component `plugin`, run as the
# node named `executable`.
function(nros_component_main_source plugin executable out_var)
    string(REPLACE "::" ";" _parts "${plugin}")
    list(FILTER _parts EXCLUDE REGEX "^$")
    foreach(_part IN LISTS _parts)
        if(NOT _part MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
            message(FATAL_ERROR
                "rclcpp_components_register_node: PLUGIN '${plugin}' is not a "
                "namespace-qualified class name.")
        endif()
    endforeach()
    list(POP_BACK _parts _class)
    set(_ns_open "")
    set(_ns_close "")
    foreach(_ns IN LISTS _parts)
        string(APPEND _ns_open "namespace ${_ns} { ")
        string(APPEND _ns_close "} ")
    endforeach()
    # One string: `file(GENERATE … CONTENT)` takes ONE argument, and these lines
    # used to be passed as ~30 separate strings, which cmake rejects ("Unknown
    # argument to GENERATE subcommand"), so every call with EXECUTABLE failed.
    string(CONCAT _src
        "// Generated by NanoRosComponentMain.cmake for ${executable}\n"
        "// (PLUGIN ${plugin}). nano-ros is single-binary; this entry\n"
        "// point replaces the runtime ComponentManager loading dance.\n"
        "#include <rclcpp/rclcpp.hpp>\n"
        "#include <rclcpp_components/register_node_macro.hpp>\n"
        "${_ns_open}class ${_class}; ${_ns_close}\n"
        "template <>\n"
        "std::shared_ptr<rclcpp::Node>\n"
        "nros_ament_component_detail::make_component<${plugin}>(\n"
        "    const rclcpp::NodeOptions& options, const char* name);\n"
        # Plain C++ linkage: on a board ROS2_MAIN renames `main` to
        # `nros_ported_main`, which the entry TU declares as a C++ function, so
        # an `extern "C"` here left the call unresolved at link.
        "int main(int argc, char** argv) {\n"
        "    rclcpp::init(argc, argv);\n"
        "    auto node = nros_ament_component_detail::make_component<${plugin}>(\n"
        "        rclcpp::NodeOptions{}, \"${executable}\");\n"
        "    rclcpp::spin(node);\n"
        "    rclcpp::shutdown();\n"
        "    return 0;\n"
        "}\n"
    )
    set(${out_var} "${_src}" PARENT_SCOPE)
endfunction()

if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
    if(NOT PLUGIN OR NOT EXECUTABLE OR NOT OUT)
        message(FATAL_ERROR "usage: cmake -DPLUGIN=<ns::Class> -DEXECUTABLE=<exe> -DOUT=<file> -P ${CMAKE_CURRENT_LIST_FILE}")
    endif()
    nros_component_main_source("${PLUGIN}" "${EXECUTABLE}" _src)
    file(WRITE "${OUT}" "${_src}")
endif()
