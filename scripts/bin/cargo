#!/usr/bin/env bash
#
# Project-wide cargo argument injection (issues 0359 / 0378).
#
# WHY A SHIM AND NOT A FLAG AT EVERY CALL SITE
#
# `Cargo.lock` is a promise that someone else's build resolves what yours did.
# `cargo build` breaks it silently: when a manifest no longer matches the lock
# it REWRITES the lock and carries on. Verified, not assumed:
#
#     $ cargo metadata            # stale lock, no flag
#     rc=0                        # ...and Cargo.lock was rewritten
#
# `--locked` turns that into a hard error. But cargo offers NO universal way to
# switch it on — also verified:
#
#     [build] locked = true   ->  warning: unused config key `build.locked`
#     CARGO_LOCKED / CARGO_BUILD_LOCKED  ->  ignored
#
# It is CLI-only. Adding it to each site would mean editing 57 places in
# `justfile` + `scripts/`, and would STILL miss the ones that matter most:
# cmake and corrosion invoke `cargo` by name
# (`cmake/NanoRosGenerateInterfaces.cmake:499`), so no just-variable can reach
# them.
#
# PATH is the project's existing universal mechanism — `activate.sh` already
# wires `nros`, `play_launch_parser` and `zenohd` that way, and `just doctor`
# enforces that it was sourced. One definition, every caller, including cmake.
#
# CONTRACT
#
#   NROS_CARGO_FLAGS   flags to inject. Default `--locked`.
#                      Set EMPTY to disable entirely:  NROS_CARGO_FLAGS= cargo …
#
# Injection is deliberately conservative: only for subcommands that accept the
# flags, never when the caller already passed them, and never for `fmt`,
# `search`, `new`, `init` or bare `--version`, which do not take `--locked` and
# would fail outright.

set -euo pipefail

FLAGS="${NROS_CARGO_FLAGS-"--locked"}"

# --- locate the REAL cargo -------------------------------------------------
# Walk PATH and take the first `cargo` that is not A SHIM — not merely "not
# THIS shim".
#
# The identity test used to be `$_rd = $self_dir`, which is correct for one
# checkout and catastrophic for two. A git worktree has its own
# `scripts/bin/cargo`, so an agent whose shell inherited the MAIN checkout's
# activate.sh and then sourced the worktree's has both dirs on PATH. The
# worktree shim skips itself, finds the main shim, and execs it; the main shim
# skips ITSELF, walks PATH from the start, finds the worktree shim, and execs
# that. Neither is ever "this" shim, so neither guard fires: cargo spins at
# 100 % CPU and never runs, with no output to say why. Three parallel worktree
# agents hit this simultaneously; one burned ~50 minutes on it and two more sat
# stuck for 20+ minutes each, which is also why a `just check fast` inside a
# worktree looked like cargo-lock contention.
#
# So identify a shim by CONTENT, not by location: any `cargo` on PATH carrying
# the marker below is one of ours, in whatever checkout, and must be skipped.
# `$0`-based or env-guard schemes were considered and rejected — an env guard
# survives into the real cargo's own subprocesses, and this test needs no state.
_NROS_CARGO_SHIM_MARKER='nros cargo shim: no real `cargo` found on PATH'
self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
real_cargo=""
IFS=':' read -r -a _path_entries <<<"$PATH"
for _d in "${_path_entries[@]}"; do
    [ -z "$_d" ] && continue
    _rd="$(cd "$_d" 2>/dev/null && pwd -P)" || continue
    [ "$_rd" = "$self_dir" ] && continue
    if [ -x "$_rd/cargo" ]; then
        # A shim in ANOTHER checkout is still a shim. grep -q on a small text
        # file, once per cargo invocation, against an infinite loop.
        if grep -qF "$_NROS_CARGO_SHIM_MARKER" "$_rd/cargo" 2>/dev/null; then
            continue
        fi
        real_cargo="$_rd/cargo"
        break
    fi
done

if [ -z "$real_cargo" ]; then
    echo "nros cargo shim: no real \`cargo\` found on PATH beyond $self_dir" >&2
    exit 127
fi

# No flags configured → pure passthrough, no parsing, no surprises.
if [ -z "$FLAGS" ]; then
    exec "$real_cargo" "$@"
fi

# --- decide whether this invocation takes the flags ------------------------
# A leading `+toolchain` is cargo's, not a subcommand.
args=("$@")
idx=0
if [ "${args[0]-}" != "" ] && [ "${args[0]#+}" != "${args[0]}" ]; then
    idx=1
fi
sub="${args[$idx]-}"

case "$sub" in
    build | b | check | c | test | t | run | r | rustc | bench | doc | metadata | tree | fetch | package | publish | install | nextest | clippy)
        ;;
    *)
        exec "$real_cargo" "$@"
        ;;
esac

# Already asked for by the caller → do not duplicate.
# Already-explicit lock discipline: don't double up.
#
# `--offline` is NOT in this list, deliberately (issue 0676). It restricts cargo
# to the local cache; it does NOT pin resolution, so `cargo <cmd> --offline`
# will happily re-resolve and REWRITE `Cargo.lock` from whatever the cache
# holds. It was listed here, and that is how a measurement run for issue 0648
# silently moved `libc` 0.2.183 -> 0.2.189 in two leaf locks — the exact class
# `--locked` is injected project-wide to prevent (issues 0359, 0378).
#
# `--frozen` stays: it means `--locked --offline` by definition.
for a in "$@"; do
    case "$a" in
        --locked | --frozen)
            exec "$real_cargo" "$@"
            ;;
    esac
done

# Don't force `--locked` when the target's `Cargo.lock` is a git-IGNORED
# artifact rather than a tracked promise (issue 0386; policy in RFC-0026
# "Lockfiles"). `--locked` is right for the repo's own core/workspace crates,
# whose locks are COMMITTED and whose dep graph is fixed here. It is WRONG for
# an example leaf, whose lock is intentionally untracked because it cannot be
# resolved at the repo at all: the leaf redirects its message deps through
# `[patch.crates-io]` to a `generated/` tree that only exists AFTER the USER
# runs message codegen (`nros sync`) on their machine. So the leaf lock is
# created on the user's first build; forcing `--locked` forbids *creating* that
# first lock (`cannot create the lock file … because --locked was passed`) and
# forbids *updating* a stale one after a later `nros sync`.
#
# The rule is TRACKED, not "not-ignored": inject `--locked` only where the lock
# is a committed promise this repo can keep. An earlier revision skipped only
# git-IGNORED locks and fell through everywhere else, which broke the opposite
# case — the metadata-mode tests compile probe crates in a TEMP DIR by design
# (packages/cli/CLAUDE.md), and a scratch crate under /tmp is in no git repo at
# all, so `check-ignore` failed, `--locked` was injected, and cargo refused with
# `cannot create the lock file /tmp/…/Cargo.lock`. Five nros-tests failed on
# that. A directory outside any git repo can never hold a tracked lock, so the
# tracked test answers both cases with one predicate.
_manifest_dir="$PWD"
for ((_i = 0; _i < ${#args[@]}; _i++)); do
    case "${args[$_i]}" in
        --manifest-path) _manifest_dir="$(dirname "${args[$((_i + 1))]-.}")" ;;
        --manifest-path=*) _manifest_dir="$(dirname "${args[$_i]#--manifest-path=}")" ;;
    esac
done
if ! git -C "$_manifest_dir" ls-files --error-unmatch Cargo.lock >/dev/null 2>&1; then
    exec "$real_cargo" "$@"
fi

# Insert FLAGS BEFORE the first `--` separator (issue 0384). Everything after
# `--` is the child binary's argv (test harness / run target / clippy-driver);
# appending FLAGS there leaks e.g. `--locked` to it → "Unrecognized option:
# 'locked'". `--locked` is cargo's own flag, so it belongs on cargo's side of
# the `--`. With no `--`, append at the end (unchanged). `cargo nextest` takes
# its own subcommand before the flags, and its `--` (if any) is handled the
# same way.
_out=()
_inserted=0
for _a in "$@"; do
    if [ "$_inserted" -eq 0 ] && [ "$_a" = "--" ]; then
        _out+=($FLAGS "--")
        _inserted=1
    else
        _out+=("$_a")
    fi
done
[ "$_inserted" -eq 0 ] && _out+=($FLAGS)
exec "$real_cargo" "${_out[@]}"
